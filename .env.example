# Firebase Web SDK configuration.
# These values identify the Firebase web app; do not put private server credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary public unsigned upload configuration (no API Key or API Secret in browser client).
VITE_CLOUDINARY_CLOUD_NAME=fodgcil9
VITE_CLOUDINARY_UPLOAD_PRESET=37gallery

# Firebase App Check (reCAPTCHA v3 public site key — safe for client bundle)
VITE_FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=

# Google Maps Platform — browser-side Places integration
# This key is public in the browser bundle and must be HTTP-referrer restricted.
VITE_GOOGLE_MAPS_API_KEY=

# Public Google Maps Place ID. Not a secret.
VITE_GOOGLE_MAPS_PLACE_ID=ChIJfYXPy6P-aS4RFCRQptFpsVg
