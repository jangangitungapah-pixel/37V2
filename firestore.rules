rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isActiveStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staffProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/staffProfiles/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/staffProfiles/$(request.auth.uid)).data.role in ['owner', 'staff'];
    }

    function isActiveOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staffProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/staffProfiles/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/staffProfiles/$(request.auth.uid)).data.role == 'owner';
    }

    function isValidBookingKeys(data) {
      return data.keys().hasOnly([
        'customerName',
        'phone',
        'bandName',
        'studioId',
        'serviceId',
        'serviceLabel',
        'packageId',
        'packageLabel',
        'recordingTypeId',
        'recordingTypeLabel',
        'date',
        'startMinute',
        'durationMinutes',
        'endMinute',
        'timeZone',
        'unitRate',
        'subtotal',
        'discountAmount',
        'totalAmount',
        'automaticDiscount',
        'commissionSnapshot',
        'initialPaymentStatus',
        'initialPaidAmount',
        'paymentMethod',
        'sessionStatus',
        'checkedInAt',
        'checkedInByUid',
        'actualStartedAt',
        'actualCompletedAt',
        'notes',
        'createdAt',
        'createdByUid',
        'updatedAt',
        'updatedByUid',
        'version'
      ]);
    }

    function isValidBookingAutomaticDiscountShape(data) {
      return !('automaticDiscount' in data)
        || data.automaticDiscount == null
        || (
          data.automaticDiscount is map
          && data.automaticDiscount.keys().hasAll([
            'type',
            'intervalMinutes',
            'eligibleBlocks',
            'discountPerBlock',
            'totalDiscount'
          ])
          && data.automaticDiscount.keys().hasOnly([
            'type',
            'intervalMinutes',
            'eligibleBlocks',
            'discountPerBlock',
            'totalDiscount'
          ])
          && data.automaticDiscount.type == 'duration_multiple'
          && data.automaticDiscount.intervalMinutes is int
          && data.automaticDiscount.intervalMinutes > 0
          && data.automaticDiscount.eligibleBlocks is int
          && data.automaticDiscount.eligibleBlocks > 0
          && data.automaticDiscount.discountPerBlock is int
          && data.automaticDiscount.discountPerBlock > 0
          && data.automaticDiscount.totalDiscount is int
          && data.automaticDiscount.totalDiscount > 0
          && data.automaticDiscount.totalDiscount <= data.subtotal
          && data.automaticDiscount.totalDiscount == (
            data.automaticDiscount.eligibleBlocks * data.automaticDiscount.discountPerBlock > data.subtotal
              ? data.subtotal
              : data.automaticDiscount.eligibleBlocks * data.automaticDiscount.discountPerBlock
          )
          && data.discountAmount == data.automaticDiscount.totalDiscount
        );
    }

    function isBookingAutomaticDiscountMathMatched(data) {
      return !('automaticDiscount' in data)
        || data.automaticDiscount == null
        || (
          data.automaticDiscount.eligibleBlocks * data.automaticDiscount.intervalMinutes <= data.durationMinutes
          && (data.automaticDiscount.eligibleBlocks + 1) * data.automaticDiscount.intervalMinutes > data.durationMinutes
        );
    }

    function isValidBookingCommissionSnapshot(data) {
      return !('commissionSnapshot' in data)
        || data.commissionSnapshot == null
        || (
          data.commissionSnapshot is map
          && data.commissionSnapshot.keys().hasAll([
            'staffBasis',
            'staffRate',
            'staffAmount',
            'recordingOperatorAmount',
            'settingsVersion'
          ])
          && data.commissionSnapshot.keys().hasOnly([
            'staffBasis',
            'staffRate',
            'staffAmount',
            'recordingOperatorAmount',
            'settingsVersion'
          ])
          && data.commissionSnapshot.staffBasis in ['package', 'rehearsal_hourly', 'none']
          && data.commissionSnapshot.staffRate is number
          && data.commissionSnapshot.staffRate >= 0
          && data.commissionSnapshot.staffAmount is number
          && data.commissionSnapshot.staffAmount >= 0
          && data.commissionSnapshot.recordingOperatorAmount is number
          && data.commissionSnapshot.recordingOperatorAmount >= 0
          && data.commissionSnapshot.settingsVersion is int
          && data.commissionSnapshot.settingsVersion >= 1
        );
    }

    function isServiceScopeUnchanged(reqData, resData) {
      return reqData.serviceId == resData.serviceId
        && reqData.packageId == resData.packageId
        && reqData.recordingTypeId == resData.recordingTypeId
        && reqData.durationMinutes == resData.durationMinutes;
    }

    function isBookingSnapshotsUnchanged(reqData, resData) {
      return reqData.unitRate == resData.unitRate
        && reqData.subtotal == resData.subtotal
        && reqData.discountAmount == resData.discountAmount
        && reqData.totalAmount == resData.totalAmount
        && reqData.get('automaticDiscount', null) == resData.get('automaticDiscount', null)
        && reqData.get('commissionSnapshot', null) == resData.get('commissionSnapshot', null);
    }

    function isValidPricingFees(fees) {
      return fees is map
        && fees.keys().hasAll(['rehearsalStaffCommissionPerHour', 'dailyMealAllowancePerStaff'])
        && fees.keys().hasOnly(['rehearsalStaffCommissionPerHour', 'dailyMealAllowancePerStaff'])
        && fees.rehearsalStaffCommissionPerHour is number
        && fees.rehearsalStaffCommissionPerHour >= 0
        && fees.dailyMealAllowancePerStaff is number
        && fees.dailyMealAllowancePerStaff >= 0;
    }

    function isValidPricingSettings(data) {
      return data.keys().hasAll([
          'schemaVersion',
          'sessionTypes',
          'recordingTypes',
          'packages',
          'discounts',
          'fees',
          'version',
          'updatedAt',
          'updatedByUid'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'sessionTypes',
          'recordingTypes',
          'packages',
          'discounts',
          'fees',
          'version',
          'updatedAt',
          'updatedByUid'
        ])
        && data.schemaVersion == 1
        && data.sessionTypes is list
        && data.sessionTypes.size() >= 1
        && data.recordingTypes is list
        && data.packages is list
        && data.discounts is list
        && isValidPricingFees(data.fees)
        && data.version is int
        && data.version >= 1
        && data.updatedAt is timestamp
        && data.updatedByUid == request.auth.uid;
    }

    function isValidBookingShape(data) {
      return data.customerName is string
        && data.customerName.size() > 0
        && data.phone is string
        && data.phone.size() > 0
        && data.bandName is string
        && data.studioId in ['room-a', 'room-b']
        && data.serviceId is string
        && data.serviceLabel is string
        && data.packageId is string
        && data.packageLabel is string
        && data.recordingTypeId is string
        && data.recordingTypeLabel is string
        && data.date is string
        && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.startMinute is int
        && data.startMinute >= 600
        && data.startMinute < 1380
        && data.startMinute % 30 == 0
        && data.durationMinutes is int
        && data.durationMinutes > 0
        && data.durationMinutes % 30 == 0
        && data.endMinute is int
        && data.endMinute == data.startMinute + data.durationMinutes
        && data.endMinute <= 1380
        && data.timeZone == 'Asia/Jakarta'
        && data.unitRate is int
        && data.unitRate >= 0
        && data.subtotal is int
        && data.subtotal >= 0
        && data.discountAmount is int
        && data.discountAmount >= 0
        && data.discountAmount <= data.subtotal
        && data.totalAmount is int
        && data.totalAmount >= 0
        && data.totalAmount == data.subtotal - data.discountAmount
        && isValidBookingAutomaticDiscountShape(data)
        && isValidBookingCommissionSnapshot(data)
        && data.initialPaymentStatus in ['unpaid', 'partial', 'paid']
        && data.initialPaidAmount is number
        && data.initialPaidAmount >= 0
        && data.initialPaidAmount <= data.totalAmount
        && data.paymentMethod is string
        && data.sessionStatus in ['upcoming', 'in_progress', 'completed', 'no_show', 'cancelled']
        && data.notes is string
        && data.version is int
        && data.version >= 1;
    }

    match /staffProfiles/{uid} {
      allow get: if request.auth != null
                 && request.auth.uid == uid;
    }

    match /settings/pricing {
      allow get: if isActiveStaff();
      allow list: if false;

      allow create: if isActiveOwner()
        && isValidPricingSettings(request.resource.data)
        && request.resource.data.version == 1;

      allow update: if isActiveOwner()
        && isValidPricingSettings(request.resource.data)
        && request.resource.data.version == resource.data.version + 1;

      allow delete: if false;
    }

    match /bookings/{bookingId} {
      allow read: if isActiveStaff();

      allow create: if isActiveStaff()
        && isValidBookingKeys(request.resource.data)
        && isValidBookingShape(request.resource.data)
        && isBookingAutomaticDiscountMathMatched(request.resource.data)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.version == 1;

      allow update: if isActiveStaff()
        && isValidBookingKeys(request.resource.data)
        && isValidBookingShape(request.resource.data)
        && (request.resource.data.get('automaticDiscount', null) == resource.data.get('automaticDiscount', null)
            || isBookingAutomaticDiscountMathMatched(request.resource.data))
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.initialPaymentStatus == resource.data.initialPaymentStatus
        && request.resource.data.initialPaidAmount == resource.data.initialPaidAmount
        && request.resource.data.paymentMethod == resource.data.paymentMethod
        && (!isServiceScopeUnchanged(request.resource.data, resource.data)
            || isBookingSnapshotsUnchanged(request.resource.data, resource.data));

      allow delete: if false;
    }

    match /bookingSlots/{slotId} {
      allow read: if isActiveStaff();

      allow create, update: if isActiveStaff()
        && request.resource.data.keys().hasOnly([
          'bookingId',
          'date',
          'studioId',
          'slotStartMinute',
          'createdAt'
        ])
        && request.resource.data.bookingId is string
        && request.resource.data.bookingId.size() > 0
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.studioId in ['room-a', 'room-b']
        && request.resource.data.slotStartMinute is int
        && request.resource.data.slotStartMinute >= 600
        && request.resource.data.slotStartMinute < 1380
        && request.resource.data.slotStartMinute % 30 == 0
        && existsAfter(
          /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
        )
        && getAfter(
          /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
        ).data.date == request.resource.data.date
        && getAfter(
          /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
        ).data.studioId == request.resource.data.studioId
        && getAfter(
          /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
        ).data.sessionStatus != 'cancelled';

      allow delete: if isActiveStaff();
    }

    match /bookingEvents/{eventId} {
      allow read: if isActiveStaff();

      allow create: if isActiveStaff()
        && request.resource.data.keys().hasOnly([
          'bookingId',
          'eventType',
          'actorUid',
          'createdAt',
          'previousValue',
          'newValue',
          'note'
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.bookingId is string
        && request.resource.data.bookingId.size() > 0
        && request.resource.data.eventType is string
        && request.resource.data.eventType.size() > 0
        && existsAfter(
          /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
        );

      allow update, delete: if false;
    }

  }
}
