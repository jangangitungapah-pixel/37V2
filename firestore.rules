        && data.format in ['jpg', 'jpeg', 'png', 'webp', 'avif']
        && data.width is int
        && data.width >= 1
        && data.width <= 6000
        && data.height is int
        && data.height >= 1
        && data.height <= 6000
        && data.bytes is int
        && data.bytes >= 1
        && data.bytes <= 10485760
        && data.altText is string
