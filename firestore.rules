        && data.status is string
        && data.status in ['draft', 'published']
        && data.version is int
        && data.version >= 1
        && data.createdAt is timestamp
        && data.createdByUid is string
        && data.createdByUid.size() >= 1
        && data.updatedAt is timestamp
        && data.updatedByUid == request.auth.uid;
    }

    function isValidLandingPagePlacementCreate(data, placementId) {
      return isValidLandingPagePlacementShape(data, placementId)
