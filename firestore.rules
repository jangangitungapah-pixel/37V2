rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isActiveStaff() {
      let profile = request.auth != null
        ? get(/databases/$(database)/documents/staffProfiles/$(request.auth.uid))
        : null;
      return profile != null
        && profile.data.active == true
        && profile.data.role in ['owner', 'staff'];
    }

    function isActiveOwner() {
      let profile = request.auth != null
        ? get(/databases/$(database)/documents/staffProfiles/$(request.auth.uid))
        : null;
      return profile != null
        && profile.data.active == true
        && profile.data.role == 'owner';
    }

    function isAnyStaffProfile() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staffProfiles/$(request.auth.uid));
    }

    function isValidNormalizedEmail(value) {
      return value is string
        && value.size() >= 5
        && value.size() <= 254
        && value.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$');
    }

    function hasVerifiedGoogleEmail() {
      return request.auth != null
        && ('firebase' in request.auth.token)
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && ('email_verified' in request.auth.token)
        && request.auth.token.email_verified == true
        && ('email' in request.auth.token)
        && request.auth.token.email is string
        && isValidNormalizedEmail(request.auth.token.email.trim().lower());
    }

    function hasEligibleClientAuth() {
      return request.auth != null
        && ('firebase' in request.auth.token)
        && ('email' in request.auth.token)
        && request.auth.token.email is string
        && isValidNormalizedEmail(request.auth.token.email.trim().lower())
        && (
          request.auth.token.firebase.sign_in_provider == 'password'
          || (
            request.auth.token.firebase.sign_in_provider == 'google.com'
            && ('email_verified' in request.auth.token)
            && request.auth.token.email_verified == true
          )
        );
    }

    function normalizedAuthEmail() {
      return request.auth.token.email.trim().lower();
    }

    function getClientAccountDoc(uid) {
      return get(/databases/$(database)/documents/clientAccounts/$(uid));
    }

    function isValidActiveClientAccountDoc(uid) {
      let acct = getClientAccountDoc(uid);
      return acct.data.uid == uid
        && acct.data.role == 'client'
        && acct.data.status == 'active'
        && acct.data.customerId is string
        && acct.data.customerId.size() >= 1;
    }

    function isActiveClient() {
      return hasEligibleClientAuth()
        && !isAnyStaffProfile()
        && exists(/databases/$(database)/documents/clientAccounts/$(request.auth.uid))
        && isValidActiveClientAccountDoc(request.auth.uid);
    }

    function isActiveClientCustomerMatch(uid, customerId) {
      let acct = getClientAccountDoc(uid);
      let link = get(/databases/$(database)/documents/clientCustomerLinks/$(customerId));
      return acct != null
        && link != null
        && acct.data.uid == uid
        && acct.data.role == 'client'
        && acct.data.status == 'active'
        && acct.data.profileSource in ['linked_customer', 'isolated_client_profile']
        && acct.data.customerId == customerId
        && link.data.ownerUid == uid
        && link.data.profileSource == acct.data.profileSource
        && (
          acct.data.profileSource == 'linked_customer'
          || customerId == ('client_' + uid)
        );
    }

    function isClientOwnerOfCustomer(customerId) {
      return hasEligibleClientAuth()
        && !isAnyStaffProfile()
        && customerId is string
        && customerId.size() >= 1
        && isActiveClientCustomerMatch(request.auth.uid, customerId);
    }

    function isClientUidOwner(clientUid) {
      return clientUid is string
        && clientUid.size() > 0
        && request.auth != null
        && clientUid == request.auth.uid
        && isActiveClient();
    }

    function isClientDocumentOwner(data) {
      return data != null
        && (
          (data.customerId is string && isClientOwnerOfCustomer(data.customerId))
          || isClientUidOwner(data.get('clientUid', ''))
        );
    }

    function isClientReadableParentInvoiceDoc(invoiceId, childData) {
      let inv = get(/databases/$(database)/documents/invoices/$(invoiceId));
      let invoiceClientUid = inv.data.get('clientUid', '');
      let childClientUid = childData.get('clientUid', '');
      return isClientDocumentOwner(inv.data)
        && inv.data.invoiceStatus in ['issued', 'void']
        && (!('customerId' in childData)
          || childData.customerId == inv.data.get('customerId', ''))
        && (!('bookingId' in childData)
          || childData.bookingId == inv.data.get('bookingId', ''))
        && (!('invoiceNumber' in childData)
          || childData.invoiceNumber == inv.data.get('invoiceNumber', ''))
        && (invoiceClientUid == '' || invoiceClientUid == request.auth.uid)
        && (childClientUid == '' || childClientUid == request.auth.uid);
    }

    function isClientReadableParentInvoice(childData) {
      let invoiceId = childData.get('invoiceId', '');
      return invoiceId is string
        && invoiceId.size() >= 1
        && exists(/databases/$(database)/documents/invoices/$(invoiceId))
        && isClientReadableParentInvoiceDoc(invoiceId, childData);
    }

    function getFactoryResetOperation() {
      return exists(/databases/$(database)/documents/systemOperations/factoryReset)
        ? get(/databases/$(database)/documents/systemOperations/factoryReset)
        : null;
    }

    function isFactoryResetLocked() {
      let op = getFactoryResetOperation();
      return op != null
        && op.data.status in ['running', 'paused', 'failed'];
    }

    function isFactoryResetRunning() {
      let op = getFactoryResetOperation();
      return op != null
        && op.data.status == 'running'
        && op.data.operationId is string
        && op.data.operationId.size() >= 8;
    }

    function canFactoryResetDelete() {
      return isActiveOwner() && isFactoryResetRunning();
    }

    function isValidCommissionRoleEntry(entry) {
      return entry is map
        && entry.size() == 3
        && entry.basis in ['none', 'fixed', 'hourly', 'manual']
        && entry.rate is int
        && entry.rate >= 0
        && entry.amount is int
        && entry.amount >= 0;
    }

    function isValidBookingCommissionSnapshotV1(snap) {
      return snap is map
        && snap.size() == 5
        && snap.staffBasis in ['package', 'rehearsal_hourly', 'none']
        && snap.staffRate is number
        && snap.staffRate >= 0
        && snap.staffAmount is number
        && snap.staffAmount >= 0
        && snap.recordingOperatorAmount is number
        && snap.recordingOperatorAmount >= 0
        && snap.settingsVersion is int
        && snap.settingsVersion >= 1;
    }

    function isValidBookingCommissionSnapshotV2(snap) {
      return snap is map
        && snap.size() == 5
        && snap.schemaVersion == 2
        && isValidCommissionRoleEntry(snap.staff)
        && isValidCommissionRoleEntry(snap.owner)
        && isValidCommissionRoleEntry(snap.recordingOperator)
        && snap.settingsVersion is int
        && snap.settingsVersion >= 1;
    }

    function isValidConsumableStockMap(stock) {
      return stock is map
        && stock.size() == 1
        && stock.onHandQuantity is number
        && stock.onHandQuantity >= 0;
    }

    function isValidEquipmentStockMap(stock) {
      return stock is map
        && stock.size() == 4
        && stock.availableQuantity is int
        && stock.availableQuantity >= 0
        && stock.maintenanceQuantity is int
        && stock.maintenanceQuantity >= 0
        && stock.damagedQuantity is int
        && stock.damagedQuantity >= 0
        && stock.retiredQuantity is int
        && stock.retiredQuantity >= 0;
    }

    function isValidBookkeepingPaymentMethod(method) {
      return method in ['cash', 'transfer', 'qris', 'other'];
    }

    match /staffProfiles/{uid} {
      allow get: if request.auth != null
                 && request.auth.uid == uid;
    }

    match /systemOperations/{operationId} {
      allow get: if isActiveOwner() && operationId == 'factoryReset';
      allow list: if false;

      allow create: if isActiveOwner()
        && operationId == 'factoryReset'
        && isValidFactoryResetOperationCreate(request.resource.data);

      allow update: if isActiveOwner()
        && operationId == 'factoryReset'
        && isValidFactoryResetOperationUpdate(request.resource.data, resource.data);

      allow delete: if false;

      function isValidFactoryResetVerificationSummary(summary) {
        return summary == null
          || (
            summary is map
            && summary.keys().hasOnly([
              'allZero',
              'checkedCollectionsCount',
              'remainingTotal'
            ])
            && summary.size() == 3
            && summary.allZero is bool
            && summary.checkedCollectionsCount is int
            && summary.checkedCollectionsCount >= 0
            && summary.remainingTotal is int
            && summary.remainingTotal >= 0
          );
      }

      function isValidFactoryResetOperationShape(data) {
        return data.keys().hasOnly([
            'schemaVersion',
            'operationId',
            'status',
            'initiatedByUid',
            'initiatedAt',
            'currentCollection',
            'lastProcessedDocumentId',
            'completedCollections',
            'deletedDocumentCounts',
            'totalDeletedCount',
            'startedAt',
            'updatedAt',
            'completedAt',
            'lastErrorCode',
            'lastErrorMessage',
            'verificationSummary'
          ])
          && data.size() == 16
          && data.schemaVersion == 1
          && data.operationId is string
          && data.operationId.size() >= 8
          && data.operationId.size() <= 80
          && data.status in ['running', 'paused', 'failed', 'completed', 'cancelled']
          && data.initiatedByUid is string
          && data.initiatedByUid.size() >= 1
          && data.initiatedAt is timestamp
          && data.currentCollection is string
          && data.currentCollection.size() <= 80
          && data.lastProcessedDocumentId is string
          && data.lastProcessedDocumentId.size() <= 160
          && data.completedCollections is list
          && data.completedCollections.size() <= 40
          && data.deletedDocumentCounts is map
          && data.deletedDocumentCounts.size() <= 40
          && data.totalDeletedCount is int
          && data.totalDeletedCount >= 0
          && data.startedAt is timestamp
          && data.updatedAt is timestamp
          && (data.completedAt == null || data.completedAt is timestamp)
          && data.lastErrorCode is string
          && data.lastErrorCode.size() <= 80
          && data.lastErrorMessage is string
          && data.lastErrorMessage.size() <= 400
          && isValidFactoryResetVerificationSummary(data.verificationSummary);
      }

      function isValidFactoryResetOperationCreate(data) {
        return isValidFactoryResetOperationShape(data)
          && data.status == 'running'
          && data.initiatedByUid == request.auth.uid
          && data.totalDeletedCount == 0
          && data.completedCollections.size() == 0
          && data.completedAt == null
          && data.verificationSummary == null;
      }

      function isValidFactoryResetOperationUpdate(nextData, prevData) {
        return isValidFactoryResetOperationShape(nextData)
          && (
            (
              prevData.status in ['completed', 'cancelled']
              && nextData.status == 'running'
              && nextData.operationId != prevData.operationId
              && nextData.initiatedByUid == request.auth.uid
              && nextData.totalDeletedCount == 0
              && nextData.completedCollections.size() == 0
              && nextData.completedAt == null
              && nextData.verificationSummary == null
            ) || (
              prevData.status in ['running', 'paused', 'failed']
              && nextData.operationId == prevData.operationId
              && nextData.initiatedByUid == prevData.initiatedByUid
              && nextData.initiatedAt == prevData.initiatedAt
              && nextData.startedAt == prevData.startedAt
              && nextData.totalDeletedCount >= prevData.totalDeletedCount
              && (
                nextData.status != 'cancelled'
                || (
                  prevData.totalDeletedCount == 0
                  && nextData.totalDeletedCount == 0
                  && prevData.completedCollections.size() == 0
                  && nextData.completedCollections.size() == 0
                )
              )
              && (
                nextData.status != 'completed'
                || (
                  prevData.status == 'running'
                  && nextData.completedAt is timestamp
                  && nextData.verificationSummary is map
                  && nextData.verificationSummary.allZero == true
                  && nextData.verificationSummary.remainingTotal == 0
                )
              )
            )
          );
      }
    }

    match /settings/pricing {
      allow get: if isActiveStaff();
      allow list: if false;

      allow create: if isActiveOwner()
        && isValidPricingSettings(request.resource.data)
        && request.resource.data.version == 1;

      allow update: if isActiveOwner()
        && isValidPricingSettings(request.resource.data)
        && request.resource.data.version == resource.data.version + 1;

      allow delete: if false;

      function isValidOperationalSettingsV2(settings) {
        return settings is map
          && settings.size() == 1
          && settings.dailyMealAllowancePerStaff is int
          && settings.dailyMealAllowancePerStaff >= 0;
      }

      function isValidPricingSettings(data) {
        return data.size() == 6
          && data.schemaVersion == 2
          && data.serviceTypes is list
          && data.serviceTypes.size() >= 1
          && isValidOperationalSettingsV2(data.operationalSettings)
          && data.version is int
          && data.version >= 1
          && data.updatedAt is timestamp
          && data.updatedByUid == request.auth.uid;
      }
    }

    match /systemOperations/clientReservationBackfill {
      allow get: if isActiveOwner();
      allow list: if false;
      allow create: if isActiveOwner()
        && !isFactoryResetLocked()
        && isValidClientReservationBackfillOperation(request.resource.data)
        && request.resource.data.status in ['running', 'completed']
        && request.resource.data.lastRequestId == ''
        && request.resource.data.processedCount == 0
        && request.resource.data.projectedCount == 0
        && request.resource.data.skippedCount == 0
        && request.resource.data.version == 1;
      allow update: if isActiveOwner()
        && !isFactoryResetLocked()
        && isValidClientReservationBackfillOperation(request.resource.data)
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.processedCount >= resource.data.processedCount
        && request.resource.data.projectedCount >= resource.data.projectedCount
        && request.resource.data.skippedCount >= resource.data.skippedCount
        && request.resource.data.startedAt == resource.data.startedAt;
      allow delete: if false;

      function isValidClientReservationBackfillOperation(data) {
        return data.keys().hasOnly([
            'schemaVersion', 'status', 'lastRequestId', 'processedCount',
            'projectedCount', 'skippedCount', 'startedAt', 'updatedAt',
            'updatedByUid', 'version'
          ])
          && data.size() == 10
          && data.schemaVersion == 1
          && data.status in ['running', 'completed']
          && data.lastRequestId is string
          && data.lastRequestId.size() <= 128
          && data.processedCount is int
          && data.processedCount >= 0
          && data.projectedCount is int
          && data.projectedCount >= 0
          && data.skippedCount is int
          && data.skippedCount >= 0
          && data.startedAt is timestamp
          && data.updatedAt is timestamp
          && data.updatedByUid == request.auth.uid
          && data.version is int
          && data.version >= 1;
      }
    }

    match /settings/clientReservationBackfill {
      allow get: if isActiveOwner();
      allow list: if false;
      allow create, update: if isActiveOwner()
        && !isFactoryResetLocked()
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'status', 'cursorBookingId', 'processedCount',
          'projectedCount', 'skippedCount', 'version', 'updatedAt', 'updatedByUid'
        ])
        && request.resource.data.size() == 9
        && request.resource.data.schemaVersion == 1
        && request.resource.data.status in ['running', 'completed']
        && request.resource.data.cursorBookingId is string
        && request.resource.data.cursorBookingId.size() <= 140
        && request.resource.data.processedCount is int
        && request.resource.data.processedCount >= 0
        && request.resource.data.projectedCount is int
        && request.resource.data.projectedCount >= 0
        && request.resource.data.skippedCount is int
        && request.resource.data.skippedCount >= 0
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if false;
    }

    match /settings/bookingPolicies {
      allow get: if isActiveStaff();
      allow list: if false;
      allow create: if isActiveOwner()
        && !isFactoryResetLocked()
        && isValidBookingPolicies(request.resource.data)
        && request.resource.data.version == 1;
      allow update: if isActiveOwner()
        && !isFactoryResetLocked()
        && isValidBookingPolicies(request.resource.data)
        && request.resource.data.version == resource.data.version + 1;
      allow delete: if false;

      function isValidBookingPolicies(data) {
        return data.keys().hasOnly([
            'schemaVersion', 'defaultDepositPolicy', 'defaultHoldPolicy',
            'defaultBalanceDuePolicy', 'serviceOverrides', 'optionOverrides',
            'version', 'updatedAt', 'updatedByUid'
          ])
          && data.size() == 9
          && data.schemaVersion == 1
          && data.defaultDepositPolicy is map
          && data.defaultDepositPolicy.size() == 4
          && data.defaultDepositPolicy.type in ['none', 'fixed', 'percentage']
          && data.defaultDepositPolicy.fixedAmount is int
          && data.defaultDepositPolicy.fixedAmount >= 0
          && data.defaultDepositPolicy.percentage is int
          && data.defaultDepositPolicy.percentage >= 0
          && data.defaultDepositPolicy.percentage <= 100
          && data.defaultDepositPolicy.calculationBase in ['total_amount', 'subtotal']
          && data.defaultHoldPolicy is map
          && data.defaultHoldPolicy.size() == 3
          && (
            data.defaultHoldPolicy.defaultHours == null
            || (
              data.defaultHoldPolicy.defaultHours is int
              && data.defaultHoldPolicy.defaultHours >= 1
              && data.defaultHoldPolicy.defaultHours <= 168
            )
          )
          && data.defaultHoldPolicy.minMinutesBeforeSessionStart is int
          && data.defaultHoldPolicy.minMinutesBeforeSessionStart >= 0
          && data.defaultHoldPolicy.minMinutesBeforeSessionStart <= 1440
          && data.defaultHoldPolicy.allowPerBookingOverride is bool
          && data.defaultBalanceDuePolicy is map
          && data.defaultBalanceDuePolicy.size() == 2
          && data.defaultBalanceDuePolicy.trigger in ['before_session', 'at_check_in', 'before_delivery']
          && data.defaultBalanceDuePolicy.offsetHoursBeforeStart is int
          && data.defaultBalanceDuePolicy.offsetHoursBeforeStart >= 0
          && data.defaultBalanceDuePolicy.offsetHoursBeforeStart <= 168
          && data.serviceOverrides is map
          && data.serviceOverrides.size() <= 20
          && data.optionOverrides is map
          && data.optionOverrides.size() <= 100
          && data.version is int
          && data.version >= 1
          && data.updatedAt is timestamp
          && data.updatedByUid == request.auth.uid;
      }
    }

    match /settings/studioProfile {
      allow get: if isActiveStaff();
      allow list: if false;

      allow create: if isActiveOwner()
        && isValidStudioProfile(request.resource.data)
        && request.resource.data.version == 1;

      allow update: if isActiveOwner()
        && isValidStudioProfile(request.resource.data)
        && request.resource.data.version == resource.data.version + 1;

      allow delete: if false;

      function isValidStudioProfile(data) {
        return data.keys().hasOnly([
            'schemaVersion',
            'studioName',
            'tagline',
            'whatsappNumber',
            'email',
            'address',
            'city',
            'mapsUrl',
            'version',
            'updatedAt',
            'updatedByUid'
          ])
          && data.size() == 11
          && data.schemaVersion == 1
          && data.studioName is string
          && data.studioName.trim().size() >= 2
          && data.studioName.trim().size() <= 100
          && data.tagline is string
          && data.tagline.size() <= 160
          && data.whatsappNumber is string
          && data.whatsappNumber.size() <= 20
          && (data.whatsappNumber == '' || data.whatsappNumber.matches('^\\+[1-9][0-9]{7,14}$'))
          && data.email is string
          && data.email.size() <= 120
          && (data.email == '' || data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$'))
          && data.address is string
          && data.address.size() <= 300
          && data.city is string
          && data.city.size() <= 80
          && data.mapsUrl is string
          && data.mapsUrl.size() <= 500
          && (data.mapsUrl == '' || data.mapsUrl.matches('^https?://[^\\s]+$'))
          && data.version is int
          && data.version >= 1
          && data.updatedAt is timestamp
          && data.updatedByUid == request.auth.uid;
      }
    }

    match /customers/{customerId} {
      allow read: if isActiveStaff();

      allow create: if isActiveStaff()
        && !isFactoryResetLocked()
        && isValidCustomerShape(request.resource.data, customerId)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.version == 1;

      allow update: if isActiveStaff()
        && !isFactoryResetLocked()
        && isValidCustomerShape(request.resource.data, customerId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.version == resource.data.version + 1
        && (resource.data.status != 'merged'
            || (request.resource.data.status == 'merged'
                && request.resource.data.mergedIntoCustomerId == resource.data.mergedIntoCustomerId));

      allow delete: if canFactoryResetDelete();

      function isValidCustomerShape(data, customerId) {
        return data.keys().hasOnly([
            'displayName',
            'normalizedName',
            'phoneDisplay',
            'phoneNormalized',
            'nameAliases',
            'previousPhones',
            'status',
            'mergedIntoCustomerId',
            'historyCustomerIds',
            'bookingCount',
            'firstBookingDate',
            'lastBookingDate',
            'notes',
            'createdAt',
            'createdByUid',
            'updatedAt',
            'updatedByUid',
            'version',
            'email',
            'emailNormalized'
          ])
          && data.size() >= 18
          && data.size() <= 20
          && data.displayName is string
          && data.displayName.size() >= 1
          && data.displayName.size() <= 120
          && data.normalizedName is string
          && data.normalizedName.size() >= 1
          && data.phoneDisplay is string
          && data.phoneDisplay.size() >= 1
          && data.phoneNormalized is string
          && data.phoneNormalized.size() >= 8
          && data.nameAliases is list
          && data.previousPhones is list
          && data.status in ['active', 'archived', 'merged']
          && (data.status == 'merged'
            ? (data.mergedIntoCustomerId is string
                && data.mergedIntoCustomerId.size() > 0
                && data.mergedIntoCustomerId != customerId)
            : data.mergedIntoCustomerId == null)
          && data.historyCustomerIds is list
          && data.historyCustomerIds.size() >= 1
          && customerId in data.historyCustomerIds
          && data.bookingCount is int
          && data.bookingCount >= 0
          && data.firstBookingDate is string
          && data.lastBookingDate is string
          && data.notes is string
          && data.notes.size() <= 1000
          && data.createdAt is timestamp
          && data.createdByUid is string
          && data.updatedAt is timestamp
          && data.updatedByUid == request.auth.uid
          && data.version is int
          && data.version >= 1
          && (!('email' in data) || (data.email is string && data.email.size() <= 254))
          && (
            !('emailNormalized' in data)
            || (
              data.emailNormalized is string
              && (data.emailNormalized == '' || isValidNormalizedEmail(data.emailNormalized))
            )
          );
      }
    }

    match /customerPhoneIndex/{phoneHash} {
      allow get: if isActiveStaff();
      allow list: if isActiveOwner();

      allow create: if isActiveStaff()
        && !isFactoryResetLocked()
        && isValidPhoneIndex(request.resource.data)
        && request.resource.data.version == 1;

      allow update: if isActiveStaff()
        && !isFactoryResetLocked()
        && isValidPhoneIndex(request.resource.data)
        && request.resource.data.version == resource.data.version + 1;

      allow delete: if canFactoryResetDelete();

      function isValidPhoneIndex(data) {
        return data.size() == 6
          && data.phoneNormalized is string
          && data.phoneNormalized.size() >= 8
          && data.activeCustomerIds is list
          && data.historicalCustomerIds is list
          && (data.activeCustomerIds.size() == 0
            || existsAfter(/databases/$(database)/documents/customers/$(data.activeCustomerIds[0])))
          && data.version is int
          && data.version >= 1
          && data.updatedAt is timestamp
          && data.updatedByUid == request.auth.uid;
      }
    }

    match /bookings/{bookingId} {
      allow read: if isActiveStaff();

      allow create: if isActiveStaff()
        && !isFactoryResetLocked()
        && isValidBookingKeys(request.resource.data)
        && isValidBookingShape(request.resource.data)
        && hasValidBookingCustomerLinkAfter(request.resource.data)
        && isBookingAutomaticDiscountMathMatched(request.resource.data)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.version == 1;

      allow update: if isActiveStaff()
        && !isFactoryResetLocked()
        && isValidBookingUpdate(request.resource.data, resource.data, bookingId);

      allow delete: if canFactoryResetDelete();

      function isActiveLinkedCrmClientCustomerMatch(uid, customerId) {
        return isActiveClientCustomerMatch(uid, customerId)
          && getClientAccountDoc(uid).data.profileSource == 'linked_customer';
      }

      function isValidBookingKeys(data) {
        return data.size() >= 25
          && data.size() <= 78
          && !data.keys().hasAny([
            'role', 'active', 'amountPaid', 'balanceDue', 'paymentStatus', 'invoiceStatus', 'offerMode'
          ]);
      }

      function isValidBookingUpdateKeys(affected) {
        return affected.hasOnly([
          'schemaVersion',
          'invoiceId',
          'customerName',
          'phone',
          'phoneNormalized',
          'bandName',
          'studioId',
          'serviceTypeId',
          'serviceTypeName',
          'serviceOptionId',
          'serviceOptionName',
          'deliveryMode',
          'pricingMode',
          'pricingSettingsVersion',
          'serviceId',
          'serviceLabel',
          'packageId',
          'packageLabel',
          'recordingTypeId',
          'recordingTypeLabel',
          'date',
          'startMinute',
          'durationMinutes',
          'endMinute',
          'timeZone',
          'unitRate',
          'subtotal',
          'discountAmount',
          'totalAmount',
          'automaticDiscount',
          'commissionSnapshot',
          'reservationStatus',
          'sessionStatus',
          'cancelledAt',
          'cancelledByUid',
          'cancellationType',
          'cancellationReason',
          'checkedInAt',
          'checkedInByUid',
          'actualStartedAt',
          'actualCompletedAt',
          'notes',
          'updatedAt',
          'updatedByUid',
          'version'
        ]);
      }

      function isBookingLifecycleOnlyUpdate(reqData, resData, affected) {
        return reqData.sessionStatus in ['upcoming', 'in_progress', 'completed', 'no_show', 'cancelled']
          && (!('reservationStatus' in reqData) || reqData.reservationStatus in ['confirmed', 'cancelled'])
          && resData.get('reservationStatus', 'confirmed') != 'expired'
          && (
            resData.get('reservationStatus', 'confirmed') == 'confirmed'
            || reqData.sessionStatus == 'cancelled'
          )
          && (
            reqData.sessionStatus in ['cancelled', 'upcoming']
            || reqData.get('reservationStatus', 'confirmed') == 'confirmed'
          )
          && reqData.get('restoredAt', null) == resData.get('restoredAt', null)
          && reqData.get('expiredAt', null) == resData.get('expiredAt', null)
          && reqData.get('startMinute', 0) == resData.get('startMinute', 0)
          && reqData.get('endMinute', 0) == resData.get('endMinute', 0)
          && reqData.get('date', '') == resData.get('date', '')
          && reqData.get('studioId', '') == resData.get('studioId', '')
          && reqData.get('notes', '') == resData.get('notes', '')
          && reqData.get('totalAmount', 0) == resData.get('totalAmount', 0)
          && affected.hasOnly([
            'reservationStatus',
            'sessionStatus',
            'cancelledAt',
            'cancelledByUid',
            'cancellationType',
            'cancellationReason',
            'checkedInAt',
            'checkedInByUid',
            'actualStartedAt',
            'actualCompletedAt',
            'updatedAt',
            'updatedByUid',
            'version'
          ])
          && (!('checkedInAt' in reqData) || reqData.checkedInAt == null || reqData.checkedInAt is timestamp)
          && (!('checkedInByUid' in reqData) || reqData.checkedInByUid is string)
          && (!('actualStartedAt' in reqData) || reqData.actualStartedAt == null || reqData.actualStartedAt is timestamp)
          && (!('actualCompletedAt' in reqData) || reqData.actualCompletedAt == null || reqData.actualCompletedAt is timestamp)
          && reqData.updatedAt is timestamp
          && reqData.updatedByUid == request.auth.uid
          && reqData.version is int
          && reqData.version == resData.version + 1;
      }

      function isBookingLifecycleEligibleBeforeDiff(reqData, resData) {
        return reqData.sessionStatus in ['upcoming', 'in_progress', 'completed', 'no_show', 'cancelled']
          && (!('reservationStatus' in reqData) || reqData.reservationStatus in ['confirmed', 'cancelled'])
          && resData.get('reservationStatus', 'confirmed') != 'expired'
          && (
            resData.get('reservationStatus', 'confirmed') == 'confirmed'
            || reqData.sessionStatus == 'cancelled'
          )
          && (
            reqData.sessionStatus in ['cancelled', 'upcoming']
            || reqData.get('reservationStatus', 'confirmed') == 'confirmed'
          )
          && reqData.get('restoredAt', null) == resData.get('restoredAt', null)
          && reqData.get('expiredAt', null) == resData.get('expiredAt', null)
          && reqData.get('startMinute', 0) == resData.get('startMinute', 0)
          && reqData.get('endMinute', 0) == resData.get('endMinute', 0)
          && reqData.get('date', '') == resData.get('date', '')
          && reqData.get('studioId', '') == resData.get('studioId', '')
          && reqData.get('notes', '') == resData.get('notes', '')
          && reqData.get('totalAmount', 0) == resData.get('totalAmount', 0);
      }

      function isHoldDepositVerifiedByInvoiceAfter(bookingId, reqData) {
        let invAfter = getAfter(/databases/$(database)/documents/invoices/$('inv_' + bookingId));
        return invAfter != null && invAfter.data.amountPaid >= reqData.get('minimumDepositAmount', 0);
      }

      function isHoldExpiryAllowedByLockAndInvoice(bookingId) {
        let lockPath = /databases/$(database)/documents/paymentEvidenceLocks/$('inv_' + bookingId);
        let invBefore = get(/databases/$(database)/documents/invoices/$('inv_' + bookingId));
        let invAfter = getAfter(/databases/$(database)/documents/invoices/$('inv_' + bookingId));
        return (!exists(lockPath) || get(lockPath).data.pendingCount == 0)
          && (
            invBefore == null
            || invBefore.data.amountPaid > 0
            || (invAfter != null && invAfter.data.invoiceStatus == 'void')
          );
      }

      function isBookingHoldImmutableFieldsUnchanged(reqData, resData) {
        return reqData.customerId == resData.customerId
          && reqData.get('clientUid', '') == resData.get('clientUid', '')
          && reqData.get('invoiceId', '') == resData.get('invoiceId', '')
          && reqData.customerName == resData.customerName
          && reqData.phone == resData.phone
          && reqData.bandName == resData.bandName
          && reqData.studioId == resData.studioId
          && reqData.date == resData.date
          && reqData.startMinute == resData.startMinute
          && reqData.durationMinutes == resData.durationMinutes
          && reqData.endMinute == resData.endMinute
          && reqData.unitRate == resData.unitRate
          && reqData.subtotal == resData.subtotal
          && reqData.discountAmount == resData.discountAmount
          && reqData.totalAmount == resData.totalAmount
          && reqData.initialPaymentStatus == resData.initialPaymentStatus
          && reqData.initialPaidAmount == resData.initialPaidAmount
          && reqData.paymentMethod == resData.paymentMethod
          && reqData.get('minimumDepositAmount', 0) == resData.get('minimumDepositAmount', 0)
          && reqData.get('serviceTypeId', '') == resData.get('serviceTypeId', '')
          && reqData.get('serviceOptionId', '') == resData.get('serviceOptionId', '')
          && reqData.get('createdAt', null) == resData.get('createdAt', null)
          && reqData.get('createdByUid', '') == resData.get('createdByUid', '')
          && reqData.size() <= 78
          && !reqData.keys().hasAny(['role', 'active', 'amountPaid', 'balanceDue', 'paymentStatus', 'invoiceStatus', 'offerMode']);
      }

      function isBookingHoldLifecycleUpdate(reqData, resData, bookingId) {
        let prevRes = resData.get('reservationStatus', 'confirmed');
        let nextRes = reqData.get('reservationStatus', 'confirmed');
        return (
            prevRes in ['deposit_hold', 'expired']
            || nextRes != prevRes
            || reqData.get('depositStatus', '') != resData.get('depositStatus', '')
            || reqData.get('depositIntegrityAlert', false) != resData.get('depositIntegrityAlert', false)
          )
          && reqData.updatedAt is timestamp
          && reqData.updatedByUid == request.auth.uid
          && reqData.version is int
          && reqData.version == resData.version + 1
          && isBookingHoldImmutableFieldsUnchanged(reqData, resData)
          && (
            (
              prevRes == 'deposit_hold'
              && nextRes == 'confirmed'
              && reqData.sessionStatus == 'upcoming'
              && reqData.holdExpiresAt == null
              && reqData.confirmedAt is timestamp
              && reqData.confirmedByUid == request.auth.uid
              && reqData.confirmationSource in ['deposit_verified', 'no_deposit_policy', 'staff_override']
              && (reqData.confirmationSource != 'deposit_verified' || isHoldDepositVerifiedByInvoiceAfter(bookingId, reqData))
              && (reqData.confirmationSource != 'staff_override' || (reqData.confirmationOverrideReason is string && reqData.confirmationOverrideReason.size() >= 5))
            )
            || (
              prevRes == 'deposit_hold'
              && nextRes == 'deposit_hold'
              && reqData.sessionStatus == 'pending_confirmation'
              && reqData.holdExpiresAt is timestamp
              && reqData.holdExtensionCount == resData.get('holdExtensionCount', 0) + 1
              && reqData.holdLastExtendedAt is timestamp
              && reqData.holdLastExtendedByUid == request.auth.uid
              && reqData.holdLastExtensionReason is string
              && reqData.holdLastExtensionReason.size() >= 5
            )
            || (
              prevRes == 'deposit_hold'
              && nextRes == 'expired'
              && reqData.sessionStatus == 'cancelled'
              && reqData.expiredAt is timestamp
              && reqData.expiredByUid == request.auth.uid
              && reqData.expiryReason is string
              && reqData.expiryReason.size() >= 5
              && isHoldExpiryAllowedByLockAndInvoice(bookingId)
            )
            || (
              prevRes == 'expired'
              && nextRes in ['deposit_hold', 'confirmed']
              && (nextRes == 'deposit_hold'
                ? reqData.sessionStatus == 'pending_confirmation' && reqData.holdExpiresAt is timestamp
                : reqData.sessionStatus == 'upcoming' && reqData.holdExpiresAt == null)
              && reqData.restoredAt is timestamp
              && reqData.restoredByUid == request.auth.uid
              && reqData.restorationReason is string
              && reqData.restorationReason.size() >= 5
            )
            || (
              nextRes == prevRes
              && reqData.sessionStatus == resData.sessionStatus
              && (
                reqData.get('depositStatus', '') != resData.get('depositStatus', '')
                || reqData.get('depositIntegrityAlert', false) != resData.get('depositIntegrityAlert', false)
              )
              && reqData.get('confirmedAt', null) == resData.get('confirmedAt', null)
              && reqData.get('expiredAt', null) == resData.get('expiredAt', null)
              && reqData.get('restoredAt', null) == resData.get('restoredAt', null)
              && reqData.get('holdLastExtendedAt', null) == resData.get('holdLastExtendedAt', null)
            )
          );
      }

      function isValidBookingV2ServiceFields(data) {
        let psv = data.get('pricingSettingsVersion', 1);
        return (!('serviceTypeId' in data) || (data.serviceTypeId is string && data.serviceTypeId.size() > 0))
          && data.get('serviceTypeName', '') is string
          && data.get('serviceOptionId', '') is string
          && data.get('serviceOptionName', '') is string
          && (!('deliveryMode' in data) || data.deliveryMode == 'studio')
          && data.get('pricingMode', 'hourly') in ['hourly', 'fixed_shift', 'manual_quote']
          && psv is int
          && psv >= 1;
      }

      function isValidAutomaticDiscountMap(disc, subtotal, discountAmount) {
        return disc.size() == 5
          && disc.type == 'duration_multiple'
          && disc.intervalMinutes is int
          && disc.intervalMinutes > 0
          && disc.eligibleBlocks is int
          && disc.eligibleBlocks > 0
          && disc.discountPerBlock is int
          && disc.discountPerBlock > 0
          && disc.totalDiscount is int
          && disc.totalDiscount > 0
          && disc.totalDiscount <= subtotal
          && discountAmount == disc.totalDiscount
          && (
            disc.totalDiscount == disc.eligibleBlocks * disc.discountPerBlock
            || (disc.totalDiscount == subtotal && disc.eligibleBlocks * disc.discountPerBlock > subtotal)
          );
      }

      function isValidBookingAutomaticDiscountShape(data) {
        return !('automaticDiscount' in data)
          || data.automaticDiscount == null
          || (
            data.automaticDiscount is map
            && isValidAutomaticDiscountMap(data.automaticDiscount, data.subtotal, data.discountAmount)
          );
      }

      function isBookingAutomaticDiscountMathMatched(data) {
        return !('automaticDiscount' in data)
          || data.automaticDiscount == null
          || (
            data.automaticDiscount.eligibleBlocks * data.automaticDiscount.intervalMinutes <= data.durationMinutes
            && (data.automaticDiscount.eligibleBlocks + 1) * data.automaticDiscount.intervalMinutes > data.durationMinutes
          );
      }

      function isValidBookingCommissionSnapshot(data) {
        let snap = data.get('commissionSnapshot', null);
        return snap == null
          || (snap is map && (
            snap.get('schemaVersion', 1) == 2
              ? isValidBookingCommissionSnapshotV2(snap)
              : isValidBookingCommissionSnapshotV1(snap)
          ));
      }

      function isServiceScopeUnchanged(reqData, resData) {
        return reqData.serviceId == resData.serviceId
          && reqData.packageId == resData.packageId
          && reqData.recordingTypeId == resData.recordingTypeId
          && reqData.get('serviceTypeId', '') == resData.get('serviceTypeId', '')
          && reqData.get('serviceOptionId', '') == resData.get('serviceOptionId', '')
          && reqData.durationMinutes == resData.durationMinutes;
      }

      function isValidBookingCoreShape(data) {
        let sm = data.startMinute;
        let dm = data.durationMinutes;
        let em = data.endMinute;
        let sub = data.subtotal;
        let da = data.discountAmount;
        let tot = data.totalAmount;
        let ipa = data.initialPaidAmount;
        return data.customerName is string
          && data.customerName.size() > 0
          && data.get('clientUid', '') is string
          && data.get('source', 'staff_created') in ['client_portal', 'staff_created']
          && data.get('sourceRequestId', '') is string
          && data.get('acceptedOfferId', '') is string
          && data.phone is string
          && data.phone.size() > 0
          && data.bandName is string
          && data.studioId in ['room-a', 'room-b']
          && isValidBookingV2ServiceFields(data)
          && data.serviceId is string
          && data.serviceLabel is string
          && data.packageId is string
          && data.packageLabel is string
          && data.recordingTypeId is string
          && data.recordingTypeLabel is string
          && data.date is string
          && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && sm is int
          && sm >= 600
          && sm < 1380
          && sm % 30 == 0
          && dm is int
          && dm > 0
          && dm % 30 == 0
          && em == sm + dm
          && em <= 1380
          && data.timeZone == 'Asia/Jakarta'
          && data.unitRate is int
          && data.unitRate >= 0
          && sub is int
          && sub >= 0
          && da is int
          && da >= 0
          && da <= sub
          && tot >= 0
          && tot == sub - da
          && data.initialPaymentStatus in ['unpaid', 'partial', 'paid']
          && ipa is number
          && ipa >= 0
          && ipa <= tot
          && data.paymentMethod is string
          && data.sessionStatus in ['pending_confirmation', 'upcoming', 'in_progress', 'completed', 'no_show', 'cancelled']
          && (
            !('reservationStatus' in data)
            || (
              data.reservationStatus in ['deposit_hold', 'confirmed', 'expired', 'cancelled']
              && (data.reservationStatus != 'deposit_hold'
                || (data.sessionStatus == 'pending_confirmation' && data.get('holdExpiresAt', null) is timestamp))
              && (data.reservationStatus == 'confirmed'
                || !(data.sessionStatus in ['in_progress', 'completed', 'no_show']))
            )
          )
          && data.notes is string
          && data.version is int
          && data.version >= 1;
      }

      function isValidBookingShape(data) {
        return isValidBookingCoreShape(data)
          && isValidBookingAutomaticDiscountShape(data)
          && isValidBookingCommissionSnapshot(data);
      }

      function isLinkedCustomerPhoneMatchedAfter(customerId, phoneNormalized, requireActive) {
        let linkedCustomer = getAfter(/databases/$(database)/documents/customers/$(customerId));
        return linkedCustomer != null
          && linkedCustomer.data.phoneNormalized == phoneNormalized
          && (!requireActive || linkedCustomer.data.status == 'active');
      }

      function hasValidBookingCustomerLinkAfter(data) {
        let sourceRequestId = data.get('sourceRequestId', '');
        let clientUid = data.get('clientUid', '');
        return ('customerId' in data)
          && data.customerId is string
          && data.customerId.size() > 0
          && ('phoneNormalized' in data)
          && data.phoneNormalized is string
          && data.phoneNormalized.size() >= 8
          && (
            isLinkedCustomerPhoneMatchedAfter(data.customerId, data.phoneNormalized, true)
            || (
              data.get('source', '') == 'client_portal'
              && clientUid is string
              && clientUid.size() > 0
              && sourceRequestId is string
              && sourceRequestId.size() > 0
              && exists(/databases/$(database)/documents/publicBookingRequests/$(sourceRequestId))
              && get(/databases/$(database)/documents/publicBookingRequests/$(sourceRequestId)).data.source == 'client_portal'
              && get(/databases/$(database)/documents/publicBookingRequests/$(sourceRequestId)).data.clientUid == clientUid
              && get(/databases/$(database)/documents/publicBookingRequests/$(sourceRequestId)).data.customerId == data.customerId
            )
          );
      }

      function isLegacyBookingCustomerLinkUpdate(reqData, resData, affected) {
        return resData.get('customerId', '') == ''
          && reqData.customerId is string
          && reqData.customerId.size() > 0
          && reqData.phoneNormalized is string
          && reqData.phoneNormalized.size() >= 8
          && reqData.updatedByUid == request.auth.uid
          && reqData.updatedAt is timestamp
          && reqData.version == resData.version + 1
          && affected.hasOnly([
            'customerId',
            'phoneNormalized',
            'updatedAt',
            'updatedByUid',
            'version'
          ])
          && isLinkedCustomerPhoneMatchedAfter(reqData.customerId, reqData.phoneNormalized, false);
      }

      function isValidBookingFocusedPricingUpdate(reqData, resData) {
        // Use this fast path only when duration changes; unchanged-scope price edits
        // must continue through the stricter standard-update branch.
        return ('durationMinutes' in reqData)
          && ('durationMinutes' in resData)
          && reqData.durationMinutes != resData.durationMinutes
          && (
            reqData.subtotal != resData.subtotal
            || reqData.discountAmount != resData.discountAmount
            || reqData.totalAmount != resData.totalAmount
            || reqData.unitRate != resData.unitRate
            || reqData.diff(resData).affectedKeys().hasAny(['automaticDiscount', 'commissionSnapshot'])
          )
          && reqData.diff(resData).affectedKeys().hasOnly([
            'startMinute', 'durationMinutes', 'endMinute', 'unitRate',
            'subtotal', 'discountAmount', 'totalAmount', 'automaticDiscount',
            'commissionSnapshot', 'notes', 'updatedAt', 'updatedByUid', 'version'
          ])
          && reqData.notes is string
          && reqData.startMinute is int
          && reqData.startMinute >= 600
          && reqData.startMinute < 1380
          && reqData.startMinute % 30 == 0
          && reqData.durationMinutes is int
          && reqData.durationMinutes > 0
          && reqData.durationMinutes % 30 == 0
          && reqData.endMinute == reqData.startMinute + reqData.durationMinutes
          && reqData.endMinute <= 1380
          && reqData.timeZone == 'Asia/Jakarta'
          && reqData.unitRate is int
          && reqData.unitRate >= 0
          && reqData.subtotal is int
          && reqData.subtotal >= 0
          && reqData.discountAmount is int
          && reqData.discountAmount >= 0
          && reqData.discountAmount <= reqData.subtotal
          && reqData.totalAmount == reqData.subtotal - reqData.discountAmount
          && isValidBookingAutomaticDiscountShape(reqData)
          && isBookingAutomaticDiscountMathMatched(reqData)
          && isValidBookingCommissionSnapshot(reqData)
          && reqData.updatedAt is timestamp
          && reqData.updatedByUid == request.auth.uid
          && reqData.version is int
          && reqData.version == resData.version + 1;
      }

      function isValidBookingStandardPricingUpdate(reqData, resData, affected) {
        return isServiceScopeUnchanged(reqData, resData)
          ? (
            reqData.unitRate == resData.unitRate
            && reqData.subtotal == resData.subtotal
            && reqData.discountAmount == resData.discountAmount
            && reqData.totalAmount == resData.totalAmount
            && (
              !affected.hasAny(['automaticDiscount'])
              || (reqData.get('automaticDiscount', null) == null && resData.get('automaticDiscount', null) == null)
            )
            && (
              !affected.hasAny(['commissionSnapshot'])
              || (reqData.get('commissionSnapshot', null) == null && resData.get('commissionSnapshot', null) == null)
            )
          )
          : (
            isValidBookingAutomaticDiscountShape(reqData)
            && isBookingAutomaticDiscountMathMatched(reqData)
            && isValidBookingCommissionSnapshot(reqData)
          );
      }

      function isValidBookingStandardUpdate(reqData, resData) {
        return isValidBookingUpdateKeys(reqData.diff(resData).affectedKeys())
          && isValidBookingCoreShape(reqData)
          && reqData.updatedByUid == request.auth.uid
          && isValidBookingStandardPricingUpdate(reqData, resData, reqData.diff(resData).affectedKeys());
      }

      function isLegacyBookingClientUidUpdate(reqData, resData, bookingId) {
        let requestId = reqData.get('sourceRequestId', '');
        let clientUid = reqData.get('clientUid', '');
        return resData.get('clientUid', '') == ''
          && clientUid is string
          && clientUid.size() > 0
          && requestId is string
          && requestId.size() > 0
          && reqData.get('source', '') == 'client_portal'
          && reqData.get('acceptedOfferId', '') is string
          && reqData.updatedByUid == request.auth.uid
          && reqData.updatedAt is timestamp
          && reqData.version == resData.version + 1
          && reqData.diff(resData).affectedKeys().hasOnly([
            'clientUid', 'source', 'sourceRequestId', 'acceptedOfferId',
            'updatedAt', 'updatedByUid', 'version'
          ])
          && exists(/databases/$(database)/documents/publicBookingRequests/$(requestId))
          && get(/databases/$(database)/documents/publicBookingRequests/$(requestId)).data.source == 'client_portal'
          && get(/databases/$(database)/documents/publicBookingRequests/$(requestId)).data.clientUid == clientUid
          && get(/databases/$(database)/documents/publicBookingRequests/$(requestId)).data.status == 'confirmed'
          && get(/databases/$(database)/documents/publicBookingRequests/$(requestId)).data.linkedBookingId == bookingId;
      }

      function isLegacyBookingCrmClientUidUpdate(reqData, resData, bookingId) {
        let customerId = resData.get('customerId', '');
        let clientUid = reqData.get('clientUid', '');
        let reservationPath = /databases/$(database)/documents/clientReservations/$(bookingId);
        return resData.get('clientUid', '') == ''
          && clientUid is string
          && clientUid.size() > 0
          && clientUid.size() <= 128
          && customerId is string
          && customerId.size() > 0
          && reqData.get('customerId', '') == customerId
          && reqData.updatedAt is timestamp
          && reqData.updatedByUid == request.auth.uid
          && reqData.version is int
          && reqData.version == resData.version + 1
          && isActiveOwner()
          && reqData.diff(resData).affectedKeys().hasOnly(['clientUid', 'updatedAt', 'updatedByUid', 'version'])
          && existsAfter(reservationPath)
          && isActiveLinkedCrmClientCustomerMatch(clientUid, customerId)
          && getAfter(reservationPath).data.bookingId == bookingId
          && getAfter(reservationPath).data.customerId == customerId
          && getAfter(reservationPath).data.clientUid == clientUid
          && getAfter(reservationPath).data.version == reqData.version;
      }

      function isValidBookingUpdate(reqData, resData, bookingId) {
        return isValidBookingFocusedPricingUpdate(reqData, resData)
          || (
            isBookingLifecycleEligibleBeforeDiff(reqData, resData)
            && isBookingLifecycleOnlyUpdate(reqData, resData, reqData.diff(resData).affectedKeys())
          )
          || isBookingHoldLifecycleUpdate(reqData, resData, bookingId)
          || (
            resData.get('customerId', '') == ''
            && isLegacyBookingCustomerLinkUpdate(reqData, resData, reqData.diff(resData).affectedKeys())
          )
          || isLegacyBookingClientUidUpdate(reqData, resData, bookingId)
          || isLegacyBookingCrmClientUidUpdate(reqData, resData, bookingId)
          || (
            resData.get('reservationStatus', 'confirmed') in ['confirmed', 'deposit_hold']
            && reqData.get('reservationStatus', 'confirmed') == resData.get('reservationStatus', 'confirmed')
            && isValidBookingStandardUpdate(reqData, resData)
          );
      }
    }

    match /clientReservations/{bookingId} {
      allow get, list: if isActiveStaff() || isClientDocumentOwner(resource.data);
      allow create, update: if isActiveStaff()
        && !isFactoryResetLocked()
        && isValidClientReservationShape(request.resource.data, bookingId)
        && isClientReservationBackedByCanonicalMutation(bookingId);
      allow delete: if canFactoryResetDelete();

      function isClientReservationBookingDataMatched(data, b) {
        let expectedServiceName = b.get('serviceTypeName', '') != ''
          ? b.serviceTypeName
          : (
            b.get('serviceTypeId', '') != ''
              ? b.serviceTypeId
              : b.get('serviceLabel', '')
          );
        let expectedOptionName = b.get('serviceOptionName', '') != ''
          ? b.serviceOptionName
          : b.get('packageLabel', '');
        return b.get('clientUid', '') == data.clientUid
          && b.customerId == data.customerId
          && b.get('sourceRequestId', '') == data.sourceRequestId
          && b.get('acceptedOfferId', '') == data.acceptedOfferId
          && b.date == data.date
          && b.studioId == data.studioId
          && b.startMinute == data.startMinute
          && b.endMinute == data.endMinute
          && b.durationMinutes == data.durationMinutes
          && b.get('timeZone', 'Asia/Jakarta') == data.timeZone
          && expectedServiceName == data.serviceTypeName
          && expectedOptionName == data.serviceOptionName
          && b.get('sessionStatus', 'upcoming') == data.sessionStatus
          && data.reservationStatus == (
            b.get('reservationStatus', '') != ''
              ? b.reservationStatus
              : (b.get('sessionStatus', 'upcoming') == 'cancelled'
                ? 'cancelled'
                : 'confirmed')
          )
          && b.get('holdExpiresAt', null) == data.holdExpiresAt
          && b.version == data.version;
      }

      function isClientReservationBookingMatched(data, bookingId) {
        let bookingAfter = getAfter(/databases/$(database)/documents/bookings/$(bookingId));
        return bookingAfter != null
          && isClientReservationBookingDataMatched(data, bookingAfter.data);
      }

      function isClientReservationFinancialSummaryMatched(data, bookingId) {
        let bookingPath = /databases/$(database)/documents/bookings/$(bookingId);
        let invoiceId = 'inv_' + bookingId;
        let invoicePath = /databases/$(database)/documents/invoices/$(invoiceId);
        let bookingAfter = getAfter(bookingPath);
        let invoiceAfter = getAfter(invoicePath);
        let legacyTotal = bookingAfter != null ? bookingAfter.data.get('totalAmount', 0) : 0;
        let legacyPaid = bookingAfter != null ? bookingAfter.data.get('initialPaidAmount', 0) : 0;
        let expectedEffectiveTotal = invoiceAfter != null
          ? invoiceAfter.data.get('effectiveTotalAmount', invoiceAfter.data.financialSnapshot.totalAmount)
          : legacyTotal;
        return bookingAfter != null && (
          invoiceAfter != null
          ? invoiceAfter.data.bookingId == bookingId
            && invoiceAfter.data.customerId == data.customerId
            && expectedEffectiveTotal == data.effectiveTotalAmount
            && invoiceAfter.data.paymentStatus == data.paymentStatus
            && bookingAfter.data.get('minimumDepositAmount', null) == data.minimumDepositAmount
            && bookingAfter.data.get('depositStatus', null) == data.depositStatus
            && (
              invoiceAfter.data.get('clientUid', '') == ''
              || invoiceAfter.data.clientUid == data.clientUid
            )
          : data.effectiveTotalAmount == legacyTotal
            && data.paymentStatus == (
              legacyPaid >= legacyTotal
                ? 'paid'
                : (legacyPaid > 0 ? 'partial' : 'unpaid')
            )
            && data.minimumDepositAmount == bookingAfter.data.get('minimumDepositAmount', null)
            && data.depositStatus == bookingAfter.data.get('depositStatus', null)
        );
      }

      function isClientReservationBackedByCanonicalMutation(bookingId) {
        let bookingPath = /databases/$(database)/documents/bookings/$(bookingId);
        let invoiceId = 'inv_' + bookingId;
        let invoicePath = /databases/$(database)/documents/invoices/$(invoiceId);
        let bookingBefore = get(bookingPath);
        let bookingAfter = getAfter(bookingPath);
        let invoiceBefore = get(invoicePath);
        let invoiceAfter = getAfter(invoicePath);
        return (bookingBefore == null && bookingAfter != null)
          || (
            bookingBefore != null
            && bookingAfter != null
            && bookingAfter.data.version == bookingBefore.data.version + 1
            && bookingAfter.data.updatedAt == request.time
          )
          || (
            invoiceAfter != null
            && (
              invoiceBefore == null
              || (
                invoiceAfter.data.version == invoiceBefore.data.version + 1
                && invoiceAfter.data.updatedAt == request.time
              )
            )
          )
          || isActiveOwner();
      }

      function isValidClientReservationShape(data, bookingId) {
        return data.keys().hasOnly([
            'schemaVersion', 'bookingId', 'bookingReference', 'customerId', 'clientUid',
            'sourceRequestId', 'acceptedOfferId', 'invoiceId', 'studioId', 'studioName',
            'serviceTypeName', 'serviceOptionName', 'date', 'startMinute', 'endMinute',
            'durationMinutes', 'timeZone', 'reservationStatus', 'sessionStatus', 'holdExpiresAt',
            'effectiveTotalAmount', 'minimumDepositAmount', 'depositStatus', 'paymentStatus',
            'createdAt', 'updatedAt', 'version'
          ])
          && data.size() == 27
          && data.schemaVersion == 2
          && data.bookingId == bookingId
          && data.bookingReference is string
          && data.customerId is string
          && data.clientUid is string
          && data.invoiceId == 'inv_' + bookingId
          && data.studioId in ['room-a', 'room-b']
          && data.studioName is string
          && data.serviceTypeName is string
          && data.serviceOptionName is string
          && data.date is string
          && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && data.startMinute is int
          && data.endMinute is int
          && data.durationMinutes is int
          && data.endMinute == data.startMinute + data.durationMinutes
          && data.timeZone == 'Asia/Jakarta'
          && data.reservationStatus in ['deposit_hold', 'confirmed', 'expired', 'cancelled']
          && data.sessionStatus in ['pending_confirmation', 'upcoming', 'in_progress', 'completed', 'no_show', 'cancelled']
          && (data.holdExpiresAt == null || data.holdExpiresAt is timestamp)
          && data.effectiveTotalAmount is int
          && data.effectiveTotalAmount >= 0
          && (data.minimumDepositAmount == null || data.minimumDepositAmount is int)
          && (data.depositStatus == null || data.depositStatus is string)
          && data.paymentStatus in ['unpaid', 'partial', 'paid', 'overpaid_credit_pending']
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && data.updatedAt == request.time
          && data.version is int
          && isClientReservationBookingMatched(data, bookingId)
          && isClientReservationFinancialSummaryMatched(data, bookingId);
      }
    }

    match /bookingSlots/{slotId} {
      allow read: if isActiveStaff();

      allow create, update: if isActiveStaff()
        && !isFactoryResetLocked()
        && request.resource.data.keys().hasOnly([
          'bookingId',
          'date',
          'studioId',
          'slotStartMinute',
          'createdAt'
        ])
        && request.resource.data.bookingId is string
        && request.resource.data.bookingId.size() > 0
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.studioId in ['room-a', 'room-b']
        && request.resource.data.slotStartMinute is int
        && request.resource.data.slotStartMinute >= 600
        && request.resource.data.slotStartMinute < 1380
        && request.resource.data.slotStartMinute % 30 == 0
        && isValidSlotCanonicalBookingAfter(request.resource.data);

      allow delete: if (!isFactoryResetLocked() && isActiveStaff())
        || canFactoryResetDelete();

      function isValidSlotCanonicalBookingAfter(data) {
        let bookingAfter = getAfter(/databases/$(database)/documents/bookings/$(data.bookingId));
        return bookingAfter != null
          && bookingAfter.data.date == data.date
          && bookingAfter.data.studioId == data.studioId
          && !(bookingAfter.data.get('reservationStatus', 'confirmed') in ['expired', 'cancelled'])
          && !(bookingAfter.data.sessionStatus in ['cancelled', 'no_show']);
      }
    }

    match /bookingEvents/{eventId} {
      allow read: if isActiveStaff();

      allow create: if isActiveStaff()
        && !isFactoryResetLocked()
        && request.resource.data.keys().hasOnly([
          'bookingId',
          'eventType',
          'actorUid',
          'createdAt',
          'previousValue',
          'newValue',
          'note'
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.bookingId is string
        && request.resource.data.bookingId.size() > 0
        && request.resource.data.eventType is string
        && request.resource.data.eventType.size() > 0
        && existsAfter(
          /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
        );

      allow update: if false;
      allow delete: if canFactoryResetDelete();
    }

    match /invoices/{invoiceId} {
      allow get: if isActiveStaff()
        || (resource != null && isClientReadableInvoiceData(resource.data));

      allow list: if isActiveStaff()
        || (
          resource.data.invoiceStatus in ['issued', 'void']
          && isClientDocumentOwner(resource.data)
        );

      allow create: if isActiveStaff()
        && !isFactoryResetLocked()
        && isValidInvoiceBase(request.resource.data, invoiceId)
        && request.resource.data.invoiceStatus in ['draft', 'issued']
        && request.resource.data.voidReason == ''
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.version == 1
        && (request.resource.data.get('clientPaymentEvidenceRequired', false) == false
          || request.resource.data.amountPaid == 0)
        && existsAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
        && (
          !('clientUid' in request.resource.data)
          || (
            getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.get('clientUid', '') == request.resource.data.clientUid
            && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customerId == request.resource.data.customerId
          )
        )
        && isValidInitialInvoicePaymentLinkAfter(request.resource.data, invoiceId);

      allow update: if isActiveStaff()
        && !isFactoryResetLocked()
        && (
          isLegacyInvoiceClientUidUpdate(request.resource.data, resource.data, invoiceId)
          || (
            request.resource.data.version == resource.data.version + 1
            && isValidInvoiceMutableUpdateBase(request.resource.data)
            && isInvoiceImmutableFieldsUnchanged(request.resource.data, resource.data)
            && (
              (
                resource.data.invoiceStatus == 'issued'
                && request.resource.data.invoiceStatus == 'issued'
                && request.resource.data.voidReason == resource.data.voidReason
                && request.resource.data.dueDate == resource.data.dueDate
                && isValidInvoiceAdjustmentUpdate(request.resource.data, resource.data, invoiceId)
              )
              || (
                isInvoiceAdjustmentSummaryUnchanged(request.resource.data, resource.data)
                && (
                  (
                    resource.data.invoiceStatus == 'issued'
                    && request.resource.data.invoiceStatus == 'issued'
                    && request.resource.data.voidReason == resource.data.voidReason
                    && request.resource.data.dueDate == resource.data.dueDate
                    && isValidInvoicePaymentAggregateUpdate(request.resource.data, resource.data, invoiceId)
                  )
                  || (
                    request.resource.data.amountPaid == resource.data.amountPaid
                    && request.resource.data.balanceDue == resource.data.balanceDue
                    && request.resource.data.paymentStatus == resource.data.paymentStatus
                    && request.resource.data.lastPaymentTransactionId == resource.data.lastPaymentTransactionId
                    && (
                      (
                        isValidInvoiceVoidUpdate(request.resource.data, resource.data)
                        && isInvoiceWithoutPendingEvidenceLock(invoiceId)
                      )
                      || isValidInvoiceRestoreUnvoidUpdate(request.resource.data, resource.data)
                      || (
                        resource.data.invoiceStatus == 'issued'
                        && request.resource.data.invoiceStatus == 'issued'
                        && request.resource.data.voidReason == resource.data.voidReason
                        && request.resource.data.dueDate != resource.data.dueDate
                      )
                      || (
                        resource.data.invoiceStatus == 'draft'
                        && request.resource.data.invoiceStatus == 'issued'
                        && request.resource.data.dueDate == resource.data.dueDate
                        && request.resource.data.voidReason == ''
                      )
                    )
                  )
                )
              )
            )
          )
        );

      allow delete: if canFactoryResetDelete();

      function isClientReadableInvoiceData(data) {
        return data != null
          && data.invoiceStatus in ['issued', 'void']
          && isClientDocumentOwner(data);
      }

      function isValidInvoiceSnapshots(data) {
        return data.customerSnapshot is map
          && data.customerSnapshot.size() == 3
          && data.customerSnapshot.name is string
          && data.customerSnapshot.name.size() > 0
          && data.customerSnapshot.phone is string
          && data.customerSnapshot.bandName is string
          && data.bookingSnapshot is map
          && data.bookingSnapshot.size() == 7
          && data.bookingSnapshot.serviceTypeName is string
          && data.bookingSnapshot.serviceOptionName is string
          && data.bookingSnapshot.studioId in ['room-a', 'room-b']
          && data.bookingSnapshot.bookingDate is string
          && data.bookingSnapshot.bookingDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && data.bookingSnapshot.startMinute is int
          && data.bookingSnapshot.endMinute is int
          && data.bookingSnapshot.durationMinutes is int
          && data.bookingSnapshot.durationMinutes > 0
          && data.financialSnapshot is map
          && data.financialSnapshot.size() == 3
          && data.financialSnapshot.subtotal is int
          && data.financialSnapshot.subtotal >= 0
          && data.financialSnapshot.discountAmount is int
          && data.financialSnapshot.discountAmount >= 0
          && data.financialSnapshot.discountAmount <= data.financialSnapshot.subtotal
          && data.financialSnapshot.totalAmount is int
          && data.financialSnapshot.totalAmount == data.financialSnapshot.subtotal - data.financialSnapshot.discountAmount;
      }

      function isValidInvoicePaymentMath(data) {
        let effTotal = data.get('effectiveTotalAmount', data.financialSnapshot.totalAmount);
        let overpaidBal = data.get('overpaidCreditBalance', 0);
        let netPaid = data.amountPaid - data.get('refundedTotal', 0) - data.get('creditConvertedTotal', 0);
        return data.amountPaid is int
          && data.amountPaid >= 0
          && data.get('adjustmentTotal', 0) is int
          && effTotal is int
          && effTotal >= 0
          && effTotal == data.financialSnapshot.totalAmount + data.get('adjustmentTotal', 0)
          && data.get('refundedTotal', 0) is int
          && data.get('refundedTotal', 0) >= 0
          && data.get('creditConvertedTotal', 0) is int
          && data.get('creditConvertedTotal', 0) >= 0
          && overpaidBal is int
          && overpaidBal >= 0
          && data.balanceDue is int
          && data.balanceDue >= 0
          && netPaid >= 0
          && data.balanceDue - overpaidBal == effTotal - netPaid
          && (data.balanceDue == 0 || overpaidBal == 0)
          && data.paymentStatus == (
            overpaidBal > 0
              ? 'overpaid_credit_pending'
              : (data.balanceDue == 0 ? 'paid' : (data.amountPaid > 0 ? 'partial' : 'unpaid'))
          );
      }

      function isValidInvoiceBase(data, invoiceId) {
        return data.size() >= 20
          && data.size() <= 34
          && !data.keys().hasAny(['reservationStatus', 'sessionStatus', 'commissionSnapshot'])
          && data.get('clientPaymentEvidenceRequired', false) is bool
          && data.get('clientUid', '') is string
          && data.get('targetType', 'booking') in ['booking', 'project']
          && (data.get('depositPolicySnapshot', null) == null || data.depositPolicySnapshot is map)
          && (data.get('minimumDepositAmount', 0) is int && data.get('minimumDepositAmount', 0) >= 0)
          && data.get('depositStatus', 'not_required') in ['not_required', 'awaiting_deposit', 'partial_below_minimum', 'met']
          && (data.get('balanceDuePolicy', null) == null || data.balanceDuePolicy is map)
          && data.get('adjustmentCount', 0) is int
          && data.get('adjustmentCount', 0) >= 0
          && (
            data.get('adjustmentCount', 0) == 0
              ? data.get('lastAdjustmentId', null) == null
              : (data.get('lastAdjustmentId', null) is string && data.lastAdjustmentId.matches('^adj_[a-f0-9]{24}$'))
          )
          && data.invoiceNumber is string
          && data.invoiceNumber.matches('^37MS-\\d{8}-[A-Z0-9]{12}$')
          && data.bookingId is string
          && data.bookingId.size() > 0
          && invoiceId == 'inv_' + data.bookingId
          && data.customerId is string
          && data.invoiceStatus in ['draft', 'issued', 'void']
          && data.currency == 'IDR'
          && isValidInvoiceSnapshots(data)
          && isValidInvoicePaymentMath(data)
          && data.invoiceDate is timestamp
          && (data.dueDate == null
            || (data.dueDate is string && data.dueDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))
          && (data.lastPaymentTransactionId == null
            || (data.lastPaymentTransactionId is string && data.lastPaymentTransactionId.size() > 0))
          && data.voidReason is string
          && data.voidReason.size() <= 300
          && data.createdAt is timestamp
          && data.createdByUid is string
          && data.updatedAt is timestamp
          && data.updatedByUid == request.auth.uid
          && data.version is int
          && data.version >= 1;
      }

      function isValidInvoiceMutableUpdateBase(data) {
        return data.size() >= 20
          && data.size() <= 34
          && !data.keys().hasAny(['reservationStatus', 'sessionStatus', 'commissionSnapshot'])
          && data.get('depositStatus', 'not_required') in ['not_required', 'awaiting_deposit', 'partial_below_minimum', 'met']
          && data.get('adjustmentCount', 0) is int
          && data.get('adjustmentCount', 0) >= 0
          && (
            data.get('adjustmentCount', 0) == 0
              ? data.get('lastAdjustmentId', null) == null
              : (data.get('lastAdjustmentId', null) is string && data.lastAdjustmentId.matches('^adj_[a-f0-9]{24}$'))
          )
          && data.invoiceStatus in ['draft', 'issued', 'void']
          && isValidInvoicePaymentMath(data)
          && (data.dueDate == null
            || (data.dueDate is string && data.dueDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))
          && (data.lastPaymentTransactionId == null
            || (data.lastPaymentTransactionId is string && data.lastPaymentTransactionId.size() > 0))
          && data.voidReason is string
          && data.voidReason.size() <= 300
          && data.updatedAt is timestamp
          && data.updatedByUid == request.auth.uid;
      }

      function isValidInitialInvoicePaymentLinkAfter(data, invoiceId) {
        return data.amountPaid == 0
          ? data.lastPaymentTransactionId == null
          : (
            data.lastPaymentTransactionId is string
            && data.lastPaymentTransactionId.size() > 0
            && existsAfter(/databases/$(database)/documents/paymentTransactions/$(data.lastPaymentTransactionId))
            && getAfter(/databases/$(database)/documents/paymentTransactions/$(data.lastPaymentTransactionId)).data.invoiceId == invoiceId
            && getAfter(/databases/$(database)/documents/paymentTransactions/$(data.lastPaymentTransactionId)).data.transactionType == 'payment'
            && getAfter(/databases/$(database)/documents/paymentTransactions/$(data.lastPaymentTransactionId)).data.amount == data.amountPaid
          );
      }

      function isLegacyInvoiceClientUidUpdate(reqData, resData, invoiceId) {
        let clientUid = reqData.get('clientUid', '');
        let booking = getAfter(/databases/$(database)/documents/bookings/$(resData.bookingId));
        return resData.get('clientUid', '') == ''
          && clientUid is string
          && clientUid.size() > 0
          && invoiceId == 'inv_' + reqData.bookingId
          && reqData.amountPaid == resData.amountPaid
          && reqData.balanceDue == resData.balanceDue
          && reqData.paymentStatus == resData.paymentStatus
          && reqData.lastPaymentTransactionId == resData.lastPaymentTransactionId
          && reqData.updatedByUid == request.auth.uid
          && reqData.updatedAt is timestamp
          && reqData.version == resData.version + 1
          && reqData.diff(resData).affectedKeys().hasOnly([
            'clientUid', 'updatedAt', 'updatedByUid', 'version'
          ])
          && booking != null
          && booking.data.get('clientUid', '') == clientUid;
      }

      function isInvoiceImmutableFieldsUnchanged(reqData, resData) {
        return !reqData.diff(resData).affectedKeys().hasAny([
            'invoiceNumber', 'bookingId', 'customerId', 'currency',
            'customerSnapshot', 'bookingSnapshot', 'financialSnapshot',
            'invoiceDate', 'createdAt', 'createdByUid'
          ])
          && reqData.get('clientPaymentEvidenceRequired', false) == resData.get('clientPaymentEvidenceRequired', false)
          && reqData.get('clientUid', '') == resData.get('clientUid', '')
          && reqData.get('targetType', 'booking') == resData.get('targetType', 'booking')
          && reqData.get('depositPolicySnapshot', null) == resData.get('depositPolicySnapshot', null)
          && reqData.get('minimumDepositAmount', 0) == resData.get('minimumDepositAmount', 0)
          && reqData.get('balanceDuePolicy', null) == resData.get('balanceDuePolicy', null);
      }

      function isInvoiceAdjustmentSummaryUnchanged(reqData, resData) {
        return reqData.get('adjustmentTotal', 0) == resData.get('adjustmentTotal', 0)
          && reqData.get('effectiveTotalAmount', reqData.financialSnapshot.totalAmount)
            == resData.get('effectiveTotalAmount', resData.financialSnapshot.totalAmount)
          && reqData.get('refundedTotal', 0) == resData.get('refundedTotal', 0)
          && reqData.get('creditConvertedTotal', 0) == resData.get('creditConvertedTotal', 0)
          && reqData.get('overpaidCreditBalance', 0) == resData.get('overpaidCreditBalance', 0)
          && reqData.get('lastAdjustmentId', null) == resData.get('lastAdjustmentId', null)
          && reqData.get('adjustmentCount', 0) == resData.get('adjustmentCount', 0);
      }

      function isInvoiceAggregateMatchingTxAfter(reqData, resData, invoiceId) {
        let diff = reqData.amountPaid - resData.amountPaid;
        let tx = getAfter(/databases/$(database)/documents/paymentTransactions/$(reqData.lastPaymentTransactionId));
        return diff != 0
          && (diff < 0 || diff <= resData.balanceDue)
          && tx != null
          && tx.data.invoiceId == invoiceId
          && tx.data.transactionType == (diff > 0 ? 'payment' : 'reversal')
          && tx.data.amount == (diff > 0 ? diff : -diff);
      }

      function isValidInvoicePaymentAggregateUpdate(reqData, resData, invoiceId) {
        return reqData.lastPaymentTransactionId is string
          && reqData.lastPaymentTransactionId.size() > 0
          && reqData.lastPaymentTransactionId != resData.lastPaymentTransactionId
          && isInvoiceAggregateMatchingTxAfter(reqData, resData, invoiceId);
      }

      function isInvoiceWithoutPendingEvidenceLock(invoiceId) {
        let lockPath = /databases/$(database)/documents/paymentEvidenceLocks/$(invoiceId);
        return !exists(lockPath) || get(lockPath).data.pendingCount == 0;
      }

      function isValidInvoiceVoidUpdate(reqData, resData) {
        return resData.invoiceStatus == 'issued'
          && reqData.invoiceStatus == 'void'
          && resData.amountPaid == 0
          && reqData.dueDate == resData.dueDate
          && reqData.voidReason is string
          && reqData.voidReason.size() >= 3;
      }

      function isInvoiceRestoreParentBookingValid(resData) {
        let bookingBefore = get(/databases/$(database)/documents/bookings/$(resData.bookingId));
        let bookingAfter = getAfter(/databases/$(database)/documents/bookings/$(resData.bookingId));
        return bookingBefore == null
          || (
            bookingBefore.data.get('reservationStatus', 'confirmed') in ['deposit_hold', 'expired']
            && bookingAfter != null
            && bookingAfter.data.get('reservationStatus', 'confirmed') in ['deposit_hold', 'confirmed']
            && bookingAfter.data.version == bookingBefore.data.version + 1
          );
      }

      function isValidInvoiceRestoreUnvoidUpdate(reqData, resData) {
        return reqData.invoiceStatus == 'issued'
          && resData.amountPaid == 0
          && reqData.dueDate == resData.dueDate
          && (
            (resData.invoiceStatus == 'void' && reqData.voidReason == '')
            || (resData.invoiceStatus == 'issued' && reqData.voidReason == resData.voidReason)
          )
          && isInvoiceRestoreParentBookingValid(resData);
      }

      function isValidInvoiceAdjustmentUpdate(reqData, resData, invoiceId) {
        let adjAfter = getAfter(/databases/$(database)/documents/invoices/$(invoiceId)/adjustments/$(reqData.lastAdjustmentId));
        return reqData.amountPaid == resData.amountPaid
          && reqData.get('refundedTotal', 0) == resData.get('refundedTotal', 0)
          && reqData.get('creditConvertedTotal', 0) == resData.get('creditConvertedTotal', 0)
          && reqData.lastPaymentTransactionId == resData.lastPaymentTransactionId
          && reqData.get('adjustmentCount', 0) == resData.get('adjustmentCount', 0) + 1
          && reqData.get('lastAdjustmentId', null) != resData.get('lastAdjustmentId', null)
          && adjAfter != null
          && adjAfter.data.invoiceId == invoiceId
          && reqData.get('adjustmentTotal', 0) == resData.get('adjustmentTotal', 0) + adjAfter.data.deltaAmount
          && reqData.get('effectiveTotalAmount', -1) >= 0;
      }

      match /adjustments/{adjustmentId} {
        allow get, list: if isActiveStaff()
          || (
            exists(/databases/$(database)/documents/invoices/$(invoiceId))
            && isClientReadableParentInvoiceDoc(invoiceId, {})
          );

        allow create: if isActiveStaff()
          && !isFactoryResetLocked()
          && isValidInvoiceAdjustmentCreate(request.resource.data, invoiceId, adjustmentId);

        allow update: if false;
        allow delete: if canFactoryResetDelete();

        function isValidInvoiceAdjustmentCreate(data, invoiceId, adjustmentId) {
          let invPath = /databases/$(database)/documents/invoices/$(invoiceId);
          let invBefore = get(invPath);
          let invAfter = getAfter(invPath);
          return data.keys().hasOnly([
              'schemaVersion',
              'adjustmentId',
              'invoiceId',
              'targetType',
              'targetId',
              'category',
              'deltaAmount',
              'reason',
              'linkedChangeRequestId',
              'approvedByUid',
              'clientApprovedAt',
              'createdAt',
              'createdByUid'
            ])
            && data.size() == 13
            && data.schemaVersion == 1
            && adjustmentId.matches('^adj_[a-f0-9]{24}$')
            && data.adjustmentId == adjustmentId
            && data.invoiceId == invoiceId
            && data.targetType in ['booking', 'project']
            && data.targetId is string
            && data.targetId.size() >= 1
            && data.targetId.size() <= 140
            && data.category in [
              'duration_change',
              'room_change',
              'service_change',
              'scope_addendum',
              'discount_credit',
              'cancellation_fee',
              'manual_correction'
            ]
            && data.deltaAmount is int
            && data.deltaAmount != 0
            && data.reason is string
            && data.reason.trim().size() >= 3
            && data.reason.size() <= 300
            && (data.linkedChangeRequestId == null
              || (data.linkedChangeRequestId is string && data.linkedChangeRequestId.size() >= 1 && data.linkedChangeRequestId.size() <= 140))
            && data.approvedByUid is string
            && data.approvedByUid.size() >= 1
            && data.approvedByUid.size() <= 128
            && (data.clientApprovedAt == null || data.clientApprovedAt is timestamp)
            && data.createdAt is timestamp
            && data.createdByUid == request.auth.uid
            && invBefore != null
            && invBefore.data.invoiceStatus == 'issued'
            && invAfter != null
            && invAfter.data.invoiceStatus == 'issued'
            && invAfter.data.lastAdjustmentId == adjustmentId
            && invAfter.data.get('adjustmentCount', 0) == invBefore.data.get('adjustmentCount', 0) + 1
            && invAfter.data.get('adjustmentTotal', 0) == invBefore.data.get('adjustmentTotal', 0) + data.deltaAmount
            && invAfter.data.get('effectiveTotalAmount', 0) >= 0;
        }
      }
    }

    match /paymentTransactions/{transactionId} {
      allow get: if isActiveStaff()
        || (
          resource != null
          && (
            isClientReadableParentInvoice(resource.data)
          )
        );

      allow list: if isActiveStaff()
        || isClientReadableParentInvoice(resource.data);

      allow create: if isActiveStaff()
        && !isFactoryResetLocked()
        && isValidPaymentTransactionCreate(request.resource.data, transactionId);

      allow update: if false;
      allow delete: if canFactoryResetDelete();

      function isValidReversalOriginalPayment(data) {
        return exists(/databases/$(database)/documents/paymentTransactions/$(data.reversalOfTransactionId))
          && get(/databases/$(database)/documents/paymentTransactions/$(data.reversalOfTransactionId)).data.transactionType == 'payment'
          && get(/databases/$(database)/documents/paymentTransactions/$(data.reversalOfTransactionId)).data.invoiceId == data.invoiceId
          && get(/databases/$(database)/documents/paymentTransactions/$(data.reversalOfTransactionId)).data.amount == data.amount;
      }

      function isTxInvoiceConsistentAfter(data) {
        let invAfter = getAfter(/databases/$(database)/documents/invoices/$(data.invoiceId));
        return invAfter != null
          && invAfter.data.invoiceStatus == 'issued'
          && invAfter.data.bookingId == data.bookingId
          && invAfter.data.customerId == data.customerId
          && invAfter.data.invoiceNumber == data.invoiceNumber
          && data.get('clientUid', '') == invAfter.data.get('clientUid', '');
      }

      function isValidVerifiedEvidenceTxLinkAfter(data, transactionId) {
        let evidenceId = transactionId[13:transactionId.size()];
        let evAfter = getAfter(/databases/$(database)/documents/paymentEvidence/$(evidenceId));
        let invAfter = getAfter(/databases/$(database)/documents/invoices/$(data.invoiceId));
        return transactionId.matches('^pay_evidence_[A-Za-z0-9_-]{4,120}$')
          && existsAfter(/databases/$(database)/documents/paymentEvidence/$(evidenceId))
          && evAfter != null
          && invAfter != null
          && evAfter.data.evidenceSource == 'client_portal'
          && evAfter.data.status == 'verified'
          && evAfter.data.invoiceId == data.invoiceId
          && evAfter.data.bookingId == data.bookingId
          && evAfter.data.customerId == data.customerId
          && (
            invAfter.data.get('clientUid', '') == ''
            || evAfter.data.clientUid == invAfter.data.clientUid
          )
          && evAfter.data.verifiedAmount == data.amount
          && evAfter.data.linkedTransactionId == transactionId;
      }

      function isValidPaymentTxPolicyAfter(data, transactionId) {
        let invAfter = getAfter(/databases/$(database)/documents/invoices/$(data.invoiceId));
        return invAfter != null
          && (
            invAfter.data.get('clientPaymentEvidenceRequired', false) == true
              ? (
                (data.source == 'client_evidence_verified'
                  && isValidVerifiedEvidenceTxLinkAfter(data, transactionId))
                || (data.source == 'staff_cash_desk' && data.paymentMethod == 'cash')
              )
              : (
                data.source in ['booking_initial_payment', 'manual', 'staff_cash_desk', 'legacy_initial_snapshot']
                && (data.source != 'staff_cash_desk' || data.paymentMethod == 'cash')
              )
          );
      }

      function isValidPaymentTransactionCreate(data, transactionId) {
        return (data.size() == 15 || data.size() == 16)
          && (!('clientUid' in data) || (data.clientUid is string && data.clientUid.size() <= 128))
          && data.invoiceId is string
          && data.invoiceId.size() > 0
          && data.invoiceNumber is string
          && data.invoiceNumber.matches('^37MS-\\d{8}-[A-Z0-9]{12}$')
          && data.bookingId is string
          && data.bookingId.size() > 0
          && data.customerId is string
          && data.transactionType in ['payment', 'reversal']
          && data.amount is int
          && data.amount > 0
          && data.currency == 'IDR'
          && data.paymentMethod in ['cash', 'transfer', 'qris', 'other']
          && data.receivedAt is timestamp
          && data.referenceNumber is string
          && data.referenceNumber.size() <= 120
          && data.notes is string
          && data.notes.size() <= 400
          && data.source in ['booking_initial_payment', 'manual', 'staff_cash_desk', 'legacy_initial_snapshot', 'client_evidence_verified', 'reversal']
          && data.recordedByUid == request.auth.uid
          && data.createdAt is timestamp
          && existsAfter(/databases/$(database)/documents/invoices/$(data.invoiceId))
          && isTxInvoiceConsistentAfter(data)
          && (
            data.transactionType == 'payment'
              ? (data.reversalOfTransactionId == null
                  && isValidPaymentTxPolicyAfter(data, transactionId))
              : (data.source == 'reversal'
                  && data.reversalOfTransactionId is string
                  && data.reversalOfTransactionId.size() > 0
                  && transactionId == 'pay_rev_' + data.reversalOfTransactionId
                  && data.notes.size() >= 3
                  && isValidReversalOriginalPayment(data))
          );
      }
    }

    match /paymentEvidence/{evidenceId} {
      allow get: if isActiveStaff()
        || (
          resource != null
          && isClientReadableParentInvoice(resource.data)
        );

      allow list: if isActiveStaff()
        || isClientReadableParentInvoice(resource.data);

      allow create: if !isFactoryResetLocked()
        && (
          (request.resource.data.evidenceSource == 'client_portal'
            && isValidClientEvidenceCreate(request.resource.data, evidenceId))
          || (request.resource.data.evidenceSource == 'admin_manual'
            && isActiveStaff()
            && isValidAdminAttachedEvidenceCreate(request.resource.data, evidenceId))
        );

      allow update: if isActiveStaff()
        && !isFactoryResetLocked()
        && resource != null
        && resource.data.evidenceSource == 'client_portal'
        && resource.data.status == 'pending_review'
        && isValidPaymentEvidenceBase(request.resource.data)
        && isPaymentEvidenceImmutableFieldsUnchanged(request.resource.data, resource.data)
        && request.resource.data.reviewedByUid == request.auth.uid
        && request.resource.data.reviewedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.version == resource.data.version + 1
        && (
          (request.resource.data.status == 'verified'
            && isValidStaffEvidenceVerifyUpdate(request.resource.data, evidenceId))
          || (request.resource.data.status == 'rejected'
            && isValidStaffEvidenceRejectUpdate(request.resource.data))
        );

      allow delete: if canFactoryResetDelete();

      // ------------------------------------------------------------------
      // Payment Evidence & Verification v1 Helpers
      // ------------------------------------------------------------------

      function isValidPaymentEvidenceAsset(asset) {
        return asset is map
          && asset.size() == 10
          && asset.provider == 'cloudinary'
          && asset.cloudName is string
          && asset.cloudName.matches('^[a-z0-9_-]{2,64}$')
          && asset.cloudinaryPublicId is string
          && asset.cloudinaryPublicId.trim().size() >= 1
          && asset.cloudinaryPublicId.size() <= 255
          && asset.cloudinaryAssetId is string
          && asset.cloudinaryAssetId.size() <= 120
          && asset.secureUrl is string
          && asset.secureUrl.size() <= 500
          && asset.secureUrl.matches('^https://res\\.cloudinary\\.com/' + asset.cloudName + '/image/upload/\\S+$')
          && asset.resourceType == 'image'
          && asset.format in ['jpg', 'jpeg', 'png', 'webp']
          && asset.width is int
          && asset.width >= 1
          && asset.width <= 20000
          && asset.height is int
          && asset.height >= 1
          && asset.height <= 20000
          && asset.bytes is int
          && asset.bytes >= 1
          && asset.bytes <= 5242880;
      }

      function isValidPaymentEvidenceBase(data) {
        return data.size() == 23
          && data.schemaVersion == 1
          && data.invoiceId is string
          && data.invoiceId.size() >= 1
          && data.invoiceId.size() <= 140
          && data.invoiceNumber is string
          && data.invoiceNumber.matches('^37MS-\\d{8}-[A-Z0-9]{12}$')
          && data.bookingId is string
          && data.bookingId.size() >= 1
          && data.bookingId.size() <= 140
          && data.customerId is string
          && data.customerId.size() >= 1
          && data.customerId.size() <= 140
          && data.clientUid is string
          && data.clientUid.size() <= 128
          && data.evidenceSource in ['client_portal', 'admin_manual']
          && data.status in ['pending_review', 'verified', 'rejected', 'attached']
          && data.claimedAmount is int
          && data.claimedAmount > 0
          && data.paymentMethod in ['cash', 'transfer', 'qris', 'other']
          && data.claimedPaidAt is string
          && data.claimedPaidAt.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && data.referenceNumber is string
          && data.referenceNumber.size() <= 120
          && isValidPaymentEvidenceAsset(data.evidence)
          && data.submittedByUid is string
          && data.submittedByUid.size() >= 1
          && data.submittedByUid.size() <= 128
          && data.submittedAt is timestamp
          && (data.reviewedAt == null || data.reviewedAt is timestamp)
          && data.reviewedByUid is string
          && data.reviewedByUid.size() <= 128
          && data.rejectionReason is string
          && data.rejectionReason.size() <= 300
          && (data.verifiedAmount == null || (data.verifiedAmount is int && data.verifiedAmount > 0))
          && (data.linkedTransactionId == null
            || (data.linkedTransactionId is string && data.linkedTransactionId.size() >= 1 && data.linkedTransactionId.size() <= 160))
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && data.version is int
          && data.version >= 1;
      }

      function isValidClientEvidenceParentInvoice(data) {
        let inv = get(/databases/$(database)/documents/invoices/$(data.invoiceId));
        return inv != null
          && inv.data.customerId == data.customerId
          && inv.data.bookingId == data.bookingId
          && inv.data.invoiceNumber == data.invoiceNumber
          && inv.data.invoiceStatus == 'issued'
          && inv.data.get('clientPaymentEvidenceRequired', false) == true
          && (
            inv.data.get('clientUid', '') == ''
              ? isClientOwnerOfCustomer(data.customerId)
              : (
                inv.data.clientUid == data.clientUid
                && isActiveClient()
              )
          )
          && inv.data.balanceDue is int
          && inv.data.balanceDue > 0
          && data.claimedAmount <= inv.data.balanceDue;
      }

      function isValidClientEvidenceCreate(data, evidenceId) {
        return evidenceId.matches('^[A-Za-z0-9_-]{4,120}$')
          && data.evidenceSource == 'client_portal'
          && data.status == 'pending_review'
          && data.paymentMethod in ['transfer', 'qris', 'other']
          && data.clientUid == request.auth.uid
          && data.submittedByUid == request.auth.uid
          && data.reviewedAt == null
          && data.reviewedByUid == ''
          && data.rejectionReason == ''
          && data.verifiedAmount == null
          && data.linkedTransactionId == null
          && data.submittedAt == request.time
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && data.version == 1
          && isValidPaymentEvidenceBase(data)
          && isValidClientEvidenceParentInvoice(data);
      }

      function isAdminAttachedEvidenceLinkedAfter(data) {
        let txAfter = getAfter(/databases/$(database)/documents/paymentTransactions/$(data.linkedTransactionId));
        let invAfter = getAfter(/databases/$(database)/documents/invoices/$(data.invoiceId));
        return txAfter != null
          && invAfter != null
          && txAfter.data.transactionType == 'payment'
          && txAfter.data.invoiceId == data.invoiceId
          && txAfter.data.bookingId == data.bookingId
          && txAfter.data.customerId == data.customerId
          && txAfter.data.invoiceNumber == data.invoiceNumber
          && txAfter.data.amount == data.claimedAmount
          && txAfter.data.get('clientUid', '') == data.clientUid
          && invAfter.data.invoiceStatus == 'issued'
          && invAfter.data.customerId == data.customerId
          && invAfter.data.get('clientUid', '') == data.clientUid
          && invAfter.data.bookingId == data.bookingId
          && invAfter.data.invoiceNumber == data.invoiceNumber;
      }

      function isValidAdminAttachedEvidenceCreate(data, evidenceId) {
        return evidenceId.matches('^[A-Za-z0-9_-]{4,120}$')
          && data.evidenceSource == 'admin_manual'
          && data.status == 'attached'
          && data.clientUid is string
          && data.clientUid.size() <= 128
          && data.submittedByUid == request.auth.uid
          && data.reviewedAt == null
          && data.reviewedByUid == ''
          && data.rejectionReason == ''
          && data.verifiedAmount is int
          && data.verifiedAmount == data.claimedAmount
          && data.linkedTransactionId is string
          && data.linkedTransactionId.size() >= 1
          && data.version == 1
          && isValidPaymentEvidenceBase(data)
          && existsAfter(/databases/$(database)/documents/paymentTransactions/$(data.linkedTransactionId))
          && existsAfter(/databases/$(database)/documents/invoices/$(data.invoiceId))
          && isAdminAttachedEvidenceLinkedAfter(data);
      }

      function isPaymentEvidenceImmutableFieldsUnchanged(reqData, resData) {
        return reqData.schemaVersion == resData.schemaVersion
          && reqData.invoiceId == resData.invoiceId
          && reqData.invoiceNumber == resData.invoiceNumber
          && reqData.bookingId == resData.bookingId
          && reqData.customerId == resData.customerId
          && reqData.clientUid == resData.clientUid
          && reqData.evidenceSource == resData.evidenceSource
          && reqData.claimedAmount == resData.claimedAmount
          && reqData.paymentMethod == resData.paymentMethod
          && reqData.claimedPaidAt == resData.claimedPaidAt
          && reqData.referenceNumber == resData.referenceNumber
          && reqData.evidence == resData.evidence
          && reqData.submittedByUid == resData.submittedByUid
          && reqData.submittedAt == resData.submittedAt
          && reqData.createdAt == resData.createdAt;
      }

      function isVerifiedEvidenceLinkedAfter(reqData, expectedTxId) {
        let txAfter = getAfter(/databases/$(database)/documents/paymentTransactions/$(expectedTxId));
        let invAfter = getAfter(/databases/$(database)/documents/invoices/$(reqData.invoiceId));
        return txAfter != null
          && invAfter != null
          && txAfter.data.transactionType == 'payment'
          && txAfter.data.source == 'client_evidence_verified'
          && txAfter.data.invoiceId == reqData.invoiceId
          && txAfter.data.bookingId == reqData.bookingId
          && txAfter.data.customerId == reqData.customerId
          && txAfter.data.amount == reqData.verifiedAmount
          && invAfter.data.invoiceStatus == 'issued'
          && invAfter.data.lastPaymentTransactionId == expectedTxId;
      }

      function isValidStaffEvidenceVerifyUpdate(reqData, evidenceId) {
        let expectedTxId = 'pay_evidence_' + evidenceId;
        return reqData.status == 'verified'
          && reqData.rejectionReason == ''
          && reqData.verifiedAmount is int
          && reqData.verifiedAmount > 0
          && reqData.linkedTransactionId == expectedTxId
          && existsAfter(/databases/$(database)/documents/paymentTransactions/$(expectedTxId))
          && existsAfter(/databases/$(database)/documents/invoices/$(reqData.invoiceId))
          && isVerifiedEvidenceLinkedAfter(reqData, expectedTxId);
      }

      function isValidStaffEvidenceRejectUpdate(reqData) {
        return reqData.status == 'rejected'
          && reqData.rejectionReason is string
          && reqData.rejectionReason.trim().size() >= 3
          && reqData.rejectionReason.size() <= 300
          && reqData.verifiedAmount == null
          && reqData.linkedTransactionId == null;
      }
    }

    match /paymentEvidenceLocks/{invoiceId} {
      allow get: if isActiveStaff()
        || (
          isActiveClient()
          && (
            (resource != null && resource.data.clientUid == request.auth.uid)
            || (
              exists(/databases/$(database)/documents/invoices/$(invoiceId))
              && get(/databases/$(database)/documents/invoices/$(invoiceId)).data.get('clientUid', '') == request.auth.uid
            )
          )
        );
      allow list: if isActiveStaff();
      allow create, update: if !isFactoryResetLocked()
        && isValidPaymentEvidenceLockWrite(request.resource.data, resource, invoiceId);
      allow delete: if canFactoryResetDelete();

      function isValidPaymentEvidenceLockWrite(nextData, prevRes, invoiceId) {
        let invPath = /databases/$(database)/documents/invoices/$(invoiceId);
        let invDoc = get(invPath);
        return nextData.keys().hasOnly([
            'schemaVersion', 'invoiceId', 'bookingId', 'customerId', 'clientUid',
            'pendingEvidenceIds', 'pendingCount', 'updatedAt', 'updatedByUid', 'version'
          ])
          && nextData.size() == 10
          && nextData.schemaVersion == 1
          && nextData.invoiceId == invoiceId
          && nextData.bookingId is string && nextData.bookingId.size() > 0
          && nextData.customerId is string
          && nextData.clientUid is string && nextData.clientUid.size() <= 128
          && nextData.pendingEvidenceIds is list
          && nextData.pendingCount is int
          && nextData.pendingCount == nextData.pendingEvidenceIds.size()
          && nextData.pendingCount >= 0 && nextData.pendingCount <= 50
          && nextData.updatedAt is timestamp
          && nextData.updatedByUid == request.auth.uid
          && nextData.version is int
          && nextData.version == (prevRes == null ? 1 : prevRes.data.version + 1)
          && (
            isActiveStaff()
            || (
              isActiveClient()
              && nextData.clientUid == request.auth.uid
              && nextData.pendingCount == (prevRes == null ? 1 : prevRes.data.pendingCount + 1)
              && invDoc != null
              && invDoc.data.get('clientUid', '') == request.auth.uid
              && invDoc.data.invoiceStatus == 'issued'
              && invDoc.data.get('clientPaymentEvidenceRequired', false) == true
            )
          );
      }
    }

    match /refundCases/{refundId} {
      allow get, list: if isActiveStaff()
        || (isActiveClient() && resource != null && resource.data.get('clientUid', '') == request.auth.uid);
      allow create: if isActiveStaff()
        && !isFactoryResetLocked()
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'refundId', 'targetType', 'bookingId', 'projectId', 'invoiceId',
          'customerId', 'clientUid', 'triggerCategory', 'sourcePaymentTransactionIds',
          'maxRefundableAmount', 'requestedAmount', 'approvedAmount', 'forfeitedAmount',
          'resolutionMethod', 'status', 'requestReason', 'decisionReason',
          'creditRemainingAmount', 'settlementInfo', 'reviewedByUid', 'reviewedAt',
          'createdAt', 'createdByUid', 'updatedAt', 'updatedByUid', 'version'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.refundId == refundId
        && request.resource.data.targetType == 'booking'
        && request.resource.data.triggerCategory in ['hold_expired_partial_paid', 'late_payment_expired']
        && request.resource.data.status == 'under_review'
        && request.resource.data.maxRefundableAmount is int
        && request.resource.data.maxRefundableAmount > 0
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.version == 1
        && existsAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.reservationStatus == 'expired';
      allow update: if false;
      allow delete: if canFactoryResetDelete();
    }

    match /commissionBatches/{batchId} {
      allow read: if isActiveOwner();

      allow create: if isActiveOwner()
        && !isFactoryResetLocked()
        && isValidCommissionBatchCreate(request.resource.data, batchId);

      allow update: if false;
      allow delete: if canFactoryResetDelete();

      function isValidCommissionBatchCreate(data, batchId) {
        let staffEntryId = 'bk_commission_' + batchId + '_staff';
        let operatorEntryId = 'bk_commission_' + batchId + '_operator';
        let expectedEntryCount = (data.staffCommissionTotal > 0 ? 1 : 0)
          + (data.recordingOperatorFeeTotal > 0 ? 1 : 0);
        return data.size() == 15
          && batchId is string
          && batchId.size() > 0
          && data.periodStart is string
          && data.periodStart.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && data.periodEnd is string
          && data.periodEnd.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && data.completionTimeZone == 'Asia/Jakarta'
          && data.bookingCount is int
          && data.bookingCount >= 1
          && data.bookingCount <= 100
          && data.staffCommissionTotal is int
          && data.staffCommissionTotal >= 0
          && data.recordingOperatorFeeTotal is int
          && data.recordingOperatorFeeTotal >= 0
          && data.payableTotal is int
          && data.payableTotal > 0
          && data.payableTotal == data.staffCommissionTotal + data.recordingOperatorFeeTotal
          && data.ownerAllocationReferenceTotal is int
          && data.ownerAllocationReferenceTotal >= 0
          && data.currency == 'IDR'
          && data.status == 'posted'
          && data.bookkeepingEntryIds is list
          && data.bookkeepingEntryIds.size() == expectedEntryCount
          && (data.staffCommissionTotal == 0
            || (staffEntryId in data.bookkeepingEntryIds
                && existsAfter(/databases/$(database)/documents/bookkeepingEntries/$(staffEntryId))))
          && (data.recordingOperatorFeeTotal == 0
            || (operatorEntryId in data.bookkeepingEntryIds
                && existsAfter(/databases/$(database)/documents/bookkeepingEntries/$(operatorEntryId))))
          && data.postedAt is timestamp
          && data.postedByUid == request.auth.uid
          && data.createdAt is timestamp
          && data.createdByUid == request.auth.uid;
      }
    }

    match /commissionPostingItems/{itemId} {
      allow read: if isActiveOwner();

      allow create: if isActiveOwner()
        && !isFactoryResetLocked()
        && isValidCommissionPostingItemCreate(request.resource.data, itemId);

      allow update: if false;
      allow delete: if canFactoryResetDelete();

      function isCommissionItemAmountsMatchingSnapshot(data, snap) {
        return snap is map
          && (
            snap.get('schemaVersion', 1) == 2
              ? (
                isValidBookingCommissionSnapshotV2(snap)
                && data.staffPayableAmount == snap.staff.amount
                && data.recordingOperatorPayableAmount == snap.recordingOperator.amount
                && data.ownerAllocationReference == snap.owner.amount
              )
              : (
                isValidBookingCommissionSnapshotV1(snap)
                && data.staffPayableAmount == int(snap.staffAmount)
                && data.recordingOperatorPayableAmount == int(snap.recordingOperatorAmount)
                && data.ownerAllocationReference == 0
              )
          );
      }

      function isValidCommissionPostingItemCreate(data, itemId) {
        let booking = exists(/databases/$(database)/documents/bookings/$(itemId))
          ? get(/databases/$(database)/documents/bookings/$(itemId))
          : null;
        return data.size() == 15
          && itemId is string
          && itemId.size() > 0
          && data.bookingId == itemId
          && data.batchId is string
          && data.batchId.size() > 0
          && existsAfter(/databases/$(database)/documents/commissionBatches/$(data.batchId))
          && data.customerSnapshot is map
          && data.customerSnapshot.size() == 2
          && data.customerSnapshot.name is string
          && data.customerSnapshot.name.size() > 0
          && data.customerSnapshot.bandName is string
          && data.completedAt is timestamp
          && data.serviceSnapshot is map
          && data.serviceSnapshot.size() == 3
          && data.serviceSnapshot.serviceTypeId in ['rehearsal', 'recording']
          && data.serviceSnapshot.serviceTypeName is string
          && data.serviceSnapshot.serviceOptionName is string
          && data.staffPayableAmount is int
          && data.staffPayableAmount >= 0
          && data.recordingOperatorPayableAmount is int
          && data.recordingOperatorPayableAmount >= 0
          && data.ownerAllocationReference is int
          && data.ownerAllocationReference >= 0
          && data.payableTotal is int
          && data.payableTotal > 0
          && data.payableTotal == data.staffPayableAmount + data.recordingOperatorPayableAmount
          && data.currency == 'IDR'
          && data.status == 'posted'
          && data.postedAt is timestamp
          && data.postedByUid == request.auth.uid
          && data.createdAt is timestamp
          && booking != null
          && booking.data.sessionStatus == 'completed'
          && booking.data.get('deliveryMode', 'studio') == 'studio'
          && booking.data.get('serviceTypeId', booking.data.serviceId) in ['rehearsal', 'recording']
          && booking.data.actualCompletedAt is timestamp
          && data.completedAt == booking.data.actualCompletedAt
          && booking.data.commissionSnapshot is map
          && data.commissionSnapshot == booking.data.commissionSnapshot
          && isCommissionItemAmountsMatchingSnapshot(data, booking.data.commissionSnapshot);
      }
    }

    match /bookkeepingEntries/{entryId} {
      allow read: if isActiveOwner();

      allow create: if isActiveOwner()
        && !isFactoryResetLocked()
        && (
          isValidCommissionBookkeepingEntryCreate(request.resource.data, entryId)
          || isValidManualIncomeBookkeepingEntryCreate(request.resource.data, entryId)
          || isValidManualExpenseBookkeepingEntryCreate(request.resource.data, entryId)
          || isValidManualReversalBookkeepingEntryCreate(request.resource.data, entryId)
        );

      allow update: if isActiveOwner()
        && !isFactoryResetLocked()
        && isBookkeepingImmutableFieldsUnchanged(request.resource.data, resource.data)
        && (
          isValidBookkeepingSettlementAggregateUpdate(request.resource.data, resource.data, entryId)
          || isValidManualBookkeepingReversalMarkUpdate(request.resource.data, resource.data, entryId)
        );

      allow delete: if canFactoryResetDelete();

      function isValidCommissionBookkeepingEntryCreate(data, entryId) {
        let staffExpectedId = 'bk_commission_' + data.sourceId + '_staff';
        let operatorExpectedId = 'bk_commission_' + data.sourceId + '_operator';
        let batchAfter = getAfter(/databases/$(database)/documents/commissionBatches/$(data.sourceId));
        return data.size() == 13
          && data.sourceModule == 'commission-and-fee'
          && data.sourceType == 'commission_batch'
          && data.sourceId is string
          && data.sourceId.size() > 0
          && data.entryType == 'expense_accrual'
          && data.category in ['staff_commission', 'recording_operator_fee']
          && data.description is string
          && data.description.size() >= 3
          && data.description.size() <= 200
          && data.amount is int
          && data.amount > 0
          && data.currency == 'IDR'
          && data.settlementStatus == 'unpaid'
          && data.occurredAt is timestamp
          && data.postedAt is timestamp
          && data.createdAt is timestamp
          && data.createdByUid == request.auth.uid
          && existsAfter(/databases/$(database)/documents/commissionBatches/$(data.sourceId))
          && batchAfter != null
          && (
            (data.category == 'staff_commission'
              && entryId == staffExpectedId
              && data.amount == batchAfter.data.staffCommissionTotal)
            || (data.category == 'recording_operator_fee'
                && entryId == operatorExpectedId
                && data.amount == batchAfter.data.recordingOperatorFeeTotal)
          );
      }

      function isValidBookkeepingManualIncomeCategory(category) {
        return category in [
          'other_studio_service',
          'equipment_rental',
          'merchandise',
          'other_income'
        ];
      }

      function isValidBookkeepingManualExpenseCategory(category) {
        return category in [
          'utilities',
          'internet_communication',
          'cleaning_housekeeping',
          'equipment_maintenance',
          'equipment_purchase',
          'studio_supplies',
          'transportation',
          'rent_facilities',
          'other_operational_expense'
        ];
      }

      function isValidManualIncomeBookkeepingEntryCreate(data, entryId) {
        return data.size() == 16
          && data.keys().hasOnly([
            'sourceModule',
            'sourceType',
            'sourceId',
            'entryType',
            'category',
            'description',
            'amount',
            'currency',
            'settlementStatus',
            'paymentMethod',
            'referenceNumber',
            'notes',
            'occurredAt',
            'createdAt',
            'createdByUid',
            'version'
          ])
          && data.sourceModule == 'bookkeeping'
          && data.sourceType == 'manual'
          && data.sourceId == entryId
          && data.entryType == 'income'
          && isValidBookkeepingManualIncomeCategory(data.category)
          && data.description is string
          && data.description.size() >= 2
          && data.description.size() <= 240
          && data.amount is int
          && data.amount > 0
          && data.currency == 'IDR'
          && data.settlementStatus == 'paid'
          && isValidBookkeepingPaymentMethod(data.paymentMethod)
          && data.referenceNumber is string
          && data.referenceNumber.size() <= 120
          && data.notes is string
          && data.notes.size() <= 400
          && data.occurredAt is timestamp
          && data.createdAt is timestamp
          && data.createdByUid == request.auth.uid
          && data.version == 1;
      }

      function isValidManualExpenseBookkeepingEntryCreate(data, entryId) {
        let paidSettlement = data.paidOnCreate == true && data.lastSettlementId is string && data.lastSettlementId.size() > 0
          ? getAfter(/databases/$(database)/documents/bookkeepingSettlements/$(data.lastSettlementId))
          : null;
        return data.size() == 24
          && data.keys().hasOnly([
            'sourceModule',
            'sourceType',
            'sourceId',
            'entryType',
            'category',
            'description',
            'amount',
            'currency',
            'settlementStatus',
            'amountSettled',
            'remainingAmount',
            'paidOnCreate',
            'dueDate',
            'paymentMethod',
            'referenceNumber',
            'notes',
            'lastSettlementId',
            'lastSettledAt',
            'occurredAt',
            'createdAt',
            'createdByUid',
            'updatedAt',
            'updatedByUid',
            'version'
          ])
          && data.sourceModule == 'bookkeeping'
          && data.sourceType == 'manual'
          && data.sourceId == entryId
          && data.entryType == 'expense_accrual'
          && isValidBookkeepingManualExpenseCategory(data.category)
          && data.description is string
          && data.description.size() >= 2
          && data.description.size() <= 240
          && data.amount is int
          && data.amount > 0
          && data.currency == 'IDR'
          && (data.dueDate == null || (data.dueDate is string && data.dueDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))
          && data.referenceNumber is string
          && data.referenceNumber.size() <= 120
          && data.notes is string
          && data.notes.size() <= 400
          && data.occurredAt is timestamp
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && data.createdByUid == request.auth.uid
          && data.updatedByUid == request.auth.uid
          && data.version == 1
          && data.paidOnCreate is bool
          && (
            data.paidOnCreate == true
              ? (
                data.settlementStatus == 'paid'
                && data.amountSettled == data.amount
                && data.remainingAmount == 0
                && data.dueDate == null
                && isValidBookkeepingPaymentMethod(data.paymentMethod)
                && data.lastSettlementId is string
                && data.lastSettlementId.size() > 0
                && data.lastSettledAt is timestamp
                && existsAfter(/databases/$(database)/documents/bookkeepingSettlements/$(data.lastSettlementId))
                && paidSettlement != null
                && paidSettlement.data.entryId == entryId
                && paidSettlement.data.amount == data.amount
              )
              : (
                data.settlementStatus == 'unpaid'
                && data.amountSettled == 0
                && data.remainingAmount == data.amount
                && data.paymentMethod == ''
                && data.lastSettlementId == null
                && data.lastSettledAt == null
              )
          );
      }

      function isValidManualReversalBookkeepingEntryCreate(data, entryId) {
        let orig = exists(/databases/$(database)/documents/bookkeepingEntries/$(data.reversalOfEntryId))
          ? get(/databases/$(database)/documents/bookkeepingEntries/$(data.reversalOfEntryId))
          : null;
        let origAfter = existsAfter(/databases/$(database)/documents/bookkeepingEntries/$(data.reversalOfEntryId))
          ? getAfter(/databases/$(database)/documents/bookkeepingEntries/$(data.reversalOfEntryId))
          : null;
        return data.size() == 16
          && data.keys().hasOnly([
            'sourceModule',
            'sourceType',
            'sourceId',
            'entryType',
            'reversalOfEntryId',
            'originalEntryType',
            'category',
            'description',
            'amount',
            'currency',
            'settlementStatus',
            'notes',
            'occurredAt',
            'createdAt',
            'createdByUid',
            'version'
          ])
          && data.sourceModule == 'bookkeeping'
          && data.sourceType == 'manual_reversal'
          && data.entryType == 'reversal'
          && data.reversalOfEntryId is string
          && data.reversalOfEntryId.size() > 0
          && entryId == 'bk_rev_' + data.reversalOfEntryId
          && data.sourceId == data.reversalOfEntryId
          && data.originalEntryType in ['income', 'expense_accrual']
          && data.description is string
          && data.description.size() >= 3
          && data.description.size() <= 280
          && data.amount is int
          && data.amount > 0
          && data.currency == 'IDR'
          && data.settlementStatus == 'reversed'
          && data.notes is string
          && data.notes.size() >= 3
          && data.notes.size() <= 300
          && data.occurredAt is timestamp
          && data.createdAt is timestamp
          && data.createdByUid == request.auth.uid
          && data.version == 1
          && orig != null
          && orig.data.sourceModule == 'bookkeeping'
          && orig.data.sourceType == 'manual'
          && orig.data.entryType == data.originalEntryType
          && orig.data.category == data.category
          && orig.data.amount == data.amount
          && orig.data.settlementStatus != 'reversed'
          && (orig.data.entryType == 'income' || (orig.data.get('amountSettled', 0) == 0 && orig.data.settlementStatus == 'unpaid'))
          && origAfter != null
          && origAfter.data.settlementStatus == 'reversed'
          && origAfter.data.reversedByEntryId == entryId;
      }

      function isBookkeepingImmutableFieldsUnchanged(reqData, resData) {
        return reqData.sourceModule == resData.sourceModule
          && reqData.sourceType == resData.sourceType
          && reqData.sourceId == resData.sourceId
          && reqData.entryType == resData.entryType
          && reqData.category == resData.category
          && reqData.description == resData.description
          && reqData.amount == resData.amount
          && reqData.currency == resData.currency
          && reqData.occurredAt == resData.occurredAt
          && reqData.createdAt == resData.createdAt
          && reqData.createdByUid == resData.createdByUid
          && reqData.get('postedAt', null) == resData.get('postedAt', null)
          && reqData.updatedAt is timestamp
          && reqData.updatedByUid == request.auth.uid
          && reqData.version == resData.get('version', 1) + 1;
      }

      function isValidBookkeepingSettlementAggregateUpdate(reqData, resData, entryId) {
        let prevSettled = resData.get('amountSettled', 0);
        let prevRemaining = resData.get('remainingAmount', resData.amount);
        let settleAfter = reqData.lastSettlementId is string && reqData.lastSettlementId.size() > 0
          ? getAfter(/databases/$(database)/documents/bookkeepingSettlements/$(reqData.lastSettlementId))
          : null;
        return resData.entryType == 'expense_accrual'
          && resData.settlementStatus in ['unpaid', 'partially_paid']
          && prevRemaining > 0
          && reqData.diff(resData).affectedKeys().hasOnly([
            'amountSettled',
            'remainingAmount',
            'settlementStatus',
            'lastSettlementId',
            'lastSettledAt',
            'updatedAt',
            'updatedByUid',
            'version'
          ])
          && reqData.lastSettlementId is string
          && reqData.lastSettlementId.size() > 0
          && reqData.lastSettlementId != resData.get('lastSettlementId', '')
          && reqData.lastSettledAt is timestamp
          && existsAfter(/databases/$(database)/documents/bookkeepingSettlements/$(reqData.lastSettlementId))
          && settleAfter != null
          && settleAfter.data.entryId == entryId
          && settleAfter.data.amount > 0
          && reqData.amountSettled is int
          && reqData.amountSettled == prevSettled + settleAfter.data.amount
          && reqData.remainingAmount is int
          && reqData.remainingAmount == resData.amount - reqData.amountSettled
          && reqData.remainingAmount >= 0
          && reqData.settlementStatus == (reqData.remainingAmount == 0 ? 'paid' : 'partially_paid');
      }

      function isValidManualBookkeepingReversalMarkUpdate(reqData, resData, entryId) {
        return resData.sourceModule == 'bookkeeping'
          && resData.sourceType == 'manual'
          && resData.settlementStatus != 'reversed'
          && (resData.entryType == 'income' || (resData.get('amountSettled', 0) == 0 && resData.settlementStatus == 'unpaid'))
          && reqData.diff(resData).affectedKeys().hasOnly([
            'settlementStatus',
            'reversedByEntryId',
            'reversalReason',
            'reversedAt',
            'reversedByUid',
            'updatedAt',
            'updatedByUid',
            'version',
            'remainingAmount'
          ])
          && reqData.settlementStatus == 'reversed'
          && reqData.reversedByEntryId == 'bk_rev_' + entryId
          && reqData.reversalReason is string
          && reqData.reversalReason.size() >= 3
          && reqData.reversalReason.size() <= 300
          && reqData.reversedAt is timestamp
          && reqData.reversedByUid == request.auth.uid
          && (resData.entryType != 'expense_accrual' || reqData.remainingAmount == 0)
          && existsAfter(/databases/$(database)/documents/bookkeepingEntries/$(reqData.reversedByEntryId));
      }
    }

    match /bookkeepingSettlements/{settlementId} {
      allow read: if isActiveOwner();

      allow create: if isActiveOwner()
        && !isFactoryResetLocked()
        && isValidBookkeepingSettlementCreate(request.resource.data, settlementId);

      allow update: if false;
      allow delete: if canFactoryResetDelete();

      function isValidBookkeepingSettlementCreate(data, settlementId) {
        let prevEntry = exists(/databases/$(database)/documents/bookkeepingEntries/$(data.entryId))
          ? get(/databases/$(database)/documents/bookkeepingEntries/$(data.entryId))
          : null;
        let entryAfter = getAfter(/databases/$(database)/documents/bookkeepingEntries/$(data.entryId));
        return data.size() == 14
          && data.keys().hasOnly([
            'entryId',
            'sourceModule',
            'sourceType',
            'sourceId',
            'settlementType',
            'amount',
            'currency',
            'paymentMethod',
            'paidAt',
            'referenceNumber',
            'notes',
            'operationId',
            'createdAt',
            'createdByUid'
          ])
          && data.entryId is string
          && data.entryId.size() > 0
          && data.sourceModule == 'bookkeeping'
          && data.sourceType in ['manual', 'commission_batch']
          && data.sourceId is string
          && data.sourceId.size() > 0
          && data.settlementType == 'expense_payment'
          && data.amount is int
          && data.amount > 0
          && data.currency == 'IDR'
          && isValidBookkeepingPaymentMethod(data.paymentMethod)
          && data.paidAt is timestamp
          && data.referenceNumber is string
          && data.referenceNumber.size() <= 120
          && data.notes is string
          && data.notes.size() <= 400
          && data.operationId == settlementId
          && data.createdAt is timestamp
          && data.createdByUid == request.auth.uid
          && existsAfter(/databases/$(database)/documents/bookkeepingEntries/$(data.entryId))
          && entryAfter != null
          && entryAfter.data.entryType == 'expense_accrual'
          && entryAfter.data.sourceType == data.sourceType
          && entryAfter.data.sourceId == data.sourceId
          && entryAfter.data.lastSettlementId == settlementId
          && entryAfter.data.settlementStatus != 'reversed'
          && (
            prevEntry == null
              ? (
                entryAfter.data.sourceModule == 'bookkeeping'
                && entryAfter.data.paidOnCreate == true
                && entryAfter.data.amount == data.amount
              )
              : (
                entryAfter.data.version == prevEntry.data.get('version', 1) + 1
                && data.amount <= prevEntry.data.get('remainingAmount', prevEntry.data.amount)
              )
          );
      }
    }

    match /bookkeepingSettings/{docId} {
      allow read: if isActiveOwner();

      allow create, update: if isActiveOwner()
        && docId == 'default'
        && isValidBookkeepingSettingsWrite(request.resource.data);

      allow delete: if false;

      function isValidBookkeepingSettingsWrite(data) {
        return data.size() == 5
          && data.keys().hasOnly([
            'openingCashBalance',
            'openingBalanceAsOf',
            'openingBalanceNote',
            'updatedAt',
            'updatedByUid'
          ])
          && (data.openingCashBalance == null || (data.openingCashBalance is int && data.openingCashBalance >= 0))
          && (data.openingBalanceAsOf == null || (data.openingBalanceAsOf is string && data.openingBalanceAsOf.matches('^\\d{4}-\\d{2}-\\d{2}$')))
          && data.openingBalanceNote is string
          && data.openingBalanceNote.size() <= 200
          && data.updatedAt is timestamp
          && data.updatedByUid == request.auth.uid;
      }
    }

    match /commissionReviewResolutions/{resolutionId} {
      allow read: if isActiveOwner();

      allow create: if isActiveOwner()
        && !isFactoryResetLocked()
        && isValidCommissionReviewResolutionCreate(request.resource.data, resolutionId);

      allow update: if false;
      allow delete: if canFactoryResetDelete();

      function isValidCommissionReviewResolutionCreate(data, resolutionId) {
        let booking = exists(/databases/$(database)/documents/bookings/$(resolutionId))
          ? get(/databases/$(database)/documents/bookings/$(resolutionId))
          : null;
        return data.size() == 9
          && resolutionId is string
          && resolutionId.size() > 0
          && data.bookingId == resolutionId
          && data.status == 'dismissed_no_commission'
          && data.reason is string
          && data.reason.size() >= 3
          && data.reason.size() <= 300
          && data.snapshotIssue is string
          && data.snapshotIssue.size() <= 200
          && data.customerSnapshot is map
          && data.customerSnapshot.size() == 2
          && data.customerSnapshot.name is string
          && data.customerSnapshot.name.size() > 0
          && data.customerSnapshot.bandName is string
          && data.completedAt is timestamp
          && data.resolvedAt is timestamp
          && data.resolvedByUid == request.auth.uid
          && data.createdAt is timestamp
          && booking != null
          && booking.data.sessionStatus == 'completed'
          && booking.data.actualCompletedAt is timestamp
          && data.completedAt == booking.data.actualCompletedAt;
      }
    }

    match /inventoryItems/{itemId} {
      allow read: if isActiveStaff();

      allow create: if isActiveStaff()
        && !isFactoryResetLocked()
        && isValidInventoryItemShape(request.resource.data)
        && request.resource.data.isActive == true
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.version == 1
        && isValidInventoryInitialLink(request.resource.data, itemId);

      allow update: if isActiveStaff()
        && !isFactoryResetLocked()
        && isValidInventoryItemShape(request.resource.data)
        && request.resource.data.itemType == resource.data.itemType
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.version == resource.data.version + 1
        && (
          isValidInventoryMetadataUpdate(request.resource.data, resource.data)
          || isValidInventoryArchiveOrReactivateUpdate(request.resource.data, resource.data)
          || isValidInventoryMovementLinkedUpdate(request.resource.data, resource.data, itemId)
        );

      allow delete: if canFactoryResetDelete();

      function isValidInventoryCategory(catId) {
        return catId in [
          'instruments',
          'audio_recording',
          'amplifiers_speakers',
          'cables_connectivity',
          'stands_accessories',
          'maintenance_cleaning',
          'other'
        ];
      }

      function isValidInventoryUnit(unit) {
        return unit in [
          'pcs',
          'unit',
          'set',
          'pair',
          'pack',
          'box',
          'bottle',
          'meter',
          'roll',
          'liter',
          'other'
        ];
      }

      function isZeroInventoryItemStock(data) {
        return data.itemType == 'consumable'
          ? data.consumableStock.onHandQuantity == 0
          : (
            data.equipmentStock.availableQuantity == 0
            && data.equipmentStock.maintenanceQuantity == 0
            && data.equipmentStock.damagedQuantity == 0
            && data.equipmentStock.retiredQuantity == 0
          );
      }

      function isValidInventoryItemFlags(data) {
        return data.itemType == 'consumable'
          ? (
            data.lowStock == (data.isActive && data.consumableStock.onHandQuantity <= data.minimumStockQuantity)
            && data.inMaintenance == false
            && data.hasDamagedOrRetired == false
          )
          : (
            data.lowStock == false
            && data.inMaintenance == (data.isActive && data.equipmentStock.maintenanceQuantity > 0)
            && data.hasDamagedOrRetired == (
              data.isActive
              && (data.equipmentStock.damagedQuantity > 0 || data.equipmentStock.retiredQuantity > 0)
            )
          );
      }

      function isValidInventoryItemShape(data) {
        return data.size() == 32
          && data.itemCode is string
          && data.itemCode.size() >= 2
          && data.itemCode.size() <= 32
          && data.normalizedCode is string
          && data.normalizedCode.size() >= 2
          && data.normalizedCode.size() <= 32
          && data.name is string
          && data.name.size() >= 2
          && data.name.size() <= 120
          && data.normalizedName is string
          && data.normalizedName.size() >= 2
          && data.normalizedName.size() <= 120
          && data.itemType in ['consumable', 'equipment']
          && isValidInventoryCategory(data.categoryId)
          && data.categoryLabel is string
          && data.categoryLabel.size() >= 1
          && data.categoryLabel.size() <= 80
          && isValidInventoryUnit(data.unit)
          && data.customUnitLabel is string
          && data.customUnitLabel.size() <= 40
          && data.locationId in ['room-a', 'room-b', 'storage', 'other']
          && data.locationLabel is string
          && data.locationLabel.size() >= 1
          && data.locationLabel.size() <= 60
          && data.brand is string
          && data.brand.size() <= 80
          && data.model is string
          && data.model.size() <= 80
          && data.notes is string
          && data.notes.size() <= 1000
          && data.minimumStockQuantity is number
          && data.minimumStockQuantity >= 0
          && data.minimumAvailableQuantity is int
          && data.minimumAvailableQuantity >= 0
          && data.lowStock is bool
          && data.inMaintenance is bool
          && data.hasDamagedOrRetired is bool
          && (
            data.itemType == 'consumable'
              ? (isValidConsumableStockMap(data.consumableStock)
                  && data.equipmentStock == null
                  && data.minimumAvailableQuantity == 0
                  && data.lastMaintenanceDate == null
                  && data.nextMaintenanceDate == null
                  && data.maintenanceIntervalDays == null)
              : (data.consumableStock == null
                  && isValidEquipmentStockMap(data.equipmentStock)
                  && data.minimumStockQuantity == 0
                  && (data.lastMaintenanceDate == null
                    || (data.lastMaintenanceDate is string && data.lastMaintenanceDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))
                  && (data.nextMaintenanceDate == null
                    || (data.nextMaintenanceDate is string && data.nextMaintenanceDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))
                  && (data.maintenanceIntervalDays == null
                    || (data.maintenanceIntervalDays is int && data.maintenanceIntervalDays >= 1 && data.maintenanceIntervalDays <= 3650)))
          )
          && isValidInventoryItemFlags(data)
          && data.isActive is bool
          && (data.lastMovementId == null || (data.lastMovementId is string && data.lastMovementId.size() > 0))
          && (data.lastMovementAt == null || data.lastMovementAt is timestamp)
          && data.createdAt is timestamp
          && data.createdByUid is string
          && data.updatedAt is timestamp
          && data.updatedByUid == request.auth.uid
          && data.version is int
          && data.version >= 1;
      }

      function isValidInventoryInitialLink(data, itemId) {
        return isZeroInventoryItemStock(data)
          ? (data.lastMovementId == null && data.lastMovementAt == null)
          : (
            data.lastMovementId is string
            && data.lastMovementId.size() > 0
            && data.lastMovementAt is timestamp
            && existsAfter(/databases/$(database)/documents/inventoryMovements/$(data.lastMovementId))
            && getAfter(/databases/$(database)/documents/inventoryMovements/$(data.lastMovementId)).data.itemId == itemId
            && getAfter(/databases/$(database)/documents/inventoryMovements/$(data.lastMovementId)).data.movementType == 'opening_stock'
            && getAfter(/databases/$(database)/documents/inventoryMovements/$(data.lastMovementId)).data.balanceAfter == (
              data.itemType == 'consumable' ? data.consumableStock : data.equipmentStock
            )
          );
      }

      function isInventoryStockUnchanged(reqData, resData) {
        return reqData.consumableStock == resData.consumableStock
          && reqData.equipmentStock == resData.equipmentStock
          && reqData.lastMovementId == resData.lastMovementId
          && reqData.lastMovementAt == resData.lastMovementAt;
      }

      function isInventoryMetadataUnchanged(reqData, resData) {
        return reqData.itemCode == resData.itemCode
          && reqData.normalizedCode == resData.normalizedCode
          && reqData.name == resData.name
          && reqData.normalizedName == resData.normalizedName
          && reqData.categoryId == resData.categoryId
          && reqData.categoryLabel == resData.categoryLabel
          && reqData.unit == resData.unit
          && reqData.customUnitLabel == resData.customUnitLabel
          && reqData.locationId == resData.locationId
          && reqData.locationLabel == resData.locationLabel
          && reqData.brand == resData.brand
          && reqData.model == resData.model
          && reqData.notes == resData.notes
          && reqData.minimumStockQuantity == resData.minimumStockQuantity
          && reqData.minimumAvailableQuantity == resData.minimumAvailableQuantity
          && reqData.lastMaintenanceDate == resData.lastMaintenanceDate
          && reqData.nextMaintenanceDate == resData.nextMaintenanceDate
          && reqData.maintenanceIntervalDays == resData.maintenanceIntervalDays;
      }

      function isInventoryCanArchive(resData) {
        return resData.itemType == 'consumable'
          ? resData.consumableStock.onHandQuantity == 0
          : (
            resData.equipmentStock.availableQuantity == 0
            && resData.equipmentStock.maintenanceQuantity == 0
            && resData.equipmentStock.damagedQuantity == 0
          );
      }

      function isValidInventoryMetadataUpdate(reqData, resData) {
        let locUnchanged = reqData.locationId == resData.locationId && reqData.locationLabel == resData.locationLabel;
        return resData.isActive == true
          && reqData.isActive == true
          && isInventoryStockUnchanged(reqData, resData)
          && (locUnchanged || resData.lastMovementId == null);
      }

      function isValidInventoryArchiveOrReactivateUpdate(reqData, resData) {
        return isInventoryStockUnchanged(reqData, resData)
          && isInventoryMetadataUnchanged(reqData, resData)
          && (
            (resData.isActive == true && reqData.isActive == false && isInventoryCanArchive(resData))
            || (resData.isActive == false && reqData.isActive == true && isActiveOwner())
          );
      }

      function isValidInventoryMovementLinkedDetails(reqData, resData, itemId) {
        let movAfter = getAfter(/databases/$(database)/documents/inventoryMovements/$(reqData.lastMovementId));
        return movAfter != null
          && movAfter.data.itemId == itemId
          && movAfter.data.itemType == resData.itemType
          && movAfter.data.balanceBefore == (
            resData.itemType == 'consumable' ? resData.consumableStock : resData.equipmentStock
          )
          && movAfter.data.balanceAfter == (
            reqData.itemType == 'consumable' ? reqData.consumableStock : reqData.equipmentStock
          )
          && (
            movAfter.data.movementType == 'location_changed'
              ? (movAfter.data.locationAfter is map
                  && reqData.locationId == movAfter.data.locationAfter.locationId
                  && reqData.locationLabel == movAfter.data.locationAfter.locationLabel)
              : (reqData.locationId == resData.locationId
                  && reqData.locationLabel == resData.locationLabel
                  && reqData.itemCode == resData.itemCode
                  && reqData.name == resData.name
                  && reqData.categoryId == resData.categoryId
                  && reqData.unit == resData.unit
                  && reqData.minimumStockQuantity == resData.minimumStockQuantity
                  && reqData.minimumAvailableQuantity == resData.minimumAvailableQuantity)
          );
      }

      function isValidInventoryMovementLinkedUpdate(reqData, resData, itemId) {
        return resData.isActive == true
          && reqData.isActive == true
          && reqData.lastMovementId is string
          && reqData.lastMovementId.size() > 0
          && reqData.lastMovementId != resData.lastMovementId
          && reqData.lastMovementAt is timestamp
          && existsAfter(/databases/$(database)/documents/inventoryMovements/$(reqData.lastMovementId))
          && isValidInventoryMovementLinkedDetails(reqData, resData, itemId);
      }
    }

    match /inventoryMovements/{movementId} {
      allow read: if isActiveStaff();

      allow create: if isActiveStaff()
        && !isFactoryResetLocked()
        && isValidInventoryMovementCreate(request.resource.data, movementId);

      allow update: if false;
      allow delete: if canFactoryResetDelete();

      function isValidInventoryMovementType(movementType, itemType) {
        return movementType == 'opening_stock'
          || movementType == 'stock_in'
          || movementType == 'stock_adjustment'
          || movementType == 'location_changed'
          || (itemType == 'consumable' && movementType in ['consume', 'write_off'])
          || (itemType == 'equipment' && movementType in [
            'send_to_maintenance',
            'return_from_maintenance',
            'mark_damaged',
            'mark_repaired',
            'mark_retired'
          ]);
      }

      function isValidInventoryLocationSnapshot(loc) {
        return loc == null
          || (loc is map
              && loc.size() == 2
              && loc.locationId in ['room-a', 'room-b', 'storage', 'other']
              && loc.locationLabel is string
              && loc.locationLabel.size() >= 1
              && loc.locationLabel.size() <= 60);
      }

      function isValidInventoryMovementItemAfterLink(data, movementId) {
        let itemAfter = getAfter(/databases/$(database)/documents/inventoryItems/$(data.itemId));
        return itemAfter != null
          && itemAfter.data.isActive == true
          && itemAfter.data.itemType == data.itemType
          && itemAfter.data.lastMovementId == movementId
          && data.balanceAfter == (
            data.itemType == 'consumable' ? itemAfter.data.consumableStock : itemAfter.data.equipmentStock
          )
          && (
            data.movementType == 'opening_stock'
              ? (
                !exists(/databases/$(database)/documents/inventoryItems/$(data.itemId))
                && (data.itemType == 'consumable'
                  ? data.balanceBefore.onHandQuantity == 0
                  : (data.balanceBefore.availableQuantity == 0
                      && data.balanceBefore.maintenanceQuantity == 0
                      && data.balanceBefore.damagedQuantity == 0
                      && data.balanceBefore.retiredQuantity == 0))
              )
              : (
                exists(/databases/$(database)/documents/inventoryItems/$(data.itemId))
                && get(/databases/$(database)/documents/inventoryItems/$(data.itemId)).data.isActive == true
                && itemAfter.data.version == get(/databases/$(database)/documents/inventoryItems/$(data.itemId)).data.version + 1
                && data.balanceBefore == (
                  data.itemType == 'consumable'
                    ? get(/databases/$(database)/documents/inventoryItems/$(data.itemId)).data.consumableStock
                    : get(/databases/$(database)/documents/inventoryItems/$(data.itemId)).data.equipmentStock
                )
              )
          );
      }

      function isValidInventoryMovementCreate(data, movementId) {
        return data.size() == 19
          && data.itemId is string
          && data.itemId.size() > 0
          && data.itemCode is string
          && data.itemCode.size() >= 2
          && data.itemCode.size() <= 32
          && data.itemNameSnapshot is string
          && data.itemNameSnapshot.size() >= 2
          && data.itemNameSnapshot.size() <= 120
          && data.itemType in ['consumable', 'equipment']
          && isValidInventoryMovementType(data.movementType, data.itemType)
          && (data.movementType != 'stock_adjustment' || isActiveOwner())
          && data.quantity is number
          && (data.movementType == 'location_changed' ? data.quantity == 0 : data.quantity > 0)
          && (data.itemType == 'consumable' || data.quantity is int)
          && data.unit is string
          && data.unit.size() >= 1
          && data.unit.size() <= 40
          && (
            data.itemType == 'consumable'
              ? (isValidConsumableStockMap(data.balanceBefore) && isValidConsumableStockMap(data.balanceAfter))
              : (isValidEquipmentStockMap(data.balanceBefore) && isValidEquipmentStockMap(data.balanceAfter))
          )
          && isValidInventoryLocationSnapshot(data.locationBefore)
          && isValidInventoryLocationSnapshot(data.locationAfter)
          && data.reason is string
          && data.reason.size() <= 160
          && data.notes is string
          && data.notes.size() <= 500
          && data.source in ['opening_stock', 'manual', 'stock_adjustment', 'location_change']
          && data.occurredAt is timestamp
          && data.operationId == movementId
          && data.recordedByUid == request.auth.uid
          && data.recordedByNameSnapshot is string
          && data.recordedByNameSnapshot.size() <= 120
          && data.createdAt is timestamp
          && (data.movementType != 'stock_adjustment'
              || (data.reason.size() >= 3 && data.balanceAfter != data.balanceBefore))
          && (data.movementType != 'location_changed'
              || (data.locationBefore is map && data.locationAfter is map && data.balanceAfter == data.balanceBefore))
          && existsAfter(/databases/$(database)/documents/inventoryItems/$(data.itemId))
          && isValidInventoryMovementItemAfterLink(data, movementId);
      }
    }

    match /galleryItems/{galleryItemId} {
      allow get: if (resource != null && resource.data.status == 'published')
        || isActiveOwner();

      allow list: if resource.data.status == 'published'
        || isActiveOwner();

      allow create: if isActiveOwner()
        && isValidGalleryItemCreate(request.resource.data);

      allow update: if isActiveOwner()
        && isValidGalleryItemUpdate(request.resource.data, resource.data);

      allow delete: if false;

      function isValidGalleryItemShape(data) {
        return data.keys().hasOnly([
            'schemaVersion',
            'title',
            'category',
            'altText',
            'caption',
            'cloudinaryPublicId',
            'cloudinaryAssetId',
            'secureUrl',
            'resourceType',
            'format',
            'width',
            'height',
            'bytes',
            'status',
            'sortOrder',
            'uploadedAt',
            'uploadedByUid',
            'createdAt',
            'createdByUid',
            'updatedAt',
            'updatedByUid',
            'version'
          ])
          && data.size() == 22
          && data.schemaVersion == 1
          && data.title is string
          && data.title.trim().size() >= 2
          && data.title.trim().size() <= 120
          && data.category is string
          && data.category.trim().size() >= 2
          && data.category.trim().size() <= 60
          && data.altText is string
          && data.altText.size() <= 220
          && data.caption is string
          && data.caption.size() <= 400
          && data.cloudinaryPublicId is string
          && data.cloudinaryPublicId.trim().size() >= 1
          && data.cloudinaryPublicId.size() <= 240
          && data.cloudinaryAssetId is string
          && data.cloudinaryAssetId.trim().size() >= 1
          && data.cloudinaryAssetId.size() <= 120
          && data.secureUrl is string
          && data.secureUrl.size() <= 600
          && data.secureUrl.matches('^https://res\\.cloudinary\\.com/[a-zA-Z0-9_-]+/image/upload/[^\\s]+$')
          && data.resourceType == 'image'
          && data.format is string
          && data.format in ['jpg', 'jpeg', 'png', 'webp', 'avif']
          && data.width is int
          && data.width >= 1
          && data.width <= 6000
          && data.height is int
          && data.height >= 1
          && data.height <= 6000
          && data.bytes is int
          && data.bytes >= 1
          && data.bytes <= 10485760
          && data.status is string
          && data.status in ['draft', 'published', 'archived']
          && (data.status != 'published' || data.altText.trim().size() >= 3)
          && data.sortOrder is int
          && data.sortOrder >= 0
          && data.uploadedAt is timestamp
          && data.uploadedByUid is string
          && data.uploadedByUid.size() >= 1
          && data.createdAt is timestamp
          && data.createdByUid is string
          && data.createdByUid.size() >= 1
          && data.updatedAt is timestamp
          && data.updatedByUid == request.auth.uid
          && data.version is int
          && data.version >= 1;
      }

      function isValidGalleryItemCreate(data) {
        return isValidGalleryItemShape(data)
          && data.version == 1
          && data.uploadedByUid == request.auth.uid
          && data.createdByUid == request.auth.uid;
      }

      function isValidGalleryItemUpdate(nextData, prevData) {
        return isValidGalleryItemShape(nextData)
          && nextData.version == prevData.version + 1
          && nextData.cloudinaryPublicId == prevData.cloudinaryPublicId
          && nextData.cloudinaryAssetId == prevData.cloudinaryAssetId
          && nextData.secureUrl == prevData.secureUrl
          && nextData.resourceType == prevData.resourceType
          && nextData.format == prevData.format
          && nextData.width == prevData.width
          && nextData.height == prevData.height
          && nextData.bytes == prevData.bytes
          && nextData.uploadedAt == prevData.uploadedAt
          && nextData.uploadedByUid == prevData.uploadedByUid
          && nextData.createdAt == prevData.createdAt
          && nextData.createdByUid == prevData.createdByUid
          && !(prevData.status == 'archived' && nextData.status == 'published');
      }
    }

    match /landingPagePlacements/{placementId} {
      allow get: if (resource != null && resource.data.status == 'published')
        || isActiveOwner();

      allow list: if resource.data.status == 'published'
        || isActiveOwner();

      allow create: if isActiveOwner()
        && isValidLandingPagePlacementCreate(request.resource.data, placementId);

      allow update: if isActiveOwner()
        && isValidLandingPagePlacementUpdate(request.resource.data, resource.data, placementId);

      allow delete: if false;

      function isValidHeroFeaturedCopy(copy) {
        return copy is map
          && copy.keys().hasOnly([
            'topSticker',
            'captionTitle',
            'captionSubtitle',
            'floatingBadgeTitle',
            'floatingBadgeSubtitle'
          ])
          && copy.size() == 5
          && copy.topSticker is string
          && copy.topSticker.size() <= 60
          && copy.captionTitle is string
          && copy.captionTitle.trim().size() >= 2
          && copy.captionTitle.trim().size() <= 100
          && copy.captionSubtitle is string
          && copy.captionSubtitle.size() <= 160
          && copy.floatingBadgeTitle is string
          && copy.floatingBadgeTitle.size() <= 80
          && copy.floatingBadgeSubtitle is string
          && copy.floatingBadgeSubtitle.size() <= 120;
      }

      function isValidRoomPlacementCopy(copy) {
        return copy is map
          && copy.keys().hasOnly([
            'sticker',
            'name',
            'capacityLabel',
            'tags',
            'ctaLabel'
          ])
          && copy.size() == 5
          && copy.sticker is string
          && copy.sticker.size() <= 60
          && copy.name is string
          && copy.name.trim().size() >= 2
          && copy.name.trim().size() <= 100
          && copy.capacityLabel is string
          && copy.capacityLabel.trim().size() >= 2
          && copy.capacityLabel.trim().size() <= 180
          && copy.tags is list
          && copy.tags.size() >= 1
          && copy.tags.size() <= 6
          && copy.tags[0] is string
          && copy.tags[0].trim().size() >= 1
          && copy.tags[0].size() <= 60
          && copy.ctaLabel is string
          && copy.ctaLabel.trim().size() >= 2
          && copy.ctaLabel.trim().size() <= 60;
      }

      function isValidStudioExteriorCopy(copy) {
        return copy is map
          && copy.keys().hasOnly(['caption'])
          && copy.size() == 1
          && copy.caption is string
          && copy.caption.size() <= 180;
      }

      function isValidLandingPagePlacementCopy(placementId, copy) {
        return (placementId == 'hero-featured' && isValidHeroFeaturedCopy(copy))
          || ((placementId == 'room-a' || placementId == 'room-b') && isValidRoomPlacementCopy(copy))
          || (placementId == 'studio-exterior' && isValidStudioExteriorCopy(copy));
      }

      function isValidLandingPagePlacementShape(data, placementId) {
        return placementId in ['hero-featured', 'room-a', 'room-b', 'studio-exterior']
          && data.keys().hasOnly([
            'schemaVersion',
            'placementId',
            'sourceGalleryItemId',
            'cloudinaryPublicId',
            'cloudinaryAssetId',
            'secureUrl',
            'resourceType',
            'format',
            'width',
            'height',
            'bytes',
            'altText',
            'copy',
            'status',
            'version',
            'createdAt',
            'createdByUid',
            'updatedAt',
            'updatedByUid'
          ])
          && data.size() == 19
          && data.schemaVersion == 1
          && data.placementId == placementId
          && data.sourceGalleryItemId is string
          && data.sourceGalleryItemId.trim().size() >= 1
          && data.sourceGalleryItemId.size() <= 120
          && data.cloudinaryPublicId is string
          && data.cloudinaryPublicId.trim().size() >= 1
          && data.cloudinaryPublicId.size() <= 240
          && data.cloudinaryAssetId is string
          && data.cloudinaryAssetId.trim().size() >= 1
          && data.cloudinaryAssetId.size() <= 120
          && data.secureUrl is string
          && data.secureUrl.size() <= 600
          && data.secureUrl.matches('^https://res\\.cloudinary\\.com/[a-zA-Z0-9_-]+/image/upload/[^\\s]+$')
          && data.resourceType == 'image'
          && data.format is string
          && data.format in ['jpg', 'jpeg', 'png', 'webp', 'avif']
          && data.width is int
          && data.width >= 1
          && data.width <= 6000
          && data.height is int
          && data.height >= 1
          && data.height <= 6000
          && data.bytes is int
          && data.bytes >= 1
          && data.bytes <= 10485760
          && data.altText is string
          && data.altText.trim().size() >= 3
          && data.altText.size() <= 220
          && isValidLandingPagePlacementCopy(placementId, data.copy)
          && data.status is string
          && data.status in ['draft', 'published']
          && data.version is int
          && data.version >= 1
          && data.createdAt is timestamp
          && data.createdByUid is string
          && data.createdByUid.size() >= 1
          && data.updatedAt is timestamp
          && data.updatedByUid == request.auth.uid;
      }

      function isValidLandingPagePlacementCreate(data, placementId) {
        return isValidLandingPagePlacementShape(data, placementId)
          && data.version == 1
          && data.createdByUid == request.auth.uid;
      }

      function isValidLandingPagePlacementUpdate(nextData, prevData, placementId) {
        return isValidLandingPagePlacementShape(nextData, placementId)
          && nextData.version == prevData.version + 1
          && nextData.createdAt == prevData.createdAt
          && nextData.createdByUid == prevData.createdByUid;
      }
    }

    match /publicAvailability/{bookingId} {
      allow read: if true;

      allow create, update: if isActiveStaff()
        && !isFactoryResetLocked()
        && isValidPublicAvailabilityProjectionShape(request.resource.data)
        && isPublicAvailabilityMatchedToCanonicalBookingAfter(request.resource.data, bookingId);

      allow delete: if (!isFactoryResetLocked() && isActiveStaff() && isPublicAvailabilityDeleteAllowedAfter(bookingId))
        || canFactoryResetDelete();

      function isValidPublicAvailabilityProjectionShape(data) {
        return data.keys().hasOnly([
            'schemaVersion',
            'date',
            'studioId',
            'startMinute',
            'endMinute',
            'updatedAt'
          ])
          && data.size() == 6
          && data.schemaVersion == 1
          && data.date is string
          && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && data.studioId in ['room-a', 'room-b']
          && data.startMinute is int
          && data.startMinute >= 600
          && data.startMinute < 1380
          && data.startMinute % 30 == 0
          && data.endMinute is int
          && data.endMinute > data.startMinute
          && data.endMinute <= 1380
          && data.endMinute % 30 == 0
          && data.updatedAt is timestamp;
      }

      function isPublicAvailabilityMatchedToCanonicalBookingAfter(data, bookingId) {
        let bookingAfter = getAfter(/databases/$(database)/documents/bookings/$(bookingId));
        return bookingAfter != null
          && bookingAfter.data.date == data.date
          && bookingAfter.data.studioId == data.studioId
          && bookingAfter.data.startMinute == data.startMinute
          && bookingAfter.data.endMinute == data.endMinute
          && !(bookingAfter.data.get('reservationStatus', 'confirmed') in ['expired', 'cancelled'])
          && !(bookingAfter.data.sessionStatus in ['cancelled', 'no_show']);
      }

      function isPublicAvailabilityDeleteAllowedAfter(bookingId) {
        let bookingAfter = getAfter(/databases/$(database)/documents/bookings/$(bookingId));
        return bookingAfter == null
          || bookingAfter.data.get('reservationStatus', 'confirmed') in ['expired', 'cancelled']
          || bookingAfter.data.sessionStatus in ['cancelled', 'no_show'];
      }
    }

    match /publicAvailabilityMetadata/{docId} {
      allow get: if docId == 'status';
      allow list: if false;

      allow create, update: if isActiveOwner()
        && docId == 'status'
        && isValidPublicAvailabilityMetadataShape(request.resource.data);

      allow delete: if false;

      function isValidPublicAvailabilityMetadataShape(data) {
        return data.keys().hasOnly([
            'schemaVersion',
            'isReady',
            'backfilledFromDate',
            'backfillCompletedAt',
            'updatedAt'
          ])
          && data.size() == 5
          && data.schemaVersion == 1
          && data.isReady is bool
          && data.backfilledFromDate is string
          && (data.backfilledFromDate == '' || data.backfilledFromDate.matches('^\\d{4}-\\d{2}-\\d{2}$'))
          && (data.backfillCompletedAt == null || data.backfillCompletedAt is timestamp)
          && data.updatedAt is timestamp;
      }
    }

    match /publicPricingCatalog/{docId} {
      allow get: if docId == 'current';
      allow list: if false;

      allow create, update: if isActiveOwner()
        && docId == 'current'
        && isValidPublicPricingCatalogShape(request.resource.data);

      allow delete: if false;

      function isValidPublicPricingCatalogShape(data) {
        return data.keys().hasOnly([
            'schemaVersion',
            'version',
            'serviceTypes',
            'serviceOptionIndex',
            'policyVersion',
            'updatedAt'
          ])
          && (data.size() == 5 || data.size() == 6)
          && !data.keys().hasAny([
            'fees',
            'operationalSettings',
            'updatedByUid',
            'defaultStaffCommission',
            'defaultOwnerCommission',
            'staffCommissionAmount',
            'recordingOperatorCommissionAmount',
            'rehearsalStaffCommissionPerHour',
            'dailyMealAllowancePerStaff'
          ])
          && data.schemaVersion in [3, 4]
          && (data.schemaVersion == 3
            ? (!('policyVersion' in data) && data.size() == 5)
            : (data.policyVersion is int && data.policyVersion >= 0 && data.size() == 6))
          && data.version is int
          && data.version >= 1
          && data.serviceTypes is list
          && data.serviceTypes.size() <= 20
          && data.serviceOptionIndex is list
          && data.serviceOptionIndex.size() <= 500
          && data.updatedAt is timestamp;
      }
    }

    match /publicSiteSettings/{docId} {
      allow get: if docId == 'site';
      allow list: if false;

      allow create, update: if isActiveOwner()
        && docId == 'site'
        && isValidPublicSiteSettingsShape(request.resource.data);

      allow delete: if false;

      function isValidPublicSiteSettingsShape(data) {
        return data.keys().hasOnly([
            'schemaVersion',
            'studioName',
            'tagline',
            'publicWhatsappNumber',
            'publicEmail',
            'publicAddress',
            'city',
            'mapsUrl',
            'operatingHours',
            'publishedServices',
            'publishedRooms',
            'socialLinks',
            'verifiedTestimonials',
            'seoTitle',
            'seoDescription',
            'isPublished',
            'updatedAt'
          ])
          && data.size() == 17
          && data.schemaVersion == 1
          && data.studioName is string
          && data.studioName.trim().size() >= 2
          && data.studioName.trim().size() <= 100
          && data.tagline is string
          && data.tagline.size() <= 160
          && data.publicWhatsappNumber is string
          && data.publicWhatsappNumber.size() <= 20
          && (data.publicWhatsappNumber == '' || data.publicWhatsappNumber.matches('^\\+[1-9][0-9]{7,14}$'))
          && data.publicEmail is string
          && data.publicEmail.size() <= 120
          && (data.publicEmail == '' || data.publicEmail.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$'))
          && data.publicAddress is string
          && data.publicAddress.size() <= 300
          && data.city is string
          && data.city.size() <= 80
          && data.mapsUrl is string
          && data.mapsUrl.size() <= 500
          && (data.mapsUrl == '' || data.mapsUrl.matches('^https?://[^\\s]+$'))
          && data.operatingHours is string
          && data.operatingHours.trim().size() >= 2
          && data.operatingHours.size() <= 80
          && data.publishedServices is list
          && data.publishedServices.size() >= 1
          && data.publishedServices.size() <= 6
          && data.publishedRooms is list
          && data.publishedRooms.size() >= 1
          && data.publishedRooms.size() <= 4
          && data.socialLinks is list
          && data.socialLinks.size() <= 6
          && data.verifiedTestimonials is list
          && data.verifiedTestimonials.size() <= 12
          && data.seoTitle is string
          && data.seoTitle.trim().size() >= 5
          && data.seoTitle.size() <= 120
          && data.seoDescription is string
          && data.seoDescription.trim().size() >= 10
          && data.seoDescription.size() <= 260
          && data.isPublished is bool
          && data.updatedAt is timestamp;
      }
    }

    match /publicBookingRequests/{requestId} {
      allow get: if isActiveStaff()
        || (
          isActiveClient()
          && resource != null
          && resource.data.source == 'client_portal'
          && resource.data.clientUid == request.auth.uid
        );

      allow list: if isActiveStaff()
        || (
          isActiveClient()
          && resource.data.source == 'client_portal'
          && resource.data.clientUid == request.auth.uid
        );

      allow create: if !isFactoryResetLocked()
        && isValidPublicBookingRequestCreate(request.resource.data, requestId);

      allow update: if !isFactoryResetLocked()
        && (
          (isActiveStaff() && isValidBookingRequestStaffUpdate(request.resource.data, resource.data, requestId))
          || (isActiveClient() && isValidBookingRequestClientOfferResponseUpdate(request.resource.data, resource.data, requestId))
        );

      allow delete: if canFactoryResetDelete();

      function isValidPublicBookingRequestKeys(data) {
        return data.keys().hasAll([
          'schemaVersion', 'requestReference', 'requestType', 'status', 'statusReason',
          'customerName', 'bandName', 'contactPhone', 'publicServiceId', 'serviceLabelSnapshot',
          'requestedRoomId', 'preferredDate', 'preferredStartMinute', 'preferredDurationMinutes',
          'targetDeadline', 'notes', 'privacyConsent', 'consentVersion', 'source',
          'assignedStaffUid', 'assignedStaffName', 'lastCommunicationAt', 'lastCommunicationType',
          'lastCommunicationStatus', 'linkedBookingId', 'confirmedBookingSnapshot',
          'confirmedAt', 'confirmedByUid', 'appCheckState', 'createdAt', 'updatedAt',
          'updatedByUid', 'version'
        ]) && data.size() == 33;
      }

      function isValidPublicBookingRequestUpdateKeys(data) {
        return data.keys().hasAll([
          'schemaVersion', 'requestReference', 'requestType', 'status', 'statusReason',
          'customerName', 'bandName', 'contactPhone', 'publicServiceId', 'serviceLabelSnapshot',
          'requestedRoomId', 'preferredDate', 'preferredStartMinute', 'preferredDurationMinutes',
          'targetDeadline', 'notes', 'privacyConsent', 'consentVersion', 'source',
          'assignedStaffUid', 'assignedStaffName', 'lastCommunicationAt', 'lastCommunicationType',
          'lastCommunicationStatus', 'linkedBookingId', 'confirmedBookingSnapshot',
          'confirmedAt', 'confirmedByUid', 'appCheckState', 'createdAt', 'updatedAt',
          'updatedByUid', 'version'
        ]) && data.keys().hasOnly([
          'schemaVersion', 'requestReference', 'requestType', 'status', 'statusReason',
          'customerName', 'bandName', 'contactPhone', 'publicServiceId', 'serviceLabelSnapshot',
          'requestedRoomId', 'preferredDate', 'preferredStartMinute', 'preferredDurationMinutes',
          'targetDeadline', 'notes', 'privacyConsent', 'consentVersion', 'source',
          'assignedStaffUid', 'assignedStaffName', 'lastCommunicationAt', 'lastCommunicationType',
          'lastCommunicationStatus', 'linkedBookingId', 'confirmedBookingSnapshot',
          'confirmedAt', 'confirmedByUid', 'appCheckState', 'createdAt', 'updatedAt',
          'updatedByUid', 'version',
          'activeOfferId', 'activeOfferSummary', 'acceptedOfferId', 'linkedProjectId', 'convertedAt', 'convertedByUid'
        ]);
      }

      function isValidClientBookingRequestKeys(data) {
        return data.keys().hasAll([
          'schemaVersion', 'requestReference', 'requestType', 'status', 'statusReason',
          'customerName', 'bandName', 'contactPhone', 'publicServiceId', 'serviceLabelSnapshot',
          'requestedRoomId', 'preferredDate', 'preferredStartMinute', 'preferredDurationMinutes',
          'targetDeadline', 'notes', 'privacyConsent', 'consentVersion', 'source',
          'clientUid', 'customerId', 'serviceOptionId', 'serviceOptionName', 'pricingVersion',
          'assignedStaffUid', 'assignedStaffName', 'lastCommunicationAt', 'lastCommunicationType',
          'lastCommunicationStatus', 'linkedBookingId', 'confirmedBookingSnapshot',
          'confirmedAt', 'confirmedByUid', 'appCheckState', 'createdAt', 'updatedAt',
          'updatedByUid', 'version'
        ]) && data.size() == 38;
      }

      function isValidClientBookingRequestUpdateKeys(data) {
        return data.keys().hasAll([
          'schemaVersion', 'requestReference', 'requestType', 'status', 'statusReason',
          'customerName', 'bandName', 'contactPhone', 'publicServiceId', 'serviceLabelSnapshot',
          'requestedRoomId', 'preferredDate', 'preferredStartMinute', 'preferredDurationMinutes',
          'targetDeadline', 'notes', 'privacyConsent', 'consentVersion', 'source',
          'clientUid', 'customerId', 'serviceOptionId', 'serviceOptionName', 'pricingVersion',
          'assignedStaffUid', 'assignedStaffName', 'lastCommunicationAt', 'lastCommunicationType',
          'lastCommunicationStatus', 'linkedBookingId', 'confirmedBookingSnapshot',
          'confirmedAt', 'confirmedByUid', 'appCheckState', 'createdAt', 'updatedAt',
          'updatedByUid', 'version'
        ]) && data.keys().hasOnly([
          'schemaVersion', 'requestReference', 'requestType', 'status', 'statusReason',
          'customerName', 'bandName', 'contactPhone', 'publicServiceId', 'serviceLabelSnapshot',
          'requestedRoomId', 'preferredDate', 'preferredStartMinute', 'preferredDurationMinutes',
          'targetDeadline', 'notes', 'privacyConsent', 'consentVersion', 'source',
          'clientUid', 'customerId', 'serviceOptionId', 'serviceOptionName', 'pricingVersion',
          'assignedStaffUid', 'assignedStaffName', 'lastCommunicationAt', 'lastCommunicationType',
          'lastCommunicationStatus', 'linkedBookingId', 'confirmedBookingSnapshot',
          'confirmedAt', 'confirmedByUid', 'appCheckState', 'createdAt', 'updatedAt',
          'updatedByUid', 'version',
          'activeOfferId', 'activeOfferSummary', 'acceptedOfferId', 'linkedProjectId', 'convertedAt', 'convertedByUid'
        ]);
      }

      function isValidPublicBookingRequestScheduleShape(data) {
        return (
          data.requestType == 'studio_booking'
          && data.requestedRoomId in ['room-a', 'room-b', 'any']
          && data.preferredDate is string
          && data.preferredDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && data.preferredStartMinute is int
          && data.preferredStartMinute >= 600
          && data.preferredStartMinute < 1380
          && data.preferredStartMinute % 30 == 0
          && data.preferredDurationMinutes is int
          && data.preferredDurationMinutes >= 60
          && data.preferredDurationMinutes <= 780
          && data.preferredDurationMinutes % 30 == 0
          && data.preferredStartMinute + data.preferredDurationMinutes <= 1380
          && data.targetDeadline == null
        ) || (
          data.requestType == 'post_production_inquiry'
          && data.requestedRoomId == null
          && data.preferredDate == null
          && data.preferredStartMinute == null
          && data.preferredDurationMinutes == null
          && (data.targetDeadline == null || (data.targetDeadline is string && data.targetDeadline.matches('^\\d{4}-\\d{2}-\\d{2}$')))
        );
      }

      function isValidClientPortalProjectDetails(data) {
        return data.requestType != 'post_production_inquiry'
          || (
            data.bandName is string
            && data.bandName.trim().size() >= 2
            && data.notes is string
            && data.notes.matches('^.*Project Brief: .{10,}$')
          );
      }

      function isValidClientBookingCatalogSnapshot(data) {
        let catalog = get(/databases/$(database)/documents/publicPricingCatalog/current);
        return catalog.data.schemaVersion in [3, 4]
          && data.pricingVersion == catalog.data.version
          && catalog.data.serviceOptionIndex is list
          && catalog.data.serviceOptionIndex.hasAny([{
            'serviceTypeId': data.publicServiceId,
            'serviceLabelSnapshot': data.serviceLabelSnapshot,
            'serviceOptionId': data.serviceOptionId,
            'serviceOptionName': data.serviceOptionName,
            'deliveryMode': data.requestType == 'studio_booking' ? 'studio' : 'wfa'
          }]);
      }

      function isValidClientPortalBookingRequestCreate(data) {
        return isActiveClient()
          && isValidClientBookingRequestKeys(data)
          && data.source == 'client_portal'
          && data.clientUid == request.auth.uid
          && data.customerId == getClientAccountDoc(request.auth.uid).data.customerId
          && data.publicServiceId is string
          && data.publicServiceId.trim().size() >= 2
          && data.publicServiceId.size() <= 80
          && data.serviceOptionId is string
          && data.serviceOptionId.trim().size() >= 1
          && data.serviceOptionId.size() <= 80
          && data.serviceOptionName is string
          && data.serviceOptionName.trim().size() >= 1
          && data.serviceOptionName.size() <= 100
          && data.pricingVersion is int
          && data.pricingVersion >= 1
          && exists(/databases/$(database)/documents/publicPricingCatalog/current)
          && isValidClientBookingCatalogSnapshot(data)
          && isValidClientPortalProjectDetails(data);
      }

      function isValidAnonymousPublicBookingRequestCreate(data) {
        return isValidPublicBookingRequestKeys(data)
          && data.source in ['public_landing_page', 'public_availability_calendar']
          && (
            (data.requestType == 'studio_booking' && data.publicServiceId in ['rehearsal', 'recording'])
            || (data.requestType == 'post_production_inquiry' && data.publicServiceId == 'mix-master')
          );
      }

      function isValidPublicBookingRequestCreate(data, requestId) {
        return requestId is string
          && requestId.size() >= 8
          && requestId.size() <= 80
          && data.schemaVersion == 1
          && data.requestReference is string
          && data.requestReference.matches('^REQ-[A-Z0-9]{8}$')
          && data.status == 'new'
          && data.statusReason == ''
          && data.version == 1
          && data.privacyConsent == true
          && data.consentVersion == 'v1'
          && data.customerName is string
          && data.customerName.trim().size() >= 2
          && data.customerName.trim().size() <= 100
          && data.bandName is string
          && data.bandName.size() <= 100
          && data.contactPhone is string
          && data.contactPhone.matches('^\\+[1-9][0-9]{7,14}$')
          && data.serviceLabelSnapshot is string
          && data.serviceLabelSnapshot.trim().size() >= 2
          && data.serviceLabelSnapshot.size() <= 80
          && data.notes is string
          && data.notes.size() <= 600
          && data.appCheckState in ['verified', 'unconfigured']
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && data.updatedByUid == ''
          && data.assignedStaffUid == ''
          && data.assignedStaffName == ''
          && data.lastCommunicationAt == null
          && data.lastCommunicationType == ''
          && data.lastCommunicationStatus == ''
          && data.linkedBookingId == null
          && data.confirmedBookingSnapshot == null
          && data.confirmedAt == null
          && data.confirmedByUid == ''
          && isValidPublicBookingRequestScheduleShape(data)
          && (
            isValidAnonymousPublicBookingRequestCreate(data)
            || isValidClientPortalBookingRequestCreate(data)
          );
      }

      function isBookingRequestCustomerFieldsUnchanged(nextData, prevData) {
        return nextData.schemaVersion == prevData.schemaVersion
          && nextData.requestReference == prevData.requestReference
          && nextData.requestType == prevData.requestType
          && nextData.customerName == prevData.customerName
          && nextData.bandName == prevData.bandName
          && nextData.contactPhone == prevData.contactPhone
          && nextData.publicServiceId == prevData.publicServiceId
          && nextData.serviceLabelSnapshot == prevData.serviceLabelSnapshot
          && nextData.requestedRoomId == prevData.requestedRoomId
          && nextData.preferredDate == prevData.preferredDate
          && nextData.preferredStartMinute == prevData.preferredStartMinute
          && nextData.preferredDurationMinutes == prevData.preferredDurationMinutes
          && nextData.targetDeadline == prevData.targetDeadline
          && nextData.notes == prevData.notes
          && nextData.privacyConsent == prevData.privacyConsent
          && nextData.consentVersion == prevData.consentVersion
          && nextData.source == prevData.source
          && nextData.get('clientUid', '') == prevData.get('clientUid', '')
          && nextData.get('customerId', '') == prevData.get('customerId', '')
          && nextData.get('serviceOptionId', '') == prevData.get('serviceOptionId', '')
          && nextData.get('serviceOptionName', '') == prevData.get('serviceOptionName', '')
          && nextData.get('pricingVersion', null) == prevData.get('pricingVersion', null)
          && nextData.appCheckState == prevData.appCheckState
          && nextData.createdAt == prevData.createdAt;
      }

      function isValidConfirmedBookingSnapshot(snap, bookingId, bookingData) {
        return snap is map
          && snap.size() == 10
          && snap.bookingId == bookingId
          && snap.bookingReference is string
          && snap.bookingReference.size() >= 3
          && snap.studioId == bookingData.studioId
          && snap.studioName is string
          && snap.serviceTypeName is string
          && snap.serviceOptionName is string
          && snap.date == bookingData.date
          && snap.startMinute == bookingData.startMinute
          && snap.endMinute == bookingData.endMinute
          && snap.durationMinutes == bookingData.durationMinutes;
      }

      function isBookingRequestLinkedBookingValidAfter(nextData) {
        let bookingAfter = getAfter(/databases/$(database)/documents/bookings/$(nextData.linkedBookingId));
        return nextData.linkedBookingId is string
          && nextData.linkedBookingId.size() > 0
          && existsAfter(/databases/$(database)/documents/bookings/$(nextData.linkedBookingId))
          && bookingAfter != null
          && bookingAfter.data.sessionStatus != 'cancelled'
          && bookingAfter.data.get('reservationStatus', 'confirmed') != 'expired'
          && isValidConfirmedBookingSnapshot(
            nextData.confirmedBookingSnapshot,
            nextData.linkedBookingId,
            bookingAfter.data
          );
      }

      function isValidBookingRequestOfferUpdateByStaff(nextData, prevData, requestId) {
        let activeId = nextData.get('activeOfferId', '');
        let offerAfter = getAfter(/databases/$(database)/documents/publicBookingRequests/$(requestId)/offers/$(activeId));
        return activeId is string
          && activeId.size() > 0
          && offerAfter != null
          && (
            (
              nextData.status == 'offer_sent'
              && prevData.status in ['new', 'in_review', 'awaiting_customer', 'offer_sent', 'accepted']
              && offerAfter.data.status == 'sent'
              && offerAfter.data.offerMode in ['quote_only', 'deposit_hold_offer']
            )
            || (
              prevData.status == 'offer_sent'
              && nextData.status in ['in_review', 'awaiting_customer', 'accepted', 'closed']
              && offerAfter.data.status in ['withdrawn', 'expired', 'accepted', 'rejected']
            )
          );
      }

      function isValidBookingRequestStatusTransition(nextData, prevData, requestId) {
        return (
          nextData.status == prevData.status
          && nextData.statusReason == prevData.statusReason
          && nextData.linkedBookingId == prevData.linkedBookingId
          && nextData.confirmedBookingSnapshot == prevData.confirmedBookingSnapshot
          && nextData.confirmedAt == prevData.confirmedAt
          && nextData.confirmedByUid == prevData.confirmedByUid
        ) || (
          nextData.status == 'confirmed'
          && prevData.requestType == 'studio_booking'
          && prevData.status in ['new', 'in_review', 'awaiting_customer', 'offer_sent', 'accepted']
          && prevData.linkedBookingId == null
          && nextData.linkedBookingId is string
          && nextData.linkedBookingId.size() > 0
          && nextData.confirmedAt is timestamp
          && nextData.confirmedByUid == request.auth.uid
          && isBookingRequestLinkedBookingValidAfter(nextData)
        ) || (
          nextData.status != 'confirmed'
          && nextData.linkedBookingId == prevData.linkedBookingId
          && nextData.confirmedBookingSnapshot == prevData.confirmedBookingSnapshot
          && nextData.confirmedAt == prevData.confirmedAt
          && nextData.confirmedByUid == prevData.confirmedByUid
          && (
            isValidBookingRequestOfferUpdateByStaff(nextData, prevData, requestId)
            || (
              (prevData.status == 'new' && nextData.status in ['in_review', 'awaiting_customer', 'accepted', 'declined', 'closed'])
              || (prevData.status == 'in_review' && nextData.status in ['awaiting_customer', 'accepted', 'declined', 'closed'])
              || (prevData.status == 'awaiting_customer' && nextData.status in ['in_review', 'accepted', 'declined', 'closed'])
              || (prevData.status == 'offer_sent' && nextData.status in ['in_review', 'awaiting_customer', 'declined', 'closed'])
              || (prevData.status == 'accepted' && nextData.status in ['in_review', 'awaiting_customer', 'declined', 'closed'])
              || (prevData.status == 'declined' && nextData.status == 'closed')
            )
          )
          && (
            !(nextData.status in ['declined', 'closed'])
            || (nextData.statusReason is string && nextData.statusReason.trim().size() >= 3 && nextData.statusReason.size() <= 400)
          )
        );
      }

      function isValidBookingRequestStaffUpdate(nextData, prevData, requestId) {
        return (
            prevData.source == 'client_portal'
              ? isValidClientBookingRequestUpdateKeys(nextData)
              : isValidPublicBookingRequestUpdateKeys(nextData)
          )
          && isBookingRequestCustomerFieldsUnchanged(nextData, prevData)
          && nextData.version == prevData.version + 1
          && nextData.updatedByUid == request.auth.uid
          && nextData.updatedAt is timestamp
          && nextData.assignedStaffUid is string
          && nextData.assignedStaffUid.size() <= 128
          && nextData.assignedStaffName is string
          && nextData.assignedStaffName.size() <= 120
          && (nextData.lastCommunicationAt == null || nextData.lastCommunicationAt is timestamp)
          && nextData.lastCommunicationType is string
          && nextData.lastCommunicationType.size() <= 60
          && nextData.lastCommunicationStatus is string
          && nextData.lastCommunicationStatus.size() <= 60
          && isValidBookingRequestStatusTransition(nextData, prevData, requestId);
      }

      function isValidBookingRequestClientOfferResponseUpdate(nextData, prevData, requestId) {
        let activeId = prevData.get('activeOfferId', '');
        let offerPath = /databases/$(database)/documents/publicBookingRequests/$(requestId)/offers/$(activeId);
        let offerBefore = get(offerPath);
        let offerAfter = getAfter(offerPath);
        let affected = nextData.diff(prevData).affectedKeys();
        return prevData.source == 'client_portal'
          && prevData.clientUid == request.auth.uid
          && prevData.status in ['offer_sent', 'in_review', 'awaiting_customer']
          && activeId is string
          && activeId.size() > 0
          && affected.hasOnly(['status', 'activeOfferSummary', 'updatedAt', 'updatedByUid', 'version'])
          && nextData.updatedByUid == request.auth.uid
          && nextData.updatedAt is timestamp
          && nextData.version == prevData.version + 1
          && offerBefore != null
          && offerBefore.data.status == 'sent'
          && offerBefore.data.offerMode in ['quote_only', 'deposit_hold_offer']
          && offerBefore.data.supersededByOfferId == null
          && offerAfter != null
          && offerAfter.data.version == offerBefore.data.version + 1
          && offerAfter.data.respondedByUid == request.auth.uid
          && (
            (offerAfter.data.status == 'accepted'
              && nextData.status == 'accepted'
              && request.time <= offerBefore.data.offerExpiresAt)
            || (offerAfter.data.status == 'rejected'
              && nextData.status == 'in_review')
          )
          && nextData.activeOfferSummary is map
          && nextData.activeOfferSummary.status == offerAfter.data.status;
      }

      match /offers/{offerId} {
        allow get, list: if isActiveStaff()
          || (
            isActiveClient()
            && get(/databases/$(database)/documents/publicBookingRequests/$(requestId)).data.source == 'client_portal'
            && get(/databases/$(database)/documents/publicBookingRequests/$(requestId)).data.clientUid == request.auth.uid
          );
        allow create: if isActiveStaff()
          && !isFactoryResetLocked()
          && isValidOfferCreate(request.resource.data, offerId, requestId);
        allow update: if !isFactoryResetLocked()
          && resource != null
          && (
            (isActiveStaff() && isValidOfferStaffUpdate(request.resource.data, resource.data, requestId))
            || (isActiveClient() && isValidOfferClientRespondUpdate(request.resource.data, resource.data, requestId, offerId))
          );
        allow delete: if canFactoryResetDelete();

        function isValidDepositHoldOfferProvisionalLink(data, offerId, requestId) {
          let provId = data.provisionalBookingId;
          let bookingAfter = getAfter(/databases/$(database)/documents/bookings/$(provId));
          return provId is string
            && provId.size() > 0
            && data.holdDeadline is timestamp
            && data.depositPolicySnapshot.get('minimumDepositAmount', 0) > 0
            && existsAfter(/databases/$(database)/documents/bookings/$(provId))
            && bookingAfter != null
            && bookingAfter.data.get('reservationStatus', '') == 'deposit_hold'
            && bookingAfter.data.get('sourceRequestId', '') == requestId
            && bookingAfter.data.get('acceptedOfferId', '') == offerId
            && existsAfter(/databases/$(database)/documents/invoices/$('inv_' + provId));
        }

        function isValidDepositHoldOfferReleaseAfter(prevData) {
          let provId = prevData.get('provisionalBookingId', null);
          let bookingAfter = getAfter(/databases/$(database)/documents/bookings/$(provId));
          return !(provId is string && provId.size() > 0)
            || (bookingAfter != null && bookingAfter.data.get('reservationStatus', '') == 'expired');
        }

        function isValidDepositHoldOfferConfirmAcceptAfter(prevData) {
          let provId = prevData.get('provisionalBookingId', null);
          let bookingAfter = getAfter(/databases/$(database)/documents/bookings/$(provId));
          return provId is string
            && provId.size() > 0
            && bookingAfter != null
            && bookingAfter.data.get('reservationStatus', '') == 'confirmed';
        }

        function isValidOfferCreate(data, offerId, requestId) {
          return data.keys().hasOnly([
              'schemaVersion', 'offerId', 'offerNumber', 'revisionNumber', 'requestId',
              'clientUid', 'customerId', 'offerMode', 'provisionalBookingId',
              'scheduleSnapshot', 'serviceSnapshot', 'financialSnapshot',
              'depositPolicySnapshot', 'holdDeadline', 'balanceDuePolicy',
              'offerExpiresAt', 'staffNoteToClient', 'status', 'supersededByOfferId',
              'respondedAt', 'respondedByUid', 'responseReason', 'withdrawalOrExpiryReason',
              'createdAt', 'createdByUid', 'updatedAt', 'updatedByUid', 'version'
            ])
            && data.size() == 28
            && data.schemaVersion == 1
            && data.offerId == offerId
            && data.offerNumber is string
            && data.offerNumber.matches('^OFF-\\d{2,}$')
            && data.revisionNumber is int && data.revisionNumber >= 1
            && data.requestId == requestId
            // Enforces Owner ADR Option A: quote_only has null hold link; deposit_hold_offer binds atomically to a deposit_hold booking + unpaid invoice
            && data.offerMode in ['quote_only', 'deposit_hold_offer']
            && data.status == 'sent'
            && data.supersededByOfferId == null
            && data.respondedAt == null
            && data.offerExpiresAt is timestamp
            && data.staffNoteToClient is string && data.staffNoteToClient.size() <= 1000
            && data.scheduleSnapshot is map
            && data.serviceSnapshot is map
            && data.financialSnapshot is map
            && data.financialSnapshot.totalAmount is int && data.financialSnapshot.totalAmount >= 0
            && data.depositPolicySnapshot is map
            && data.balanceDuePolicy is map
            && (
              (data.offerMode == 'quote_only'
                && data.provisionalBookingId == null
                && data.holdDeadline == null)
              || (data.offerMode == 'deposit_hold_offer'
                && isValidDepositHoldOfferProvisionalLink(data, offerId, requestId))
            )
            && data.createdByUid == request.auth.uid
            && data.updatedByUid == request.auth.uid
            && data.version == 1;
        }

        function isValidOfferStaffUpdate(nextData, prevData, requestId) {
          let reqDoc = get(/databases/$(database)/documents/publicBookingRequests/$(requestId));
          return prevData.status == 'sent'
            && nextData.offerId == prevData.offerId
            && nextData.requestId == prevData.requestId
            && nextData.revisionNumber == prevData.revisionNumber
            && nextData.offerMode in ['quote_only', 'deposit_hold_offer']
            && nextData.offerMode == prevData.offerMode
            && nextData.get('provisionalBookingId', null) == prevData.get('provisionalBookingId', null)
            && nextData.updatedByUid == request.auth.uid
            && nextData.updatedAt is timestamp
            && nextData.version == prevData.version + 1
            && (
              (nextData.status == 'superseded'
                && nextData.supersededByOfferId is string
                && nextData.supersededByOfferId.size() > 0
                && (prevData.offerMode == 'quote_only' || isValidDepositHoldOfferReleaseAfter(prevData)))
              || (nextData.status in ['withdrawn', 'expired']
                && nextData.withdrawalOrExpiryReason is string
                && nextData.withdrawalOrExpiryReason.size() >= 3
                && (prevData.offerMode == 'quote_only' || isValidDepositHoldOfferReleaseAfter(prevData)))
              || (nextData.status in ['accepted', 'rejected']
                && (
                  (reqDoc == null || reqDoc.data.source != 'client_portal')
                  || (nextData.status == 'accepted'
                    && prevData.offerMode == 'deposit_hold_offer'
                    && isValidDepositHoldOfferConfirmAcceptAfter(prevData))
                ))
            );
        }

        function isValidOfferClientRespondUpdate(nextData, prevData, requestId, offerId) {
          let reqDoc = get(/databases/$(database)/documents/publicBookingRequests/$(requestId));
          let affected = nextData.diff(prevData).affectedKeys();
          return prevData.status == 'sent'
            && prevData.offerMode in ['quote_only', 'deposit_hold_offer']
            && prevData.supersededByOfferId == null
            && reqDoc != null
            && reqDoc.data.source == 'client_portal'
            && reqDoc.data.clientUid == request.auth.uid
            && reqDoc.data.get('activeOfferId', '') == offerId
            && affected.hasOnly([
              'status', 'respondedAt', 'respondedByUid', 'responseReason',
              'updatedAt', 'updatedByUid', 'version'
            ])
            && nextData.respondedByUid == request.auth.uid
            && nextData.respondedAt is timestamp
            && nextData.updatedByUid == request.auth.uid
            && nextData.updatedAt is timestamp
            && nextData.responseReason is string && nextData.responseReason.size() <= 300
            && nextData.version == prevData.version + 1
            && (
              (nextData.status == 'accepted' && request.time <= prevData.offerExpiresAt)
              || nextData.status == 'rejected'
            );
        }
      }

      match /communications/{eventId} {
        allow read: if isActiveStaff();
        allow create: if isActiveStaff()
          && !isFactoryResetLocked()
          && isValidBookingRequestCommunicationCreate(request.resource.data);
        allow update: if false;
        allow delete: if canFactoryResetDelete();

        function isValidBookingRequestCommunicationCreate(data) {
          return data.keys().hasOnly([
              'templateId',
              'templateLabel',
              'messageBodySnapshot',
              'eventType',
              'preparedAt',
              'preparedByUid',
              'manuallyMarkedSentAt',
              'manuallyMarkedSentByUid',
              'createdAt'
            ])
            && data.size() == 9
            && data.templateId is string
            && data.templateId.size() <= 80
            && data.templateLabel is string
            && data.templateLabel.size() <= 120
            && data.messageBodySnapshot is string
            && data.messageBodySnapshot.trim().size() >= 1
            && data.messageBodySnapshot.size() <= 1800
            && data.eventType in ['whatsapp_message_prepared', 'whatsapp_message_marked_sent', 'staff_note_added']
            && (data.preparedAt == null || data.preparedAt is timestamp)
            && data.preparedByUid is string
            && (data.manuallyMarkedSentAt == null || data.manuallyMarkedSentAt is timestamp)
            && data.manuallyMarkedSentByUid is string
            && (data.preparedByUid == request.auth.uid || data.manuallyMarkedSentByUid == request.auth.uid)
            && data.createdAt is timestamp;
        }
      }

      match /activities/{eventId} {
        allow read: if isActiveStaff();
        allow create: if !isFactoryResetLocked()
          && isValidBookingRequestActivityCreate(request.resource.data)
          && (
            isActiveStaff()
            || (
              isActiveClient()
              && request.resource.data.eventType in ['offer_accepted', 'offer_rejected']
              && get(/databases/$(database)/documents/publicBookingRequests/$(requestId)).data.source == 'client_portal'
              && get(/databases/$(database)/documents/publicBookingRequests/$(requestId)).data.clientUid == request.auth.uid
            )
          );
        allow update: if false;
        allow delete: if canFactoryResetDelete();

        function isValidBookingRequestActivityCreate(data) {
          return data.keys().hasOnly([
              'eventType',
              'fromStatus',
              'toStatus',
              'linkedBookingId',
              'note',
              'actorUid',
              'actorName',
              'createdAt'
            ])
            && data.size() == 8
            && data.eventType in [
              'request_created', 'status_changed', 'booking_confirmed', 'staff_assigned',
              'offer_sent', 'offer_revised', 'offer_accepted', 'offer_rejected',
              'offer_withdrawn', 'offer_expired'
            ]
            && (data.fromStatus == null || data.fromStatus is string)
            && (data.toStatus == null || data.toStatus is string)
            && (data.linkedBookingId == null || data.linkedBookingId is string)
            && data.note is string
            && data.note.size() <= 500
            && data.actorUid == request.auth.uid
            && data.actorName is string
            && data.actorName.size() <= 120
            && data.createdAt is timestamp;
        }
      }
    }

    match /bookingRequestMessageTemplates/{templateId} {
      allow read: if isActiveStaff();

      allow create, update: if isActiveOwner()
        && isValidBookingRequestMessageTemplateWrite(request.resource.data, templateId);

      allow delete: if false;

      function isValidBookingRequestMessageTemplateWrite(data, templateId) {
        return templateId is string
          && templateId.size() >= 2
          && templateId.size() <= 80
          && data.keys().hasOnly([
            'schemaVersion',
            'label',
            'category',
            'description',
            'body',
            'allowedVariables',
            'requiredVariables',
            'requiresConfirmedBooking',
            'isActive',
            'isBuiltIn',
            'sortOrder',
            'version',
            'updatedAt',
            'updatedByUid'
          ])
          && data.size() == 14
          && data.schemaVersion == 1
          && data.label is string
          && data.label.trim().size() >= 2
          && data.label.trim().size() <= 80
          && data.category in [
            'initial_response',
            'follow_up',
            'scheduling',
            'approval',
            'confirmation',
            'closing',
            'post_production'
          ]
          && data.description is string
          && data.description.size() <= 300
          && data.body is string
          && data.body.trim().size() >= 5
          && data.body.size() <= 1500
          && data.allowedVariables is list
          && data.allowedVariables.size() <= 15
          && data.requiredVariables is list
          && data.requiredVariables.size() <= 15
          && data.requiresConfirmedBooking is bool
          && data.isActive is bool
          && data.isBuiltIn is bool
          && data.sortOrder is int
          && data.version is int
          && data.version >= 1
          && data.updatedAt is timestamp
          && data.updatedByUid == request.auth.uid;
      }
    }

    function isValidSha256Hex(value) {
      return value is string && value.matches('^[0-9a-f]{64}$');
    }

    function isBookingEligibleForReviewInvitation(bookingId) {
      let bookingPath = /databases/$(database)/documents/bookings/$(bookingId);
      let booking = get(bookingPath);
      return exists(bookingPath)
        && booking.data.sessionStatus == 'completed'
        && booking.data.actualCompletedAt is timestamp
        && booking.data.deliveryMode == 'studio'
        && booking.data.customerId is string
        && booking.data.customerId.size() >= 1;
    }

    match /reviewInvitations/{tokenHash} {
      allow get: if isActiveStaff()
        || (
          resource != null
          && isValidSha256Hex(tokenHash)
          && (
            (resource.data.status == 'active' && resource.data.expiresAt > request.time)
            || resource.data.status == 'submitted'
          )
        );

      allow list: if isActiveStaff();

      allow create: if isActiveStaff()
        && !isFactoryResetLocked()
        && isValidReviewInvitationStaffCreate(request.resource.data, tokenHash);

      allow update: if !isFactoryResetLocked()
        && (
          (isActiveStaff() && isValidReviewInvitationStaffRevoke(request.resource.data, resource.data))
          || (
            (request.auth == null || isActiveClient())
            && isValidReviewInvitationPublicSubmitUpdate(request.resource.data, resource.data, tokenHash)
          )
        );

      allow delete: if canFactoryResetDelete();

      function isValidReviewInvitationShape(data) {
        return data.keys().hasOnly([
            'schemaVersion',
            'bookingId',
            'serviceLabelSnapshot',
            'sessionDate',
            'studioId',
            'status',
            'issuedByUid',
            'issuedAt',
            'expiresAt',
            'submittedAt',
            'revokedAt',
            'revokedByUid',
            'version'
          ])
          && data.size() == 13
          && data.schemaVersion == 1
          && data.bookingId is string
          && data.bookingId.size() >= 1
          && data.bookingId.size() <= 120
          && data.serviceLabelSnapshot is string
          && data.serviceLabelSnapshot.trim().size() >= 1
          && data.serviceLabelSnapshot.size() <= 120
          && data.sessionDate is string
          && data.sessionDate.size() <= 20
          && data.studioId in ['', 'room-a', 'room-b']
          && data.status in ['active', 'submitted', 'revoked']
          && data.issuedByUid is string
          && data.issuedByUid.size() <= 128
          && data.issuedAt is timestamp
          && data.expiresAt is timestamp
          && (data.submittedAt == null || data.submittedAt is timestamp)
          && (data.revokedAt == null || data.revokedAt is timestamp)
          && data.revokedByUid is string
          && data.revokedByUid.size() <= 128
          && data.version is int
          && data.version >= 1;
      }

      function isValidReviewInvitationStaffCreate(data, tokenHash) {
        return isValidSha256Hex(tokenHash)
          && isValidReviewInvitationShape(data)
          && data.status == 'active'
          && data.issuedByUid == request.auth.uid
          && data.issuedAt == request.time
          && data.expiresAt > request.time
          && data.submittedAt == null
          && data.revokedAt == null
          && data.revokedByUid == ''
          && data.version == 1
          && isBookingEligibleForReviewInvitation(data.bookingId)
          && !exists(/databases/$(database)/documents/customerReviews/$(data.bookingId))
          && getAfter(/databases/$(database)/documents/reviewInvitationIndexes/$(data.bookingId)).data.activeInvitationId == tokenHash;
      }

      function isValidReviewInvitationStaffRevoke(nextData, prevData) {
        return isValidReviewInvitationShape(nextData)
          && prevData.status == 'active'
          && nextData.status == 'revoked'
          && nextData.schemaVersion == prevData.schemaVersion
          && nextData.bookingId == prevData.bookingId
          && nextData.serviceLabelSnapshot == prevData.serviceLabelSnapshot
          && nextData.sessionDate == prevData.sessionDate
          && nextData.studioId == prevData.studioId
          && nextData.issuedByUid == prevData.issuedByUid
          && nextData.issuedAt == prevData.issuedAt
          && nextData.expiresAt == prevData.expiresAt
          && nextData.submittedAt == null
          && prevData.submittedAt == null
          && nextData.revokedAt == request.time
          && nextData.revokedByUid == request.auth.uid
          && nextData.version == prevData.version + 1;
      }

      function isValidReviewInvitationPublicSubmitUpdate(nextData, prevData, tokenHash) {
        let reviewPath = /databases/$(database)/documents/customerReviews/$(prevData.bookingId);
        let reviewAfter = getAfter(reviewPath);
        return isValidSha256Hex(tokenHash)
          && isValidReviewInvitationShape(nextData)
          && prevData.status == 'active'
          && prevData.expiresAt > request.time
          && nextData.status == 'submitted'
          && nextData.schemaVersion == prevData.schemaVersion
          && nextData.bookingId == prevData.bookingId
          && nextData.serviceLabelSnapshot == prevData.serviceLabelSnapshot
          && nextData.sessionDate == prevData.sessionDate
          && nextData.studioId == prevData.studioId
          && nextData.issuedByUid == prevData.issuedByUid
          && nextData.issuedAt == prevData.issuedAt
          && nextData.expiresAt == prevData.expiresAt
          && nextData.revokedAt == prevData.revokedAt
          && nextData.revokedByUid == prevData.revokedByUid
          && nextData.submittedAt == request.time
          && nextData.version == prevData.version + 1
          && !exists(reviewPath)
          && reviewAfter.data.bookingId == prevData.bookingId
          && reviewAfter.data.invitationId == tokenHash
          && reviewAfter.data.status == 'pending';
      }
    }

    match /reviewInvitationIndexes/{bookingId} {
      allow read: if isActiveStaff();

      allow create: if isActiveStaff()
        && !isFactoryResetLocked()
        && isValidReviewInvitationIndexShape(request.resource.data, bookingId)
        && request.resource.data.version == 1
        && isBookingEligibleForReviewInvitation(bookingId)
        && !exists(/databases/$(database)/documents/customerReviews/$(bookingId))
        && getAfter(/databases/$(database)/documents/reviewInvitations/$(request.resource.data.activeInvitationId)).data.bookingId == bookingId
        && getAfter(/databases/$(database)/documents/reviewInvitations/$(request.resource.data.activeInvitationId)).data.status == 'active';

      allow update: if isActiveStaff()
        && !isFactoryResetLocked()
        && isValidReviewInvitationIndexShape(request.resource.data, bookingId)
        && request.resource.data.version == resource.data.version + 1
        && isBookingEligibleForReviewInvitation(bookingId)
        && !exists(/databases/$(database)/documents/customerReviews/$(bookingId))
        && getAfter(/databases/$(database)/documents/reviewInvitations/$(request.resource.data.activeInvitationId)).data.bookingId == bookingId
        && getAfter(/databases/$(database)/documents/reviewInvitations/$(request.resource.data.activeInvitationId)).data.status == 'active';

      allow delete: if canFactoryResetDelete();

      function isValidReviewInvitationIndexShape(data, bookingId) {
        return data.keys().hasOnly([
            'schemaVersion',
            'bookingId',
            'activeInvitationId',
            'issuedAt',
            'expiresAt',
            'version'
          ])
          && data.size() == 6
          && data.schemaVersion == 1
          && data.bookingId == bookingId
          && isValidSha256Hex(data.activeInvitationId)
          && data.issuedAt == request.time
          && data.expiresAt is timestamp
          && data.expiresAt > request.time
          && data.version is int
          && data.version >= 1;
      }
    }

    match /customerReviews/{bookingId} {
      allow get: if isActiveStaff()
        || (resource != null && resource.data.status == 'published');

      allow list: if isActiveStaff()
        || resource.data.status == 'published';

      allow create: if (request.auth == null || isActiveClient())
        && !isFactoryResetLocked()
        && isValidCustomerReviewPublicCreate(request.resource.data, bookingId);

      allow update: if isActiveOwner()
        && isValidCustomerReviewModerationUpdate(request.resource.data, resource.data, bookingId);

      allow delete: if false;

      function isValidCustomerReviewShape(data, bookingId) {
        return data.keys().hasOnly([
            'schemaVersion',
            'bookingId',
            'invitationId',
            'displayName',
            'rating',
            'reviewText',
            'serviceLabelSnapshot',
            'sessionDate',
            'consentToPublish',
            'consentVersion',
            'status',
            'createdAt',
            'updatedAt',
            'publishedAt',
            'version'
          ])
          && data.size() == 15
          && data.schemaVersion == 1
          && data.bookingId == bookingId
          && bookingId is string
          && bookingId.size() >= 1
          && bookingId.size() <= 120
          && isValidSha256Hex(data.invitationId)
          && data.displayName is string
          && data.displayName.trim().size() >= 2
          && data.displayName.size() <= 80
          && data.rating is int
          && data.rating >= 1
          && data.rating <= 5
          && data.reviewText is string
          && data.reviewText.trim().size() >= 10
          && data.reviewText.size() <= 1500
          && data.serviceLabelSnapshot is string
          && data.serviceLabelSnapshot.size() <= 120
          && data.sessionDate is string
          && data.sessionDate.size() <= 20
          && data.consentToPublish == true
          && data.consentVersion == 'customer-review-publication-v1'
          && data.status in ['pending', 'published', 'rejected', 'archived']
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && (data.publishedAt == null || data.publishedAt is timestamp)
          && data.version is int
          && data.version >= 1;
      }

      function isValidCustomerReviewPublicCreate(data, bookingId) {
        let invPath = /databases/$(database)/documents/reviewInvitations/$(data.invitationId);
        let inv = get(invPath);
        let invAfter = getAfter(invPath);
        return isValidCustomerReviewShape(data, bookingId)
          && data.status == 'pending'
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && data.publishedAt == null
          && data.version == 1
          && exists(invPath)
          && inv.data.status == 'active'
          && inv.data.expiresAt > request.time
          && inv.data.bookingId == bookingId
          && data.serviceLabelSnapshot == inv.data.serviceLabelSnapshot
          && data.sessionDate == inv.data.sessionDate
          && invAfter.data.status == 'submitted'
          && invAfter.data.submittedAt == request.time;
      }

      function isValidCustomerReviewModerationUpdate(nextData, prevData, bookingId) {
        return isValidCustomerReviewShape(nextData, bookingId)
          && nextData.schemaVersion == prevData.schemaVersion
          && nextData.bookingId == prevData.bookingId
          && nextData.invitationId == prevData.invitationId
          && nextData.displayName == prevData.displayName
          && nextData.rating == prevData.rating
          && nextData.reviewText == prevData.reviewText
          && nextData.serviceLabelSnapshot == prevData.serviceLabelSnapshot
          && nextData.sessionDate == prevData.sessionDate
          && nextData.consentToPublish == prevData.consentToPublish
          && nextData.consentVersion == prevData.consentVersion
          && nextData.createdAt == prevData.createdAt
          && nextData.updatedAt == request.time
          && nextData.version == prevData.version + 1
          && (
            (prevData.status == 'pending' && nextData.status == 'published' && nextData.publishedAt == request.time)
            || (prevData.status == 'pending' && nextData.status == 'rejected' && nextData.publishedAt == null)
            || (prevData.status == 'rejected' && nextData.status == 'pending' && nextData.publishedAt == null)
            || (prevData.status == 'rejected' && nextData.status == 'published' && nextData.publishedAt == request.time)
            || (prevData.status == 'published' && nextData.status == 'archived' && nextData.publishedAt == null)
            || (prevData.status == 'archived' && nextData.status == 'published' && nextData.publishedAt == request.time)
            || (prevData.status == 'archived' && nextData.status == 'rejected' && nextData.publishedAt == null)
          );
      }
    }

    match /publicReviewStats/{docId} {
      allow get: if docId == 'summary';
      allow list: if false;

      allow create, update: if isActiveOwner()
        && docId == 'summary'
        && isValidPublicReviewStatsWrite(request.resource.data);

      allow delete: if false;

      function isValidPublicReviewStatsWrite(data) {
        let dist = data.ratingDistribution;
        let distCount = dist['1'] + dist['2'] + dist['3'] + dist['4'] + dist['5'];
        let distWeightedSum = dist['1'] * 1 + dist['2'] * 2 + dist['3'] * 3 + dist['4'] * 4 + dist['5'] * 5;
        return data.keys().hasOnly([
            'schemaVersion',
            'publishedCount',
            'ratingSum',
            'ratingDistribution',
            'updatedAt'
          ])
          && data.size() == 5
          && data.schemaVersion == 1
          && data.publishedCount is int
          && data.publishedCount >= 0
          && data.ratingSum is int
          && data.ratingSum >= 0
          && dist is map
          && dist.keys().hasOnly(['1', '2', '3', '4', '5'])
          && dist.size() == 5
          && dist['1'] is int && dist['1'] >= 0
          && dist['2'] is int && dist['2'] >= 0
          && dist['3'] is int && dist['3'] >= 0
          && dist['4'] is int && dist['4'] >= 0
          && dist['5'] is int && dist['5'] >= 0
          && distCount == data.publishedCount
          && distWeightedSum == data.ratingSum
          && data.updatedAt == request.time;
      }
    }

    // =========================================================================
    // CLIENT PORTAL PHASE 1 — ACCOUNTS, VERIFIED EMAIL INDEX & CLIENT PROFILES
    // =========================================================================

    match /customerEmailIndex/{normalizedEmail} {
      allow get: if isActiveStaff()
        || (
          hasVerifiedGoogleEmail()
          && !isAnyStaffProfile()
          && normalizedAuthEmail() == normalizedEmail
        );

      allow list: if isActiveOwner();

      allow create: if isActiveStaff()
        && !isFactoryResetLocked()
        && isValidCustomerEmailIndex(request.resource.data, normalizedEmail)
        && request.resource.data.version == 1;

      allow update: if isActiveStaff()
        && !isFactoryResetLocked()
        && isValidCustomerEmailIndex(request.resource.data, normalizedEmail)
        && request.resource.data.version == resource.data.version + 1;

      allow delete: if (isActiveStaff() && !isFactoryResetLocked())
        || canFactoryResetDelete();

      function isValidCustomerEmailIndex(data, normalizedEmail) {
        return data.keys().hasOnly([
            'schemaVersion',
            'emailNormalized',
            'customerId',
            'status',
            'updatedAt',
            'updatedByUid',
            'version'
          ])
          && data.size() == 7
          && data.schemaVersion == 1
          && isValidNormalizedEmail(normalizedEmail)
          && data.emailNormalized == normalizedEmail
          && data.status in ['active', 'ambiguous']
          && data.updatedAt is timestamp
          && data.updatedByUid == request.auth.uid
          && data.version is int
          && data.version >= 1
          && (
            (
              data.status == 'active'
              && data.customerId is string
              && data.customerId.size() >= 1
              && data.customerId.size() <= 120
              && existsAfter(/databases/$(database)/documents/customers/$(data.customerId))
              && existsAfter(/databases/$(database)/documents/clientProfiles/$(data.customerId))
            ) || (
              data.status == 'ambiguous'
              && data.customerId == ''
            )
          );
      }
    }

    // Owner-reviewed legacy linking is one-way: an active isolated Client account
    // may be attached to one explicitly selected, currently unclaimed CRM Customer.
    // The old synthetic link/profile are intentionally preserved as inert history.
    function isClientIdentityLinkAuditId(uid, customerId) {
      return 'link_' + uid + '_' + customerId;
    }

    function isOwnerReviewedIdentityBindingAfter(uid, customerId) {
      let accountPath = /databases/$(database)/documents/clientAccounts/$(uid);
      let linkPath = /databases/$(database)/documents/clientCustomerLinks/$(customerId);
      let profilePath = /databases/$(database)/documents/clientProfiles/$(customerId);
      let auditPath = /databases/$(database)/documents/clientIdentityLinkAudits/$(isClientIdentityLinkAuditId(uid, customerId));
      let accountAfter = getAfter(accountPath);
      let linkAfter = getAfter(linkPath);
      let profileAfter = getAfter(profilePath);
      let auditAfter = getAfter(auditPath);
      let customer = get(/databases/$(database)/documents/customers/$(customerId));
      return existsAfter(accountPath)
        && existsAfter(linkPath)
        && existsAfter(profilePath)
        && existsAfter(auditPath)
        && exists(/databases/$(database)/documents/customers/$(customerId))
        && customer.data.status == 'active'
        && accountAfter.data.uid == uid
        && accountAfter.data.role == 'client'
        && accountAfter.data.status == 'active'
        && accountAfter.data.customerId == customerId
        && accountAfter.data.profileSource == 'linked_customer'
        && accountAfter.data.updatedAt == request.time
        && linkAfter.data.customerId == customerId
        && linkAfter.data.ownerUid == uid
        && linkAfter.data.profileSource == 'linked_customer'
        && linkAfter.data.emailNormalized == accountAfter.data.emailNormalized
        && linkAfter.data.createdAt == request.time
        && profileAfter.data.customerId == customerId
        && profileAfter.data.ownerUid == uid
        && profileAfter.data.profileSource == 'linked_customer'
        && profileAfter.data.status == 'active'
        && profileAfter.data.displayName == customer.data.displayName.trim()
        && profileAfter.data.emailNormalized == (
          customer.data.get('emailNormalized', '') != ''
            ? customer.data.emailNormalized.trim().lower()
            : customer.data.get('email', '').trim().lower()
        )
        && profileAfter.data.phoneDisplay == customer.data.get('phoneDisplay', '').trim()
        && profileAfter.data.updatedAt == request.time
        && auditAfter.data.operationId == isClientIdentityLinkAuditId(uid, customerId)
        && auditAfter.data.action == 'owner_reviewed_legacy_link'
        && auditAfter.data.clientUid == uid
        && auditAfter.data.actorUid == request.auth.uid
        && auditAfter.data.fromCustomerId == ('client_' + uid)
        && auditAfter.data.toCustomerId == customerId
        && auditAfter.data.reviewedAt == request.time;
    }

    match /clientAccounts/{uid} {
      allow get: if isActiveOwner()
        || (request.auth != null && request.auth.uid == uid);

      allow list: if isActiveOwner();

      allow create: if hasEligibleClientAuth()
        && !isAnyStaffProfile()
        && !isFactoryResetLocked()
        && request.auth.uid == uid
        && isValidClientAccountShape(request.resource.data, uid)
        && request.resource.data.role == 'client'
        && request.resource.data.status == 'active'
        && request.resource.data.emailNormalized == normalizedAuthEmail()
        && request.resource.data.authProvider == request.auth.token.firebase.sign_in_provider
        && request.resource.data.emailVerified == (
          ('email_verified' in request.auth.token) && request.auth.token.email_verified == true
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.version == 1
        && !exists(/databases/$(database)/documents/clientCustomerLinks/$(request.resource.data.customerId))
        && isClientAccountCreateLinkMatched(request.resource.data, uid)
        && (
          (
            request.resource.data.profileSource == 'isolated_client_profile'
            && request.resource.data.customerId == ('client_' + uid)
            && isClientAccountCreateIsolatedProfileMatched(request.resource.data, uid)
          ) || (
            hasVerifiedGoogleEmail()
            && request.resource.data.profileSource == 'linked_customer'
            && exists(/databases/$(database)/documents/customerEmailIndex/$(normalizedAuthEmail()))
            && exists(/databases/$(database)/documents/clientProfiles/$(request.resource.data.customerId))
            && isClientAccountCreateLinkedCustomerMatched(request.resource.data, normalizedAuthEmail())
          )
        );

      allow update: if (
          isActiveOwner()
          && isValidClientAccountShape(request.resource.data, uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'version'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.version == resource.data.version + 1
        ) || (
          isActiveOwner()
          && !isFactoryResetLocked()
          && resource.data.status == 'active'
          && resource.data.profileSource == 'isolated_client_profile'
          && resource.data.customerId == ('client_' + uid)
          && isValidClientAccountShape(request.resource.data, uid)
          && request.resource.data.status == resource.data.status
          && request.resource.data.profileSource == 'linked_customer'
          && request.resource.data.customerId != resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'customerId', 'profileSource', 'updatedAt', 'version'
          ])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.version == resource.data.version + 1
          && isOwnerReviewedIdentityBindingAfter(uid, request.resource.data.customerId)
        ) || (
          isActiveClient()
          && request.auth.uid == uid
          && resource.data.status == 'active'
          && isValidClientAccountShape(request.resource.data, uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt', 'version'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.version == resource.data.version + 1
        );

      allow delete: if false;

      function isValidClientAccountShape(data, uid) {
        return data.keys().hasOnly([
            'schemaVersion',
            'uid',
            'role',
            'status',
            'customerId',
            'profileSource',
            'emailNormalized',
            'displayName',
            'photoURL',
            'authProvider',
            'emailVerified',
            'createdAt',
            'updatedAt',
            'version'
          ])
          && data.size() == 14
          && data.schemaVersion == 1
          && data.uid == uid
          && data.role == 'client'
          && data.status in ['active', 'suspended']
          && data.customerId is string
          && data.customerId.size() >= 1
          && data.customerId.size() <= 140
          && data.profileSource in ['linked_customer', 'isolated_client_profile']
          && isValidNormalizedEmail(data.emailNormalized)
          && data.displayName is string
          && data.displayName.trim().size() >= 1
          && data.displayName.size() <= 120
          && data.photoURL is string
          && data.photoURL.size() <= 500
          && data.authProvider in ['google.com', 'password']
          && data.emailVerified is bool
          && (data.authProvider != 'google.com' || data.emailVerified == true)
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && data.version is int
          && data.version >= 1;
      }

      function isClientAccountCreateLinkMatched(data, uid) {
        let linkAfter = getAfter(/databases/$(database)/documents/clientCustomerLinks/$(data.customerId));
        return linkAfter.data.ownerUid == uid
          && linkAfter.data.customerId == data.customerId
          && linkAfter.data.profileSource == data.profileSource;
      }

      function isClientAccountCreateIsolatedProfileMatched(data, uid) {
        let profileAfter = getAfter(/databases/$(database)/documents/clientProfiles/$(data.customerId));
        return profileAfter.data.ownerUid == uid
          && profileAfter.data.customerId == data.customerId
          && profileAfter.data.profileSource == 'isolated_client_profile'
          && profileAfter.data.status == 'active';
      }

      function isClientAccountCreateLinkedCustomerMatched(data, emailNormalized) {
        let emailIdx = get(/databases/$(database)/documents/customerEmailIndex/$(emailNormalized));
        let profile = get(/databases/$(database)/documents/clientProfiles/$(data.customerId));
        return emailIdx.data.status == 'active'
          && emailIdx.data.customerId == data.customerId
          && profile.data.status == 'active'
          && profile.data.emailNormalized == emailNormalized;
      }
    }

    match /clientCustomerLinks/{customerId} {
      allow get: if isActiveOwner()
        || isClientOwnerOfCustomer(customerId);

      allow list: if isActiveOwner();

      allow create: if (
          hasEligibleClientAuth()
          && !isAnyStaffProfile()
          && !isFactoryResetLocked()
          && isValidClientCustomerLinkShape(request.resource.data, customerId)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.emailNormalized == normalizedAuthEmail()
          && request.resource.data.createdAt == request.time
          && isClientCustomerLinkCreateAccountMatched(request.resource.data, request.auth.uid, customerId)
          && (
            (
              request.resource.data.profileSource == 'isolated_client_profile'
              && customerId == ('client_' + request.auth.uid)
            ) || (
              hasVerifiedGoogleEmail()
              && request.resource.data.profileSource == 'linked_customer'
              && exists(/databases/$(database)/documents/customerEmailIndex/$(normalizedAuthEmail()))
              && isClientCustomerLinkCreateEmailIndexMatched(customerId, normalizedAuthEmail())
            )
          )
        ) || (
          isActiveOwner()
          && !isFactoryResetLocked()
          && isValidClientCustomerLinkShape(request.resource.data, customerId)
          && request.resource.data.profileSource == 'linked_customer'
          && request.resource.data.createdAt == request.time
          && isOwnerReviewedIdentityBindingAfter(request.resource.data.ownerUid, customerId)
          && request.resource.data.emailNormalized == getAfter(
            /databases/$(database)/documents/clientAccounts/$(request.resource.data.ownerUid)
          ).data.emailNormalized
        );

      allow update: if false;
      allow delete: if canFactoryResetDelete();

      function isValidClientCustomerLinkShape(data, customerId) {
        return data.keys().hasOnly([
            'schemaVersion',
            'customerId',
            'ownerUid',
            'emailNormalized',
            'profileSource',
            'createdAt',
            'version'
          ])
          && data.size() == 7
          && data.schemaVersion == 1
          && customerId is string
          && customerId.size() >= 1
          && customerId.size() <= 140
          && data.customerId == customerId
          && data.ownerUid is string
          && data.ownerUid.size() >= 1
          && data.ownerUid.size() <= 128
          && isValidNormalizedEmail(data.emailNormalized)
          && data.profileSource in ['linked_customer', 'isolated_client_profile']
          && data.createdAt is timestamp
          && data.version is int
          && data.version == 1;
      }

      function isClientCustomerLinkCreateAccountMatched(data, uid, customerId) {
        let acctAfter = getAfter(/databases/$(database)/documents/clientAccounts/$(uid));
        return acctAfter.data.customerId == customerId
          && acctAfter.data.profileSource == data.profileSource;
      }

      function isClientCustomerLinkCreateEmailIndexMatched(customerId, emailNormalized) {
        let emailIdx = get(/databases/$(database)/documents/customerEmailIndex/$(emailNormalized));
        return emailIdx.data.status == 'active'
          && emailIdx.data.customerId == customerId;
      }
    }

    match /clientProfiles/{customerId} {
      allow get: if isActiveStaff()
        || isClientOwnerOfCustomer(customerId);

      allow list: if isActiveStaff();

      allow create: if !isFactoryResetLocked()
        && (
          (
            isActiveStaff()
            && isValidClientProfileShape(request.resource.data, customerId)
            && request.resource.data.ownerUid == null
            && request.resource.data.profileSource == 'linked_customer'
            && existsAfter(/databases/$(database)/documents/customers/$(customerId))
          ) || (
            isActiveOwner()
            && isValidClientProfileShape(request.resource.data, customerId)
            && request.resource.data.ownerUid is string
            && request.resource.data.profileSource == 'linked_customer'
            && request.resource.data.status == 'active'
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.version == 1
            && isOwnerReviewedIdentityBindingAfter(request.resource.data.ownerUid, customerId)
          ) || (
            hasEligibleClientAuth()
            && !isAnyStaffProfile()
            && isValidClientProfileShape(request.resource.data, customerId)
            && customerId == ('client_' + request.auth.uid)
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.profileSource == 'isolated_client_profile'
            && request.resource.data.emailNormalized == normalizedAuthEmail()
            && request.resource.data.phoneDisplay == ''
            && request.resource.data.status == 'active'
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.version == 1
            && getAfter(/databases/$(database)/documents/clientAccounts/$(request.auth.uid)).data.customerId == customerId
            && getAfter(/databases/$(database)/documents/clientCustomerLinks/$(customerId)).data.ownerUid == request.auth.uid
          )
        );

      allow update: if !isFactoryResetLocked()
        && (
          (
            isActiveStaff()
            && isValidClientProfileShape(request.resource.data, customerId)
            && request.resource.data.customerId == resource.data.customerId
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.profileSource == resource.data.profileSource
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.version == resource.data.version + 1
          ) || (
            isActiveOwner()
            && resource.data.ownerUid == null
            && resource.data.profileSource == 'linked_customer'
            && resource.data.status == 'active'
            && isValidClientProfileShape(request.resource.data, customerId)
            && request.resource.data.ownerUid is string
            && request.resource.data.profileSource == resource.data.profileSource
            && request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'updatedAt', 'version'])
            && request.resource.data.updatedAt == request.time
            && request.resource.data.version == resource.data.version + 1
            && isOwnerReviewedIdentityBindingAfter(request.resource.data.ownerUid, customerId)
          ) || (
            isActiveClient()
            && resource.data.profileSource == 'isolated_client_profile'
            && resource.data.ownerUid == request.auth.uid
            && getClientAccountDoc(request.auth.uid).data.customerId == customerId
            && isValidClientProfileShape(request.resource.data, customerId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt', 'version'])
            && request.resource.data.updatedAt == request.time
            && request.resource.data.version == resource.data.version + 1
          )
        );

      allow delete: if canFactoryResetDelete();

      function isValidClientProfileShape(data, customerId) {
        return data.keys().hasOnly([
            'schemaVersion',
            'customerId',
            'ownerUid',
            'profileSource',
            'displayName',
            'emailNormalized',
            'phoneDisplay',
            'photoURL',
            'status',
            'createdAt',
            'updatedAt',
            'version'
          ])
          && data.size() == 12
          && data.schemaVersion == 1
          && customerId is string
          && customerId.size() >= 1
          && customerId.size() <= 140
          && data.customerId == customerId
          && (data.ownerUid == null || (data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128))
          && data.profileSource in ['linked_customer', 'isolated_client_profile']
          && data.displayName is string
          && data.displayName.trim().size() >= 1
          && data.displayName.size() <= 120
          && data.emailNormalized is string
          && (data.emailNormalized == '' || isValidNormalizedEmail(data.emailNormalized))
          && data.phoneDisplay is string
          && data.phoneDisplay.size() <= 40
          && data.photoURL is string
          && data.photoURL.size() <= 500
          && data.status in ['active', 'archived']
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && data.version is int
          && data.version >= 1;
      }
    }

    // Append-only audit log. Owner can review history; no actor can rewrite or remove it.
    match /clientIdentityLinkAudits/{operationId} {
      allow get, list: if isActiveOwner();

      allow create: if isActiveOwner()
        && !isFactoryResetLocked()
        && isValidClientIdentityLinkAudit(request.resource.data, operationId);

      allow update, delete: if false;

      function isClientIdentityAuditSourceMatches(data) {
        let uid = data.clientUid;
        let sourceCustomerId = data.fromCustomerId;
        let accountPath = /databases/$(database)/documents/clientAccounts/$(uid);
        let sourceLinkPath = /databases/$(database)/documents/clientCustomerLinks/$(sourceCustomerId);
        let sourceProfilePath = /databases/$(database)/documents/clientProfiles/$(sourceCustomerId);
        let currentAccount = get(accountPath);
        let sourceLink = get(sourceLinkPath);
        let sourceProfile = get(sourceProfilePath);
        return exists(accountPath)
          && exists(sourceLinkPath)
          && exists(sourceProfilePath)
          && currentAccount.data.uid == uid
          && currentAccount.data.role == 'client'
          && currentAccount.data.status == 'active'
          && currentAccount.data.profileSource == 'isolated_client_profile'
          && currentAccount.data.customerId == sourceCustomerId
          && currentAccount.data.version == data.accountVersionBefore
          && sourceLink.data.customerId == sourceCustomerId
          && sourceLink.data.ownerUid == uid
          && sourceLink.data.emailNormalized == currentAccount.data.emailNormalized
          && sourceLink.data.profileSource == 'isolated_client_profile'
          && sourceProfile.data.customerId == sourceCustomerId
          && sourceProfile.data.ownerUid == uid
          && sourceProfile.data.emailNormalized == currentAccount.data.emailNormalized
          && sourceProfile.data.profileSource == 'isolated_client_profile';
      }

      function isClientIdentityAuditTargetMatches(data) {
        let uid = data.clientUid;
        let targetCustomerId = data.toCustomerId;
        let targetCustomerPath = /databases/$(database)/documents/customers/$(targetCustomerId);
        let targetCustomer = get(targetCustomerPath);
        let accountAfter = getAfter(/databases/$(database)/documents/clientAccounts/$(uid));
        let targetLinkAfter = getAfter(/databases/$(database)/documents/clientCustomerLinks/$(targetCustomerId));
        let targetProfileAfter = getAfter(/databases/$(database)/documents/clientProfiles/$(targetCustomerId));
        return exists(targetCustomerPath)
          && targetCustomer.data.status == 'active'
          && accountAfter.data.customerId == targetCustomerId
          && accountAfter.data.profileSource == 'linked_customer'
          && accountAfter.data.status == 'active'
          && accountAfter.data.version == data.accountVersionAfter
          && targetLinkAfter.data.ownerUid == uid
          && targetLinkAfter.data.profileSource == 'linked_customer'
          && targetLinkAfter.data.customerId == targetCustomerId
          && targetProfileAfter.data.ownerUid == uid
          && targetProfileAfter.data.profileSource == 'linked_customer'
          && targetProfileAfter.data.status == 'active'
          && targetProfileAfter.data.displayName == targetCustomer.data.displayName.trim()
          && targetProfileAfter.data.emailNormalized == (
            targetCustomer.data.get('emailNormalized', '') != ''
              ? targetCustomer.data.emailNormalized.trim().lower()
              : targetCustomer.data.get('email', '').trim().lower()
          )
          && targetProfileAfter.data.phoneDisplay == targetCustomer.data.get('phoneDisplay', '').trim();
      }

      function isValidClientIdentityLinkAudit(data, operationId) {
        let uid = data.clientUid;
        let targetCustomerId = data.toCustomerId;
        return data.keys().hasOnly([
            'schemaVersion', 'operationId', 'action', 'clientUid', 'actorUid',
            'fromCustomerId', 'toCustomerId', 'fromProfileSource', 'toProfileSource',
            'reviewReason', 'reviewedAt', 'createdAt',
            'accountVersionBefore', 'accountVersionAfter', 'version'
          ])
          && data.size() == 15
          && data.schemaVersion == 1
          && operationId == isClientIdentityLinkAuditId(uid, targetCustomerId)
          && data.operationId == operationId
          && data.action == 'owner_reviewed_legacy_link'
          && uid is string
          && uid.size() >= 1
          && uid.size() <= 128
          && data.actorUid == request.auth.uid
          && data.fromCustomerId == ('client_' + uid)
          && targetCustomerId is string
          && targetCustomerId.size() >= 1
          && targetCustomerId.size() <= 140
          && data.fromProfileSource == 'isolated_client_profile'
          && data.toProfileSource == 'linked_customer'
          && data.reviewReason is string
          && data.reviewReason.trim().size() >= 10
          && data.reviewReason.size() <= 1000
          && data.reviewedAt == request.time
          && data.createdAt == request.time
          && data.accountVersionBefore is int
          && data.accountVersionBefore >= 1
          && data.accountVersionAfter == data.accountVersionBefore + 1
          && data.version == 1
          && isClientIdentityAuditSourceMatches(data)
          && isClientIdentityAuditTargetMatches(data);
      }
    }

  }
}
