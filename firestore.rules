    function isValidHeroFeaturedCopy(copy) {
      return copy is map
        && copy.keys().hasOnly([
          'topSticker',
          'captionTitle',
          'captionSubtitle',
          'floatingBadgeTitle',
          'floatingBadgeSubtitle'
        ])
        && copy.size() == 5
        && copy.topSticker is string
        && copy.topSticker.size() <= 60
        && copy.captionTitle is string
        && copy.captionTitle.trim().size() >= 2
        && copy.captionTitle.trim().size() <= 100
        && copy.captionSubtitle is string
        && copy.captionSubtitle.size() <= 160
        && copy.floatingBadgeTitle is string
        && copy.floatingBadgeTitle.size() <= 80
        && copy.floatingBadgeSubtitle is string
        && copy.floatingBadgeSubtitle.size() <= 120;
    }

    function isValidRoomPlacementCopy(copy) {
      return copy is map
        && copy.keys().hasOnly([
          'sticker',
          'name',
          'capacityLabel',
          'tags',
          'ctaLabel'
        ])
        && copy.size() == 5
        && copy.sticker is string
        && copy.sticker.size() <= 60
        && copy.name is string
        && copy.name.trim().size() >= 2
        && copy.name.trim().size() <= 100
        && copy.capacityLabel is string
        && copy.capacityLabel.trim().size() >= 2
        && copy.capacityLabel.trim().size() <= 180
        && copy.tags is list
        && copy.tags.size() >= 1
        && copy.tags.size() <= 6
        && copy.tags[0] is string
        && copy.tags[0].trim().size() >= 1
        && copy.tags[0].size() <= 60
        && copy.ctaLabel is string
        && copy.ctaLabel.trim().size() >= 2
        && copy.ctaLabel.trim().size() <= 60;
    }

    function isValidStudioExteriorCopy(copy) {
      return copy is map
        && copy.keys().hasOnly(['caption'])
        && copy.size() == 1
        && copy.caption is string
        && copy.caption.size() <= 180;
    }

    function isValidLandingPagePlacementCopy(placementId, copy) {
      return (placementId == 'hero-featured' && isValidHeroFeaturedCopy(copy))
        || ((placementId == 'room-a' || placementId == 'room-b') && isValidRoomPlacementCopy(copy))
        || (placementId == 'studio-exterior' && isValidStudioExteriorCopy(copy));
    }

    function isValidLandingPagePlacementShape(data, placementId) {
